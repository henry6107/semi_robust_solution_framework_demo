<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GC" Id="{d2b222b5-592d-46be-8a8e-fa50af509b93}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GC EXTENDS FB_PackMLModeSet
VAR_INPUT
	Service : REFERENCE TO ST_GC_Service;
	Admin : REFERENCE TO ST_GC_Admin;
	
	// Base unit used in GC chamber
	SpinAxis_BaseUnit : REFERENCE TO FB_AxisControl;
END_VAR

VAR_OUTPUT
	
END_VAR

VAR
	// 有需要特殊操作的需求，所以建立一個ST_GC_Service變數，讓程式內部可以過一手處理
	_Service : ST_GC_Service;
	
	_SpinAxisJogService : FB_GCSpinAxisJogServices;
	_SpinAxisMoveAbsService : FB_GCSPinAxisMoveAbsServices;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[A00_Service();

// Update status data
Service.SpinAxisJogService.Status := _Service.SpinAxisJogService.Status;
Service.SpinAxisMoveAbsService.Status := _Service.SpinAxisMoveAbsService.Status;
SUPER^();]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{92cfe23b-b998-4d76-8aa2-c8089e78aa61}" />
    <Action Name="A00_Service" Id="{c62275db-aa76-4b4d-95ad-2ecb5851f919}">
      <Implementation>
        <ST><![CDATA[_SpinAxisJogService(Service:= _Service.SpinAxisJogService, Axis_BaseUnit:= SpinAxis_BaseUnit);
_SpinAxisMoveAbsService(Service:= _Service.SpinAxisMoveAbsService, Axis_BaseUnit:= SpinAxis_BaseUnit);]]></ST>
      </Implementation>
    </Action>
