    <Method Name="H_OnModeChanged" Id="{9d68a966-aafb-43f3-857c-b18fd457d61a}">
      <Declaration><![CDATA[METHOD PROTECTED H_OnModeChanged
VAR_INPUT
	ePreviousMode	: T_PackMLMode;
	eNewMode	: T_PackMLMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Notice current mode to each service
_SpinAxisJogService.ModuleMode := eNewMode;
_SpinAxisMoveAbsService.ModuleMode := eNewMode;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{f6ec54bd-ad3d-49c4-9547-ff474beb3546}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnResetting := E_PackMLHookResult.Busy;

// Request clear cmd to services
_Service.SpinAxisJogService.Ctrl.Reset := TRUE;
_Service.SpinAxisMoveAbsService.Ctrl.Reset := TRUE;

// Wait cmd finished
IF _Service.SpinAxisJogService.Status.State <> E_PackMLState.Idle
	OR _Service.SpinAxisMoveAbsService.Status.State <> E_PackMLState.Idle THEN
	RETURN;
END_IF

// Reset trigger
_Service.SpinAxisJogService.Ctrl.Reset := FALSE;
_Service.SpinAxisMoveAbsService.Ctrl.Reset := FALSE;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
