    <Method Name="H_OnExecute" Id="{dc703a52-8c8a-4e2d-8deb-4adebb327ad6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Execute is stable by default; derived FBs decide when the process is done.
H_OnExecute := E_PackMLHookResult.Busy;

// Mapping control data
_Service.SpinAxisJogService.Ctrl := Service.SpinAxisJogService.Ctrl;
_Service.SpinAxisMoveAbsService.Ctrl := Service.SpinAxisMoveAbsService.Ctrl;]]></ST>
      </Implementation>
    </Method>
