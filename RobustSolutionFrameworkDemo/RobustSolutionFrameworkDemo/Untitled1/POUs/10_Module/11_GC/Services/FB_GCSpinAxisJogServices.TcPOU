    <Method Name="H_OnResetting" Id="{cd0cb289-d0f8-442c-af15-52d2005bf619}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Service.Status.Busy := FALSE;
Service.Status.Done := FALSE;
Service.Status.Error := FALSE;
Service.Status.Aborted := FALSE;
