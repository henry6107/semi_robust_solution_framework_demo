      </Implementation>
    </Method>
    <Method Name="H_OnUndefined" Id="{f7603c5c-6fc0-49e6-83fe-7aacac7ddd39}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnUndefined : E_PackMLHookResult
VAR_INPUT
