<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisJogServices" Id="{a61ac5cd-09b6-4f2d-bc54-d014db7401a2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisJogServices EXTENDS FB_PackMLBase IMPLEMENTS I_ModuleServiceProperty
VAR_INPUT
	Service : REFERENCE TO ST_GCSpinAxisJogService;
	Axis_BaseUnit : REFERENCE TO FB_AxisControl;
END_VAR

VAR_OUTPUT
END_VAR

VAR
	_StartOneShot	: R_TRIG;
	_ResetOneShot	: R_TRIG;
	_StopOneShot	: R_TRIG;
	_AbortOneShot	: R_TRIG;
	
	_ModuleMode		: T_PackMLMode;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Update service state
Service.Status.State := stOut.eStateCurrent;

A00_TrigCommand();

SUPER^();
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{30486db3-fa54-4a70-b426-5f8ba9d0504f}" />
    <Action Name="A00_TrigCommand" Id="{d9012b4d-3f7d-455a-a3d6-1f5152c45f28}">
      <Implementation>
        <ST><![CDATA[_StartOneShot(CLK:= Service.Ctrl.Start);
IF _StartOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Start);
END_IF

_ResetOneShot(CLK:= Service.Ctrl.Reset);
IF _ResetOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF

_StopOneShot(CLK:= Service.Ctrl.Stop);
IF _StopOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Stop);
END_IF

_AbortOneShot(CLK:= Service.Ctrl.Abort);
IF _AbortOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Abort);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{b48428e2-059a-4878-a27b-576d41f2ba26}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Service.Status.Busy := FALSE;
Service.Status.Done := FALSE;
Service.Status.Aborted := TRUE;

RequestCommand(E_PackMLCommand.Clear);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{df4c7f2d-8a88-4d35-a321-0716e918b536}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Axis_BaseUnit.M_Jog(
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= Service.Ctrl.Param.Mode, 
	Position:= Service.Ctrl.Param.Position, 
	Velocity:= Service.Ctrl.Param.Velocity, 
	Acceleration:= Service.Ctrl.Param.Acceleration, 
	Deceleration:= Service.Ctrl.Param.Deceleration);

H_OnAborting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
