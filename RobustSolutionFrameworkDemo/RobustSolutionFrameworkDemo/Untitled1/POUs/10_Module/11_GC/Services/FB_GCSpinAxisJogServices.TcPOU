H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{bcd7c333-82d2-481d-9c52-d49b2030a18e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Service.Status.Busy := TRUE;
Service.Status.Done := FALSE;
Service.Status.Error := FALSE;
Service.Status.Aborted := FALSE;
Service.Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

// Check is servo on
IF Axis_BaseUnit.AxisStatus.Disabled THEN
	
	// Throw up error
	Service.Status.Error:= TRUE;
	Service.Status.ErrorId:= E_GCSpinAxisJogErrorCode.Axis_Not_Servo_On_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

// Check is axis not busy
IF Axis_BaseUnit.AxisStatus.HasJob THEN
	// Throw up error
	Service.Status.Error:= TRUE;
	Service.Status.ErrorId:= E_GCSpinAxisJogErrorCode.Axis_Is_Busy_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Check is param valid
IF (Service.Ctrl.Param.JogBackwards AND Service.Ctrl.Param.JogForward) OR
	(NOT Service.Ctrl.Param.JogBackwards AND NOT Service.Ctrl.Param.JogForward) OR
	Service.Ctrl.Param.Velocity = 0 THEN
	// Throw up error
	Service.Status.Error:= TRUE;
	Service.Status.ErrorId:= E_GCSpinAxisJogErrorCode.Invalid_Param;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;


]]></ST>
      </Implementation>
    </Method>
