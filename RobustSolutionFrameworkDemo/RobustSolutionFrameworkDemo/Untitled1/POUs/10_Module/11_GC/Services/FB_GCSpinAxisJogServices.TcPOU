<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisJogServices" Id="{a61ac5cd-09b6-4f2d-bc54-d014db7401a2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisJogServices EXTENDS FB_PackMLBase IMPLEMENTS I_ModuleServiceProperty
VAR_INPUT
	Ctrl : REFERENCE TO ST_GCSpinAxisJogCtrl;
	Status : REFERENCE TO ST_GCSpinAxisJogStatus;
	Axis_BaseUnit : REFERENCE TO FB_AxisControl;

	// The Module assigns a unique ID to this Service instance.
	ResourceOwnerId : T_ResourceOwnerId;
END_VAR

VAR_OUTPUT
END_VAR

VAR
	_StartOneShot	: R_TRIG;
	_ResetOneShot	: R_TRIG;
	_StopOneShot	: R_TRIG;
	_AbortOneShot	: R_TRIG;
	
	_ModuleMode		: T_PackMLMode;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Update service state
Status.State := stOut.eStateCurrent;

A00_TrigCommand();

SUPER^();
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{30486db3-fa54-4a70-b426-5f8ba9d0504f}" />
    <Action Name="A00_TrigCommand" Id="{d9012b4d-3f7d-455a-a3d6-1f5152c45f28}">
      <Implementation>
        <ST><![CDATA[_StartOneShot(CLK:= Ctrl.Start);
IF _StartOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Start);
END_IF

_ResetOneShot(CLK:= Ctrl.Reset);
IF _ResetOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF

_StopOneShot(CLK:= Ctrl.Stop);
IF _StopOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Stop);
END_IF

_AbortOneShot(CLK:= Ctrl.Abort);
IF _AbortOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Abort);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{b48428e2-059a-4878-a27b-576d41f2ba26}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively in case an unexpected transition skipped cleanup.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;

RequestCommand(E_PackMLCommand.Clear);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{df4c7f2d-8a88-4d35-a321-0716e918b536}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Done;

// A Service that never acquired the Resource must not affect its Owner.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	RETURN;
END_IF

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= Ctrl.Param.Mode,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);

// Jog has no asynchronous abort phase once both direction commands are false.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{9a60118e-19f9-4bca-893b-e890bf0b19c9}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{fd680a59-d09e-4091-ac1f-b02ebd6a48e6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Completing normally releases first; this is an idempotent safety net.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

IF NOT Ctrl.Start THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{61491643-adf6-4106-831a-f4dfe9e14738}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= Ctrl.Param.Mode,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);

// Release only after the active Jog request has been withdrawn.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{2dba6e2e-7918-46c6-a0b6-50da9e5cf338}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= Ctrl.Param.JogForward,
	JogBackwards:= Ctrl.Param.JogBackwards,
	Mode:= Ctrl.Param.Mode,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration,
	Done=> bDone, Error=> bError);


IF Ctrl.Param.Mode = E_JogMode.MC_JOGMODE_INCHING THEN
	IF bDone THEN
		Status.Busy := FALSE;
		Status.Done := TRUE;
		H_OnExecute := E_PackMLHookResult.Done;
		RETURN;
	END_IF
END_IF

IF bError THEN
		Status.Error := TRUE;
		Status.ErrorId := E_GCSpinAxisJogErrorCode.Jog_Error_During_Execute;
		
		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{fc1df435-3bb5-4a7c-8ab6-c741096bcbf0}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHeld
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHolding" Id="{ece160eb-a5c7-4980-a6c1-7b10ad25762b}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHolding : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default transient hooks complete immediately; override when work is required.
H_OnHolding := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{801e1204-bf1d-4d12-b7fd-e2791384226a}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Idle Services must not retain a Resource from an earlier operation.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{cd0cb289-d0f8-442c-af15-52d2005bf619}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{bcd7c333-82d2-481d-9c52-d49b2030a18e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

// Validate Service-owned data before reserving the shared BaseUnit.
IF (Ctrl.Param.JogBackwards AND Ctrl.Param.JogForward) OR
	(NOT Ctrl.Param.JogBackwards AND NOT Ctrl.Param.JogForward) OR
	Ctrl.Param.Velocity = 0 THEN
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisJogErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Resource contention is a failed Start, not a wait condition.
IF NOT Axis_BaseUnit.M_AcquireResource(OwnerId := ResourceOwnerId) THEN
	Status.Error := TRUE;
	Status.ErrorId := E_GCSpinAxisJogErrorCode.Resource_Acquire_Failed_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Physical checks occur only after this Service owns the BaseUnit.
IF Axis_BaseUnit.AxisIsDisabled THEN
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisJogErrorCode.Axis_Not_Servo_On_During_Starting;
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Axis_BaseUnit.AxisHasJob THEN
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisJogErrorCode.Axis_Is_Busy_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{7643e72d-21d0-42a9-a466-1828d294ec10}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively after every Stop path.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{7e40e9e4-ecf0-49b7-86b3-13897394333e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Done;

// Resource acquisition failures enter Stopping without owning the Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	RETURN;
END_IF

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= Ctrl.Param.Mode,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);

// Jog is stopped once both direction commands have been withdrawn.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnSuspended" Id="{e85e43db-649a-4658-a8a4-46ee44393ec1}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnSuspended
VAR_INPUT
