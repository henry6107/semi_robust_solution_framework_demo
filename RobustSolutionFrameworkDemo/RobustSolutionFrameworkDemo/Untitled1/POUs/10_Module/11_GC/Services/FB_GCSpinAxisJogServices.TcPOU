]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{fd680a59-d09e-4091-ac1f-b02ebd6a48e6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Service.Status.Busy := FALSE;
Service.Status.Done := TRUE;
Service.Status.Error := FALSE;
Service.Status.Aborted := FALSE;
Service.Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

IF NOT Service.Ctrl.Start THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{61491643-adf6-4106-831a-f4dfe9e14738}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Service.Status.Busy := FALSE;
Service.Status.Done := TRUE;
Service.Status.Error := FALSE;
Service.Status.Aborted := FALSE;
Service.Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

Axis_BaseUnit.M_Jog(
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= Service.Ctrl.Param.Mode, 
	Position:= Service.Ctrl.Param.Position, 
	Velocity:= Service.Ctrl.Param.Velocity, 
	Acceleration:= Service.Ctrl.Param.Acceleration, 
	Deceleration:= Service.Ctrl.Param.Deceleration);

H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{2dba6e2e-7918-46c6-a0b6-50da9e5cf338}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Service.Status.Busy := TRUE;
Service.Status.Done := FALSE;
Service.Status.Error := FALSE;
Service.Status.Aborted := FALSE;
Service.Status.ErrorId := E_GCSpinAxisJogErrorCode.None;

Axis_BaseUnit.M_Jog(
	JogForward:= Service.Ctrl.Param.JogForward, 
	JogBackwards:= Service.Ctrl.Param.JogBackwards, 
	Mode:= Service.Ctrl.Param.Mode, 
	Position:= Service.Ctrl.Param.Position, 
	Velocity:= Service.Ctrl.Param.Velocity, 
	Acceleration:= Service.Ctrl.Param.Acceleration, 
	Deceleration:= Service.Ctrl.Param.Deceleration,
	Done=> bDone, Error=> bError);


IF Service.Ctrl.Param.Mode = E_JogMode.MC_JOGMODE_INCHING THEN
	IF bDone THEN
		Service.Status.Busy := FALSE;
		Service.Status.Done := TRUE;
		H_OnExecute := E_PackMLHookResult.Done;
		RETURN;
	END_IF
END_IF

IF bError THEN
		Service.Status.Error := TRUE;
		Service.Status.ErrorId := E_GCSpinAxisJogErrorCode.Jog_Error_During_Execute;
		
		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
