    </Method>
    <Method Name="H_OnIdle" Id="{59828899-47c9-4777-90f1-23e06ffd978a}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Status.Busy := FALSE;
