<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisMoveVelServices" Id="{2d3a48e0-0a65-435f-812d-3e25cfaffe3c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisMoveVelServices EXTENDS FB_PackMLBase IMPLEMENTS I_ModuleServiceProperty
VAR_INPUT
	Ctrl : REFERENCE TO ST_GCSpinAxisMoveVelCtrl;
	Status : REFERENCE TO ST_GCSpinAxisMoveVelStatus;
	Axis_BaseUnit : REFERENCE TO FB_AxisControl;
END_VAR

VAR_OUTPUT
END_VAR

VAR
	_StartOneShot	: R_TRIG;
	_ResetOneShot	: R_TRIG;
	_StopOneShot	: R_TRIG;
	_AbortOneShot	: R_TRIG;
	
	_ModuleMode		: T_PackMLMode;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Update service state
Status.State := stOut.eStateCurrent;
Status.ActVel := Axis_BaseUnit.Axis.NcToPlc.ActVelo;
A00_TrigCommand();

SUPER^();
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{49ed7549-95d2-4542-8c09-83ad057d2672}" />
    <Action Name="A00_TrigCommand" Id="{9dc898aa-4aa1-4e35-9ef5-cd946bc1cd50}">
      <Implementation>
        <ST><![CDATA[_StartOneShot(CLK:= Ctrl.Start);
IF _StartOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Start);
END_IF

_ResetOneShot(CLK:= Ctrl.Reset);
IF _ResetOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF

_StopOneShot(CLK:= Ctrl.Stop);
IF _StopOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Stop);
END_IF

_AbortOneShot(CLK:= Ctrl.Abort);
IF _AbortOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Abort);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{328f5265-3f48-4442-8390-1fd00d156006}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;

RequestCommand(E_PackMLCommand.Clear);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{8ef4724f-e418-45d4-b245-336c28b5f1de}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// Close moveAbs method
Axis_BaseUnit.M_MoveVel(
	Execute := FALSE,
	Ctrl.Param);
	
Axis_BaseUnit.M_Reset(
	Execute := TRUE,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Reset(Execute := FALSE);
	H_OnAborting := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{e065280f-e16e-4d87-85cf-24b54094afe6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{6d77d87d-d9c6-4390-a07a-5b4202d501b8}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;

IF NOT Ctrl.Start THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{3864e1ba-9360-45a8-9d26-f1e180c8fbe5}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;

Axis_BaseUnit.M_MoveVel(
	Execute:= FALSE,
	Param := Ctrl.Param);

H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{d5c34347-be90-4f5e-8be4-57798b5c5bb2}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;

Axis_BaseUnit.M_MoveVel(
	Execute:= TRUE,
	Param:= Ctrl.Param,
	InVelocity=> bDone, Error=> bError);


IF bDone THEN
	Status.Busy := FALSE;
	Status.Done := TRUE;
	H_OnExecute := E_PackMLHookResult.Done;
	RETURN;
END_IF

IF bError THEN
		Status.Error := TRUE;
		Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.MoveVel_Error_During_Execute;
		
		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{290e557c-077d-4d3a-a2bb-06d511e35f5d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHeld
VAR_INPUT
