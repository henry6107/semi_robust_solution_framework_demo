Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{0680bc64-d1f9-407b-b6ca-83882b900618}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{ce6c9548-1f79-4b75-96e2-343a2f8f84cb}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.None;

// Check is servo on
IF Axis_BaseUnit.Axis.Status.Disabled THEN
	
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveVelErrorCode.Axis_Not_Servo_On_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

// Check is axis not busy
IF Axis_BaseUnit.Axis.Status.HasJob THEN
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveVelErrorCode.Axis_Is_Busy_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Check is param valid
IF Ctrl.Param.Velocity <= 0 THEN
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveVelErrorCode.Invalid_Param;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{768434f7-cc85-4fdb-a507-f054649262b4}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{b2816703-e998-4497-a19c-1d20e18f1f4c}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Busy;

// Close moveAbs method
Axis_BaseUnit.M_MoveVel(
	Execute := FALSE,
	Param:= Ctrl.Param);
	
Axis_BaseUnit.M_Stop(
	Execute := TRUE, 
	Deceleration:= Ctrl.Param.Deceleration,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Ctrl.Param.Deceleration);
	H_OnStopping := E_PackMLHookResult.Done;
	
ELSIF bError THEN
	// Throw up error
	Status.Error := TRUE;
	Status.ErrorId := E_GCSpinAxisMoveVelErrorCode.Error_While_Stop_Axis;
	
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Ctrl.Param.Deceleration);
		
	RequestCommand(E_PackMLCommand.Abort);
END_IF

]]></ST>
      </Implementation>
    </Method>
