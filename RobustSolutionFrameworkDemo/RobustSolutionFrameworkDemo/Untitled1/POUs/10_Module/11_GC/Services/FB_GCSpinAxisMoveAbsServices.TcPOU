<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisMoveAbsServices" Id="{9c4945bc-98e0-4f80-811d-303c8e7f09ff}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisMoveAbsServices EXTENDS FB_PackMLBase IMPLEMENTS I_ModuleServiceProperty
VAR_INPUT
	Ctrl : REFERENCE TO ST_GCSpinAxisMoveAbsCtrl;
	Status : REFERENCE TO ST_GCSpinAxisMoveAbsStatus;
	Axis_BaseUnit : REFERENCE TO FB_AxisControl;
END_VAR

VAR_OUTPUT
END_VAR

VAR
	_StartOneShot	: R_TRIG;
	_ResetOneShot	: R_TRIG;
	_StopOneShot	: R_TRIG;
	_AbortOneShot	: R_TRIG;
	
	_ModuleMode		: T_PackMLMode;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Update service state
Status.State := stOut.eStateCurrent;

A00_TrigCommand();

SUPER^();
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{ca59d4b8-ca7f-493a-9fc5-3adf146e1d0b}" />
    <Action Name="A00_TrigCommand" Id="{9792efc0-afc9-422a-8228-3e5ea321d219}">
      <Implementation>
        <ST><![CDATA[_StartOneShot(CLK:= Ctrl.Start);
IF _StartOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Start);
END_IF

_ResetOneShot(CLK:= Ctrl.Reset);
IF _ResetOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF

_StopOneShot(CLK:= Ctrl.Stop);
IF _StopOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Stop);
END_IF

_AbortOneShot(CLK:= Ctrl.Abort);
IF _AbortOneShot.Q THEN
	RequestCommand(E_PackMLCommand.Abort);
END_IF]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{f72a1e29-fdd1-40db-aea3-ecaada210cf6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;

RequestCommand(E_PackMLCommand.Clear);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{7f59724d-ad68-477a-b362-0b33ca5b585d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// Close moveAbs method
Axis_BaseUnit.M_MoveAbs(
	Execute := FALSE,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);
	
Axis_BaseUnit.M_Reset(
	Execute := TRUE,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Reset(Execute := FALSE);
	H_OnAborting := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{3b1ee54f-5c4f-4404-9263-3595f2bc3f99}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{2d44b278-e69c-4811-9a23-23e170a50c7f}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

IF NOT Ctrl.Start THEN
	RequestCommand(E_PackMLCommand.Reset);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{fad53e77-c59e-413e-b31d-29b3c546dd6e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

Axis_BaseUnit.M_MoveAbs(
	Execute:= FALSE,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);

H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{da1a2d06-c284-45ac-a7c9-cf4e582fa1d7}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

Axis_BaseUnit.M_MoveAbs(
	Execute:= TRUE,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration,
	Done=> bDone, Error=> bError);


IF bDone THEN
	Status.Busy := FALSE;
	Status.Done := TRUE;
	H_OnExecute := E_PackMLHookResult.Done;
	RETURN;
END_IF

IF bError THEN
		Status.Error := TRUE;
		Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.MoveAbs_Error_During_Execute;
		
		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{fed28373-8313-4a6e-ba4e-a5a918a6338e}" FolderPath="StateAction\">
