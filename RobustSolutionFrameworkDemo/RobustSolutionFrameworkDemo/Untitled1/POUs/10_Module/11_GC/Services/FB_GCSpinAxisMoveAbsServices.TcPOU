      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{9fac3a5f-72e3-4249-a638-a9be1f5d5fde}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{bc14a29c-b9ee-4657-bbc7-049b9824eea0}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

// Check is servo on
IF Axis_BaseUnit.AxisStatus.Disabled THEN
	
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveAbsErrorCode.Axis_Not_Servo_On_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

// Check is axis not busy
IF Axis_BaseUnit.AxisStatus.HasJob THEN
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveAbsErrorCode.Axis_Is_Busy_During_Starting;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Check is param valid
IF Ctrl.Param.Velocity <= 0 THEN
	// Throw up error
	Status.Error:= TRUE;
	Status.ErrorId:= E_GCSpinAxisMoveAbsErrorCode.Invalid_Param;
	
	// Request abort command
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;


]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{076c8329-4ff7-4786-8660-e7efe4f43425}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.
Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{4dbbd58a-3e06-43d4-b6e2-59cf43df931d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Busy;

// Close moveAbs method
Axis_BaseUnit.M_MoveAbs(
	Execute := FALSE,
	Position:= Ctrl.Param.Position,
	Velocity:= Ctrl.Param.Velocity,
	Acceleration:= Ctrl.Param.Acceleration,
	Deceleration:= Ctrl.Param.Deceleration);
	
Axis_BaseUnit.M_Stop(
	Execute := TRUE, 
	Deceleration:= Ctrl.Param.Deceleration,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Ctrl.Param.Deceleration);
	H_OnStopping := E_PackMLHookResult.Done;
	
ELSIF bError THEN
	// Throw up error
	Status.Error := TRUE;
	Status.ErrorId := E_GCSpinAxisMoveAbsErrorCode.Error_While_Stop_Axis;
	
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Ctrl.Param.Deceleration);
		
	RequestCommand(E_PackMLCommand.Abort);
END_IF

]]></ST>
      </Implementation>
    </Method>
