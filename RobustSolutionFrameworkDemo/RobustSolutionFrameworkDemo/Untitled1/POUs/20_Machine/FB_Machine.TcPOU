H_OnHolding := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{b12d6ddb-204c-4021-befa-89c32097d41e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Map machine mode control for module
_Ctrl.GC_Ctrl.eMode := Ctrl.Machine_Ctrl.eMode;
_Ctrl.GC_Ctrl.bModeChangeRequest := Ctrl.Machine_Ctrl.bModeChangeRequest;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{a7cef153-447e-4a2f-a6f1-6845f4771bc5}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnResetting := E_PackMLHookResult.Busy;

// Request reset cmd to module
_Ctrl.GC_Ctrl.eCommand := E_PackMLCommand.Reset;
_Ctrl.GC_Ctrl.bCommandChangeRequest := TRUE;

// Wait cmd finished
IF Status.GC_Status.eStateCurrent <> E_PackMLState.Idle THEN
	RETURN;
END_IF

// Reset trigger
_Ctrl.GC_Ctrl.bCommandChangeRequest := FALSE;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{7d1ed84a-ead9-44bc-af34-3760dae842d1}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

// Request start cmd to module
_Ctrl.GC_Ctrl.eCommand := E_PackMLCommand.Start;
_Ctrl.GC_Ctrl.bCommandChangeRequest := TRUE;

// Wait cmd finished
IF Status.GC_Status.eStateCurrent <> E_PackMLState.Execute THEN
	RETURN;
END_IF

// Reset trigger
_Ctrl.GC_Ctrl.bCommandChangeRequest := FALSE;

H_OnStarting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
