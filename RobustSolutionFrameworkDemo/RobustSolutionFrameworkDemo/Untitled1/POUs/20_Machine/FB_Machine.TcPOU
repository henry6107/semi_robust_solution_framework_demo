<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Machine" Id="{69cb68d3-e5c6-471b-9f6c-4d1a2834d8e1}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Machine EXTENDS FB_PackMLModeSet
VAR_INPUT
	Ctrl : REFERENCE TO ST_Machine_Ctrl;
	Status : REFERENCE TO ST_Machine_Status;
	ServiceCtrl : REFERENCE TO ST_Machine_ServiceCtrl;
	ServiceStatus : REFERENCE TO ST_Machine_ServiceStatus;
	Admin : REFERENCE TO ST_Machine_Admin;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	// 有需要特殊操作的需求，所以建立一個ST_Machine_Ctrl變數，讓程式內部可以過一手處理
	_Ctrl : ST_Machine_Ctrl;
	
	// Module
	_GC_Module : FB_GC;
	
	// Component
	_GCSpinAxis : AXIS_REF;
	_GCSpinAxis_BaseUnit : FB_AxisControl;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[A00_BaseUnit();
A01_Module();
A02_CompoundService();

stIn := Ctrl.Machine_Ctrl;
Status.Machine_Status := stOut;

SUPER^();]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{57086c26-49e8-43ea-ac33-5ee12ecb4bb8}" />
    <Action Name="A00_BaseUnit" Id="{533e0514-77ae-4296-9814-352b13fbb7c4}">
      <Implementation>
        <ST><![CDATA[_GCSpinAxis_BaseUnit(Axis:= _GCSpinAxis);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A01_Module" Id="{7783d0eb-9157-4572-a80b-92bd49224666}">
      <Implementation>
        <ST><![CDATA[_GC_Module(
	stIn:= _Ctrl.GC_Ctrl,
	stOut=> Status.GC_Status,
	ServiceCtrl:= ServiceCtrl.GC,
	ServiceStatus:= ServiceStatus.GC,
	Admin:= Admin.GC_Admin,
	SpinAxis_BaseUnit:= _GCSpinAxis_BaseUnit);]]></ST>
      </Implementation>
    </Action>
    <Action Name="A02_CompoundService" Id="{d47387d1-caed-4193-989f-250848f90265}">
      <Implementation>
        <ST><![CDATA[]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{bd79a8ca-15a3-495d-af86-8cf4e332d0fb}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Map machine mode control for module
_Ctrl.GC_Ctrl.eMode := Ctrl.Machine_Ctrl.eMode;
_Ctrl.GC_Ctrl.bModeChangeRequest := Ctrl.Machine_Ctrl.bModeChangeRequest;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{4e9e7257-ac81-4d6a-b06c-875a46d3aeda}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default transient hooks complete immediately; override when work is required.
H_OnAborting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{ef766ee3-a18d-4061-baee-56f7699f269a}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Busy;

// Request clear cmd to module
_Ctrl.GC_Ctrl.eCommand := E_PackMLCommand.Clear;
_Ctrl.GC_Ctrl.bCommandChangeRequest := TRUE;

// Wait cmd finished
IF Status.GC_Status.eStateCurrent <> E_PackMLState.Stopped THEN
	RETURN;
END_IF

// Reset trigger
_Ctrl.GC_Ctrl.bCommandChangeRequest := FALSE;

H_OnClearing := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{949bd30c-afc9-40a2-9bfb-1a4634511be6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{536f19c8-acd6-4ec7-bd8a-57bcb619e80b}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default transient hooks complete immediately; override when work is required.
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{39f3ffcd-5b95-492a-b8ce-7b05523745c8}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Execute is stable by default; derived FBs decide when the process is done.
H_OnExecute := E_PackMLHookResult.Busy;

// Enable external data to the module
IF Admin.GC_Admin.bLocalControl THEN
	_Ctrl.GC_Ctrl := Ctrl.GC_Ctrl;
ELSE
	_Ctrl.GC_Ctrl := Ctrl.Machine_Ctrl;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{ed585925-8230-4f18-ae73-e65352813968}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHeld
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
