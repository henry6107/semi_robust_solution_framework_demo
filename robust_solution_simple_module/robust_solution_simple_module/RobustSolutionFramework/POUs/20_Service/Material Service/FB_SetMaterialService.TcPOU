<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_SetMaterialService" Id="{a93d4b40-d015-47ca-8838-89ddd92d5102}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_SetMaterialService EXTENDS FB_ServiceBase
VAR_INPUT
	Param : ST_MaterialParam;
END_VAR

VAR_IN_OUT
	WaferStatusList : ARRAY[*] OF ST_WaferStatus; 
END_VAR

VAR
	_ActiveParam : ST_MaterialParam;
	_TargetIndex : DINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_UpdateService(CompletionBehavior := E_ServiceCompletionBehavior.NaturalCompletion);]]></ST>
    </Implementation>
    <Method Name="H_OnExecute" Id="{b12ade9d-beb0-469f-ac4b-b8e9258f4736}">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	nIndex : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

CASE _ActiveParam.CmdType OF
	E_SetMaterialCmdType.Modify:
		WaferStatusList[_TargetIndex].MaterialContext.Id := _ActiveParam.MaterialId;
		WaferStatusList[_TargetIndex].MaterialContext.OperationState := _ActiveParam.MaterialOperateState;

	E_SetMaterialCmdType.Clear:
		MEMSET(
			ADR(WaferStatusList[_TargetIndex].MaterialContext),
			0,
			SIZEOF(WaferStatusList[_TargetIndex].MaterialContext));

	E_SetMaterialCmdType.ClearAll:
		FOR nIndex := LOWER_BOUND(WaferStatusList, 1)
			TO UPPER_BOUND(WaferStatusList, 1) DO
			MEMSET(
				ADR(WaferStatusList[nIndex].MaterialContext),
				0,
				SIZEOF(WaferStatusList[nIndex].MaterialContext));
		END_FOR

	ELSE
		// Starting validates and snapshots the command. This is a defensive guard.
		M_AddError(
			MainErrorId := TO_UDINT(E_FrameworkServiceErrorCode.SetMaterial_InvalidCmd),
			SourceErrorId := 0,
			Message := 'The snapshotted material command is invalid.');
		RequestCommand(E_PackMLCommand.Stop);
		RETURN;
END_CASE

H_OnExecute := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{8aa5812b-d63b-4ccb-b5a6-367614c8ebb7}">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	nIndex : DINT;
	nTargetMatchCount : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

IF bFirstScan THEN
	// Execute must use the same values that were validated during Starting.
	_ActiveParam := Param;
	_TargetIndex := 0;
END_IF

CASE _ActiveParam.CmdType OF
	E_SetMaterialCmdType.Modify,
	E_SetMaterialCmdType.Clear:
		IF _ActiveParam.TargetEndpointId = 0 THEN
			M_AddError(
				MainErrorId := TO_UDINT(E_FrameworkServiceErrorCode.SetMaterial_TaEpIdRequired),
				SourceErrorId := 0,
				Message := 'TargetEndpointId must be non-zero for Modify or Clear.');
			RequestCommand(E_PackMLCommand.Stop);
			RETURN;
		END_IF

		nTargetMatchCount := 0;
		FOR nIndex := LOWER_BOUND(WaferStatusList, 1)
			TO UPPER_BOUND(WaferStatusList, 1) DO
			IF WaferStatusList[nIndex].EndpointId = _ActiveParam.TargetEndpointId THEN
				nTargetMatchCount := nTargetMatchCount + 1;
				_TargetIndex := nIndex;
			END_IF
		END_FOR

		IF nTargetMatchCount = 0 THEN
			M_AddError(
				MainErrorId := TO_UDINT(E_FrameworkServiceErrorCode.SetMaterial_TaEpNotFound),
				SourceErrorId := 0,
				Message := 'TargetEndpointId was not found in WaferStatusList.');
			RequestCommand(E_PackMLCommand.Stop);
			RETURN;
		END_IF

		IF nTargetMatchCount > 1 THEN
			M_AddError(
				MainErrorId := TO_UDINT(E_FrameworkServiceErrorCode.SetMaterial_DuplicateTaEpId),
				SourceErrorId := 0,
				Message := 'TargetEndpointId is duplicated in WaferStatusList.');
			RequestCommand(E_PackMLCommand.Stop);
			RETURN;
		END_IF

	E_SetMaterialCmdType.ClearAll:
		// ClearAll intentionally ignores TargetEndpointId and MaterialContext.
		_TargetIndex := 0;

	ELSE
		M_AddError(
			MainErrorId := TO_UDINT(E_FrameworkServiceErrorCode.SetMaterial_InvalidCmd),
			SourceErrorId := 0,
			Message := 'CmdType is not a supported material command.');
		RequestCommand(E_PackMLCommand.Stop);
		RETURN;
END_CASE

H_OnStarting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>