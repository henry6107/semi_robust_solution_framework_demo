<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisJogCWServiceTests" Id="{66d53592-ab9f-4c39-a5ad-9cf4021704bb}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisJogCWServiceTests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation><ST><![CDATA[InjectedJogErrorStopsAndReleasesAxis();
InvalidParametersAreRejectedBeforeAxisOwnership();]]></ST></Implementation>
    <Method Name="InjectedJogErrorStopsAndReleasesAxis" Id="{a66861a0-b183-421d-8878-c312f33c87bf}">
      <Declaration><![CDATA[METHOD InjectedJogErrorStopsAndReleasesAxis
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCSpinAxisJogCWServices;
	Ctrl : ST_PML_Base_In;
	Param : ST_GCSpinAxisJogParam;
	CallRecord : ST_FakeAxisCall;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[TEST('InjectedJogErrorStopsAndReleasesAxis');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Position := 1.5;
		Param.Velocity := 12.5;
		Param.Acceleration := 20;
		Param.Deceleration := 30;
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.Jog, AfterActiveCycles := 2, Done := FALSE, InVelocity := FALSE, Error := TRUE, ErrorId := 16#4444), Message := 'Jog Error script must be accepted.');
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		nPhase := 1;

	1:
		Ctrl.eCommand := E_PackMLCommand.Clear;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		nPhase := 2;

	2:
		Ctrl.bCommandChangeRequest := FALSE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		Ctrl.eCommand := E_PackMLCommand.Reset;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		nPhase := 3;

	3:
		Ctrl.bCommandChangeRequest := FALSE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		Ctrl.eCommand := E_PackMLCommand.Start;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		Ctrl.bCommandChangeRequest := FALSE;
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Valid Jog must enter Execute.');
		nPhase := 4;

	4:
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => CallRecord), Message := 'Jog command must be recorded.');
		AssertTrue(Condition := CallRecord.JogForward AND NOT CallRecord.JogBackwards, Message := 'Jog direction must be forward only.');
		AssertTrue(Condition := (CallRecord.Velocity = 12.5) AND (CallRecord.Acceleration = 20) AND (CallRecord.Deceleration = 30), Message := 'Jog parameters must reach the Axis unchanged.');
		nPhase := 5;

	5:
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		AssertFalse(Condition := Service.Status.Error, Message := 'Jog Error must still be pending after one active cycle.');
		nPhase := 6;

	6:
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		AssertTrue(Condition := Service.Status.Error, Message := 'Scripted Jog Error must be reported.');
		AssertTrue(Condition := Service.Status.ServiceErrorId = E_GCSpinAxisServiceErrorCode.Axis_Command_Error_During_Execute, Message := 'Jog Error must use the shared Service error code.');
		nPhase := 7;

	7:
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 11);
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Jog Error must finish the Stop transition.');
		AssertFalse(Condition := Axis.M_IsResourceOwner(OwnerId := 11), Message := 'Jog Stop must release ownership.');
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => CallRecord), Message := 'Jog cancellation must be recorded.');
		AssertFalse(Condition := CallRecord.JogForward OR CallRecord.JogBackwards, Message := 'Stopping must cancel both Jog directions.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
    <Method Name="InvalidParametersAreRejectedBeforeAxisOwnership" Id="{bedc1917-f303-4b09-9d7b-ad3776ea7d15}">
      <Declaration><![CDATA[METHOD InvalidParametersAreRejectedBeforeAxisOwnership
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCSpinAxisJogCWServices;
	Ctrl : ST_PML_Base_In;
	Param : ST_GCSpinAxisJogParam;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[TEST('InvalidParametersAreRejectedBeforeAxisOwnership');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Velocity := 0;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		nPhase := 1;
	1:
		Ctrl.eCommand := E_PackMLCommand.Clear;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		Ctrl.bCommandChangeRequest := FALSE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		Ctrl.eCommand := E_PackMLCommand.Reset;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		nPhase := 2;
	2:
		Ctrl.bCommandChangeRequest := FALSE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		Ctrl.eCommand := E_PackMLCommand.Start;
		Ctrl.bCommandChangeRequest := TRUE;
		FakeAxis.M_CyclicUpdate();
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 12);
		AssertTrue(Condition := Service.Status.Error, Message := 'Zero Jog velocity must be rejected.');
		AssertTrue(Condition := Service.Status.ServiceErrorId = E_GCSpinAxisServiceErrorCode.Invalid_Param, Message := 'Invalid Jog data must report Invalid_Param.');
		AssertFalse(Condition := Axis.M_IsResourceOwner(OwnerId := 12), Message := 'Parameter validation must occur before ownership.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
