<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GC_ModuleTests" Id="{96672931-1460-48e8-9f48-00c039353553}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GC_ModuleTests EXTENDS TcUnit.FB_TestSuite
VAR
	Module : FB_GC_Module(ModuleId := E_ModuleId.GC1);
	SpinOnlyModule : FB_GC_Module(ModuleId := E_ModuleId.GC1);
	LiftOnlyModule : FB_GC_Module(ModuleId := E_ModuleId.GC1);
	TestModule_1 : FB_TestableGCModule(ModuleId := E_ModuleId.GC1);
	TestModule_2 : FB_TestableGCModule(ModuleId := E_ModuleId.GC1);
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[UnboundAxisLeavesModuleInert();
BoundAxisUpdatesOnceAndServicesShareOwnership();
AlarmListAggregatesAllServicesInIndexOrder();
AlarmListCompactsHolesAndClearsStaleEntries();]]></ST>
    </Implementation>
    <Method Name="AlarmListAggregatesAllServicesInIndexOrder" Id="{6fd8a24e-7cf5-46da-8a37-23fe7470f6e1}">
      <Declaration><![CDATA[METHOD AlarmListAggregatesAllServicesInIndexOrder
VAR
	SourceStatus : ST_GC_ServiceStatus;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AlarmListAggregatesAllServicesInIndexOrder');

MEMSET(ADR(SourceStatus), 0, SIZEOF(SourceStatus));
SourceStatus.SpinAxisJogCW.ErrorList[2].ModuleId := 11;
SourceStatus.SpinAxisJogCW.ErrorList[2].MainErrorId := 101;
SourceStatus.SpinAxisJogCW.ErrorList[2].SourceErrorId := 1001;
SourceStatus.SpinAxisJogCW.ErrorList[2].Message := 'Spin jog alarm';
SourceStatus.SpinAxisJogCW.ErrorList[2].Path := 'GC.SpinAxisJogCW';
SourceStatus.SpinAxisJogCW.ErrorList[2].Severity := E_Severity.Alarm;
SourceStatus.SpinAxisJogCW.ErrorList[2].DateTime := '20260814123456001';
SourceStatus.SpinAxisMoveAbs.ErrorList[1].MainErrorId := 201;
SourceStatus.SpinAxisMoveVelCW.ErrorList[10].MainErrorId := 301;
SourceStatus.LiftPinAxisMoveVelCW.ErrorList[3].MainErrorId := 401;
SourceStatus.LiftPinAxisMoveVelCCW.ErrorList[1].MainErrorId := 501;
SourceStatus.LiftPinAxisMoveAbs.ErrorList[4].MainErrorId := 601;
SourceStatus.SingleProcess.ErrorList[2].MainErrorId := 701;

TestModule_1.M_SetTestServiceStatus(TestStatus := SourceStatus);
TestModule_1.M_UpdateTestAlarmList();

AssertTrue(Condition := (TestModule_1.ModuleAlarmList[1].MainErrorId = 101)
	AND (TestModule_1.ModuleAlarmList[2].MainErrorId = 201)
	AND (TestModule_1.ModuleAlarmList[3].MainErrorId = 301)
	AND (TestModule_1.ModuleAlarmList[4].MainErrorId = 401)
	AND (TestModule_1.ModuleAlarmList[5].MainErrorId = 501)
	AND (TestModule_1.ModuleAlarmList[6].MainErrorId = 601)
	AND (TestModule_1.ModuleAlarmList[7].MainErrorId = 701),
	Message := 'Module alarms must follow ServiceStatus ByIndex order and each ErrorList index order.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[8].MainErrorId = 0, Message := 'The first unused ModuleAlarmList entry must remain empty.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].ModuleId = 11, Message := 'Aggregation must preserve ModuleId.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].SourceErrorId = 1001, Message := 'Aggregation must preserve SourceErrorId.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].Message = 'Spin jog alarm', Message := 'Aggregation must preserve Message.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].Path = 'GC.SpinAxisJogCW', Message := 'Aggregation must preserve Path.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].Severity = E_Severity.Alarm, Message := 'Aggregation must preserve Severity.');
AssertTrue(Condition := TestModule_1.ModuleAlarmList[1].DateTime = '20260814123456001', Message := 'Aggregation must preserve DateTime.');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="AlarmListCompactsHolesAndClearsStaleEntries" Id="{6fd8a24e-7cf5-46da-8a37-23fe7470f6e2}">
      <Declaration><![CDATA[METHOD AlarmListCompactsHolesAndClearsStaleEntries
VAR
	SourceStatus : ST_GC_ServiceStatus;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AlarmListCompactsHolesAndClearsStaleEntries');

MEMSET(ADR(SourceStatus), 0, SIZEOF(SourceStatus));
SourceStatus.SpinAxisJogCW.ErrorList[1].MainErrorId := 11;
SourceStatus.SpinAxisJogCW.ErrorList[3].MainErrorId := 12;
SourceStatus.SpinAxisMoveAbs.ErrorList[2].MainErrorId := 21;
SourceStatus.LiftPinAxisMoveVelCW.ErrorList[1].MainErrorId := 41;
SourceStatus.SingleProcess.ErrorList[10].MainErrorId := 71;

TestModule_2.M_SetTestServiceStatus(TestStatus := SourceStatus);
TestModule_2.M_UpdateTestAlarmList();
AssertTrue(Condition := (TestModule_2.ModuleAlarmList[1].MainErrorId = 11)
	AND (TestModule_2.ModuleAlarmList[2].MainErrorId = 12)
	AND (TestModule_2.ModuleAlarmList[3].MainErrorId = 21)
	AND (TestModule_2.ModuleAlarmList[4].MainErrorId = 41)
	AND (TestModule_2.ModuleAlarmList[5].MainErrorId = 71),
	Message := 'Aggregation must skip source holes without terminating the scan.');
AssertTrue(Condition := TestModule_2.ModuleAlarmList[6].MainErrorId = 0, Message := 'Five alarms must produce a five-entry dense prefix.');

MEMSET(
	ADR(SourceStatus.SpinAxisJogCW.ErrorList[3]),
	0,
	SIZEOF(SourceStatus.SpinAxisJogCW.ErrorList[3]));
TestModule_2.M_SetTestServiceStatus(TestStatus := SourceStatus);
TestModule_2.M_UpdateTestAlarmList();
AssertTrue(Condition := (TestModule_2.ModuleAlarmList[1].MainErrorId = 11)
	AND (TestModule_2.ModuleAlarmList[2].MainErrorId = 21)
	AND (TestModule_2.ModuleAlarmList[3].MainErrorId = 41)
	AND (TestModule_2.ModuleAlarmList[4].MainErrorId = 71),
	Message := 'Removing the second alarm must shift later alarms forward without gaps.');
AssertTrue(Condition := TestModule_2.ModuleAlarmList[5].MainErrorId = 0, Message := 'Compaction must clear the stale fifth ModuleAlarmList entry.');

MEMSET(ADR(SourceStatus), 0, SIZEOF(SourceStatus));
TestModule_2.M_SetTestServiceStatus(TestStatus := SourceStatus);
TestModule_2.M_UpdateTestAlarmList();
AssertTrue(Condition := TestModule_2.ModuleAlarmList[1].MainErrorId = 0, Message := 'An empty source must publish an empty ModuleAlarmList.');
AssertTrue(Condition := TestModule_2.ModuleAlarmList[Param_Config.MaxModuleAlarm].MainErrorId = 0, Message := 'Clearing must remove stale alarms from the entire destination list.');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="BoundAxisUpdatesOnceAndServicesShareOwnership" Id="{08f6ebae-7123-48dc-89e6-73b2de80ca9a}">
      <Declaration><![CDATA[METHOD BoundAxisUpdatesOnceAndServicesShareOwnership
VAR_INST

	SpinFakeAxis : FB_FakeAxis_BaseUnit;
	SpinAxis : I_Axis_BaseUnit;
	LiftFakeAxis : FB_FakeAxis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	HwInput : ST_GC_Signal_In;
	HwOutput : ST_GC_Signal_Out;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_GC_ServiceCtrl;
	ECID : ST_GC_ServiceParam;
	SystemContext : ST_SystemContext;
	CallRecord : ST_FakeAxisCall;
	nPhase : UINT;
	nOwnerCount : UINT;
	nLiftOwnerCount : UINT;
	nCallIndex : UINT;
	bAcceptedCommandFound : BOOL;
sPreviousSimulationTick : STRING(80);
sPreviousTemperature : STRING(80);
sPreviousPressure : STRING(80);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('BoundAxisUpdatesOnceAndServicesShareOwnership');

CASE nPhase OF
	0:
		// Init module / service param / base units
		SystemContext.UtcDateTime := '20260813123456007';
		SpinFakeAxis.M_ResetScenario();
		LiftFakeAxis.M_ResetScenario();
		SpinFakeAxis.M_SetAxisFeedback(ActualPosition := 12.5, ActualVelocity := 123.5);
		LiftFakeAxis.M_SetAxisFeedback(ActualPosition := 45.25, ActualVelocity := 67.5);
		AssertTrue(Condition := GVL_GC_Config.cServiceCount = 7, Message := 'GC service view must include SingleProcess as the seventh Service.');
		SpinAxis := SpinFakeAxis;
		LiftAxis := LiftFakeAxis;
		ECID.SpinAxisJogCW.Velocity := 10;
		ECID.SpinAxisJogCW.Acceleration := 20;
		ECID.SpinAxisJogCW.Deceleration := 30;
		ECID.SpinAxisMoveAbs.Position := 100;
		ECID.SpinAxisMoveAbs.Velocity := 10;
		ECID.SpinAxisMoveAbs.Acceleration := 20;
		ECID.SpinAxisMoveAbs.Deceleration := 30;
		ECID.SpinAxisMoveVelCW.Velocity := 10;
		ECID.SpinAxisMoveVelCW.Acceleration := 20;
		ECID.SpinAxisMoveVelCW.Deceleration := 30;

		ECID.LiftPinAxisMoveVelCW.Velocity := 11;
		ECID.LiftPinAxisMoveVelCW.Acceleration := 21;
		ECID.LiftPinAxisMoveVelCW.Deceleration := 31;
		ECID.LiftPinAxisMoveVelCCW.Velocity := 12;
		ECID.LiftPinAxisMoveVelCCW.Acceleration := 22;
		ECID.LiftPinAxisMoveVelCCW.Deceleration := 32;
		ECID.LiftPinAxisMoveAbs.Position := 200;
		ECID.LiftPinAxisMoveAbs.Velocity := 13;
		ECID.LiftPinAxisMoveAbs.Acceleration := 23;
		ECID.LiftPinAxisMoveAbs.Deceleration := 33;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := SpinFakeAxis.CurrentCycle = 1, Message := 'Module must update the SpinAxis exactly once in its first scan.');
		AssertTrue(Condition := LiftFakeAxis.CurrentCycle = 1, Message := 'Module must update the LiftPin Axis exactly once in its first scan.');
		AssertTrue(Condition := (Module.ModuleVariableList[1].Id = 1) AND (Module.ModuleVariableList[2].Id = 2) AND (Module.ModuleVariableList[3].Id = 3) AND (Module.ModuleVariableList[4].Id = 4) AND (Module.ModuleVariableList[5].Id = 5), Message := 'Module variable descriptors must use stable sequential IDs.');
		AssertTrue(Condition := (Module.ModuleVariableList[1].Name = 'ChamberTemperature') AND (Module.ModuleVariableList[2].Name = 'ChamberPressure') AND (Module.ModuleVariableList[3].Name = 'SimulationTick') AND (Module.ModuleVariableList[4].Name = 'SpinAxisSpeed') AND (Module.ModuleVariableList[5].Name = 'LiftPinPosition'), Message := 'Module variable descriptor names must identify all five values.');
		AssertTrue(Condition := (Module.ModuleVariableList[1].DataType = E_DescriptorType.Float_32bit) AND (Module.ModuleVariableList[2].DataType = E_DescriptorType.Float_32bit) AND (Module.ModuleVariableList[3].DataType = E_DescriptorType.Integer_32bit) AND (Module.ModuleVariableList[4].DataType = E_DescriptorType.Float_32bit) AND (Module.ModuleVariableList[5].DataType = E_DescriptorType.Float_32bit), Message := 'Module variable descriptor types must match their serialized values.');
		AssertTrue(Condition := (Module.ModuleVariableList[1].Unit = 'degC') AND (Module.ModuleVariableList[2].Unit = 'Pa') AND (Module.ModuleVariableList[3].Unit = 'count') AND (Module.ModuleVariableList[4].Unit = 'unit/s') AND (Module.ModuleVariableList[5].Unit = 'unit'), Message := 'Module variable descriptor units must match the published values.');
		AssertTrue(Condition := (Module.ModuleVariableList[1].Value <> '') AND (Module.ModuleVariableList[2].Value <> '') AND (Module.ModuleVariableList[3].Value <> ''), Message := 'Simulated module values must be serialized every scan.');
		AssertTrue(Condition := Module.ModuleVariableList[4].Value = REAL_TO_STRING(LREAL_TO_REAL(SpinAxis.AxisActualVelocity)), Message := 'SpinAxisSpeed must use actual SpinAxis velocity feedback.');
		AssertTrue(Condition := Module.ModuleVariableList[5].Value = REAL_TO_STRING(LREAL_TO_REAL(LiftAxis.AxisActualPosition)), Message := 'LiftPinPosition must use actual LiftPin position feedback.');
		AssertTrue(Condition := Module.ModuleVariableList[6].Id = 0, Message := 'The first unused module variable descriptor must remain empty.');
		sPreviousTemperature := Module.ModuleVariableList[1].Value;
		sPreviousPressure := Module.ModuleVariableList[2].Value;
		sPreviousSimulationTick := Module.ModuleVariableList[3].Value;
		nPhase := 1;

	1:
		// Check CurrentCycle update correctly
		ModuleCtrl.RequestId := 123;
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := SpinFakeAxis.CurrentCycle = 2, Message := 'Module must not call SpinAxis cyclic update once per Service.');
		AssertTrue(Condition := LiftFakeAxis.CurrentCycle = 2, Message := 'Module must not call LiftPin cyclic update once per Service.');
		AssertTrue(Condition := Module.ModuleVariableList[1].Value <> sPreviousTemperature, Message := 'ChamberTemperature must update on every valid Module scan.');
		AssertTrue(Condition := Module.ModuleVariableList[2].Value <> sPreviousPressure, Message := 'ChamberPressure must update on every valid Module scan.');
		AssertTrue(Condition := Module.ModuleVariableList[3].Value <> sPreviousSimulationTick, Message := 'SimulationTick must update on every valid Module scan.');
		AssertTrue(Condition := Module.ModuleStatus.ResponseId = 123, Message := 'Module ctrl request id must equal to response id.');
		nPhase := 2;

	2:
		// Check module & every services shift to correct state
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := Module.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Clearing must wait until every Service is Stopped.');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Jog ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'MoveAbs ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'MoveVel ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'LiftPin CW ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'LiftPin CCW ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'LiftPin MoveAbs ServiceStatus must be Stopped state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'SingleProcess ServiceStatus must be Stopped after the module Clear path.');
		nPhase := 3;

	3:
		// Set Reset cmd to module
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 4;

	4:
		// Check module & every services shift to correct state
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := Module.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'Resetting must wait until every Service is Idle.');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'Jog ServiceStatus must be Idle state after module reset cmd.');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'MoveAbs ServiceStatus must be Idle state after module reset cmd');
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'MoveVel ServiceStatus must be Idle state after module reset cmd');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'LiftPin CW ServiceStatus must be Idle state after module reset cmd');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'LiftPin CCW ServiceStatus must be Idle state after module reset cmd');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'LiftPin MoveAbs ServiceStatus must be Idle state after module reset cmd');
		AssertTrue(Condition := Module.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'SingleProcess ServiceStatus must be routed to Idle after module Reset.');
		nPhase := 5;

	5:
		// Reset flag
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);

		// Check module run into Execute state spontaneously
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := Module.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Module must enter Execute after all services run into Idle state.');

		// Start all services at the same time
		ServiceCtrl.SpinAxisJogCW.RequestId := 123;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		
		ServiceCtrl.LiftPinAxisMoveVelCW.RequestId := 456;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 6;

	6:
		// Check if only one service get certain base unit resource
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nOwnerCount := 0;
		IF SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisJogCW) THEN nOwnerCount := nOwnerCount + 1; END_IF
		IF SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisMoveAbs) THEN nOwnerCount := nOwnerCount + 1; END_IF
		IF SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisMoveVelCW) THEN nOwnerCount := nOwnerCount + 1; END_IF
		nLiftOwnerCount := 0;
		IF LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveVelCW) THEN nLiftOwnerCount := nLiftOwnerCount + 1; END_IF
		IF LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveVelCCW) THEN nLiftOwnerCount := nLiftOwnerCount + 1; END_IF
		IF LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveAbs) THEN nLiftOwnerCount := nLiftOwnerCount + 1; END_IF
		AssertTrue(Condition := Module.ServiceStatus.SpinAxisJogCW.ResponseId = 123, Message := 'SpinAxisJogCW Service ctrl request id must equal to response id.');
		AssertTrue(Condition := Module.ServiceStatus.LiftPinAxisMoveVelCW.ResponseId = 456, Message := 'LiftAxisMoveVelCW Service ctrl request id must equal to response id.');
		
		// Check if request id equals to response id
		AssertTrue(Condition := nOwnerCount = 1, Message := 'Simultaneous Service Starts may choose any caller, but at most one may own the shared SpinAxis.');
		
		// Check if SpinAxis services have called the base unit as what we predict
		bAcceptedCommandFound := FALSE;
		FOR nCallIndex := 1 TO SpinFakeAxis.HistoryCount DO
			IF SpinFakeAxis.M_GetCall(Index := nCallIndex, CallRecord => CallRecord) AND CallRecord.Accepted AND CallRecord.Execute THEN
				bAcceptedCommandFound := TRUE;
				CASE CallRecord.Operation OF
					E_FakeAxisOperation.Jog:
						AssertTrue(Condition := (CallRecord.OwnerId = E_GCResourceOwnerId.SpinAxisJogCW) AND (CallRecord.Velocity = ECID.SpinAxisJogCW.Velocity) AND (CallRecord.Acceleration = ECID.SpinAxisJogCW.Acceleration) AND (CallRecord.Deceleration = ECID.SpinAxisJogCW.Deceleration), Message := 'Jog ECID and Owner ID must pass through Module.');
					E_FakeAxisOperation.MoveAbs:
						// Assert something if needed
					E_FakeAxisOperation.MoveVel:
						// Assert something if needed
				END_CASE
				EXIT;
			END_IF
		END_FOR


		// Check if LiftPinAxis services have called the base unit as what we predict
		bAcceptedCommandFound := FALSE;
		FOR nCallIndex := 1 TO LiftFakeAxis.HistoryCount DO
			IF LiftFakeAxis.M_GetCall(Index := nCallIndex, CallRecord => CallRecord) AND CallRecord.Accepted AND CallRecord.Execute THEN
				bAcceptedCommandFound := TRUE;
				CASE CallRecord.Operation OF
					E_FakeAxisOperation.Jog:
						// Assert something if needed
					E_FakeAxisOperation.MoveAbs:
						// Assert something if needed
					E_FakeAxisOperation.MoveVel:
						AssertTrue(Condition := (CallRecord.Direction = MC_Direction.MC_Positive_Direction) AND (CallRecord.Velocity = ECID.LiftPinAxisMoveVelCW.Velocity), Message := 'LiftPin CW direction and ECID must pass through Module.');
						AssertTrue(Condition := (CallRecord.Direction = MC_Direction.MC_Positive_Direction) AND (CallRecord.Velocity = ECID.LiftPinAxisMoveVelCW.Velocity), Message := 'LiftPin CW direction and ECID must pass through Module.');
				END_CASE
				EXIT;
			END_IF
		END_FOR

		nPhase := 7;

	7:
		// Reset flag
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);

		// Set script for LiftFakeAxis stopping state process
		LiftFakeAxis.M_QueueResult(
					Operation := E_FakeAxisOperation.Stop,
					AfterActiveCycles := 1,
					Done := TRUE,
					InVelocity := FALSE,
					Error := FALSE,
					ErrorId := 0);

		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);

		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisJogCW) OR SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisMoveAbs) OR SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisMoveVelCW), Message := 'Execute-state external ServiceCtrl must stop and release the active Spin Service.');
		AssertFalse(Condition := LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveVelCW) OR LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveVelCCW) OR LiftAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.LiftPinAxisMoveAbs), Message := 'Execute-state external ServiceCtrl must stop and release the active LiftPin Service.');
		nPhase := 8;

	8:
		// Reset flag
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);

		// Reset services
		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := TRUE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 9;

	9:
		// Reset flag
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.SpinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveVelCCW.PackMLIn.bCommandChangeRequest := FALSE;
		ServiceCtrl.LiftPinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);

		// Start SpinAxisJogCWService
		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisJogCW), Message := 'A deterministic Jog Start must acquire the shared SpinAxis with its assigned Owner ID.');
		nPhase := 10;

	10:
		// Check call record is as what we expect
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := FALSE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := SpinFakeAxis.M_GetCall(Index := SpinFakeAxis.HistoryCount, CallRecord => CallRecord), Message := 'Module-routed Jog command must be recorded.');
		AssertTrue(Condition := CallRecord.Accepted AND (CallRecord.Operation = E_FakeAxisOperation.Jog) AND (CallRecord.OwnerId = E_GCResourceOwnerId.SpinAxisJogCW), Message := 'Module must route Jog through the shared Interface and assigned Owner ID.');
		AssertTrue(Condition := (CallRecord.Velocity = ECID.SpinAxisJogCW.Velocity) AND (CallRecord.Acceleration = ECID.SpinAxisJogCW.Acceleration) AND (CallRecord.Deceleration = ECID.SpinAxisJogCW.Deceleration), Message := 'Module must pass Jog ECID parameters unchanged.');
		nPhase := 11;

	11:
		// Check resource has been released after stop the service
		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		Module(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_GCResourceOwnerId.SpinAxisJogCW), Message := 'Final Jog Stop must release the shared SpinAxis.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="UnboundAxisLeavesModuleInert" Id="{78647b77-734a-4eb9-b53f-950502397826}">
      <Declaration><![CDATA[METHOD UnboundAxisLeavesModuleInert
VAR
	FakeAxis : FB_FakeAxis_BaseUnit;
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	UnboundAxis : I_Axis_BaseUnit;
	HwInput : ST_GC_Signal_In;
	HwOutput : ST_GC_Signal_Out;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_GC_ServiceCtrl;
	ECID : ST_GC_ServiceParam;
	SystemContext : ST_SystemContext;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('UnboundAxisLeavesModuleInert');

SpinAxis := FakeAxis;
LiftAxis := FakeAxis;

SpinOnlyModule(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := UnboundAxis);
AssertTrue(Condition := SpinOnlyModule.PackMLOut.eStateCurrent = E_PackMLState.Undefined, Message := 'An unbound LiftPin Axis must keep the Module inert.');

LiftOnlyModule(HwInput := HwInput, HwOutput := HwOutput, ModuleCtrl := ModuleCtrl, ServiceCtrl := ServiceCtrl, ServiceParam := ECID, SystemContext := SystemContext, SpinAxis_BaseUnit := UnboundAxis, LiftPinAxis_BaseUnit := LiftAxis);
AssertTrue(Condition := LiftOnlyModule.PackMLOut.eStateCurrent = E_PackMLState.Undefined, Message := 'An unbound Spin Axis must keep the Module inert.');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
