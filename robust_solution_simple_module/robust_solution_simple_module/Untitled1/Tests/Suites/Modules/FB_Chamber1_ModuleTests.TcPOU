<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Chamber1_ModuleTests" Id="{96672931-1460-48e8-9f48-00c039353553}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Chamber1_ModuleTests EXTENDS TcUnit.FB_TestSuite
VAR
	// Keep large FB instances at Test Suite scope to avoid Method stack overflow.
	MissingAxisModule : FB_Chamber1_Module;
	MissingAxisFake : FB_FakeAxis_BaseUnit;

	LifecycleModule : FB_Chamber1_Module;
	LifecycleSpinFake : FB_FakeAxis_BaseUnit;
	LifecycleLiftFake : FB_FakeAxis_BaseUnit;

	RoutingModule : FB_Chamber1_Module;
	RoutingSpinFake : FB_FakeAxis_BaseUnit;
	RoutingLiftFake : FB_FakeAxis_BaseUnit;

	StoppingModule : FB_Chamber1_Module;
	StoppingSpinFake : FB_FakeAxis_BaseUnit;
	StoppingLiftFake : FB_FakeAxis_BaseUnit;

	AlarmModule : FB_Chamber1_Module;
	AlarmSpinFake : FB_FakeAxis_BaseUnit;
	AlarmLiftFake : FB_FakeAxis_BaseUnit;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[MissingAxisPreventsModuleUpdate();
ModuleClearResetAndAutoStartSynchronizesAllServices();
ExecuteRoutesSelectedServiceControlAndParameters();
ModuleStopOverridesServiceControlAndWaitsForCleanup();
SingleProcessFailureUsesUnifiedModuleAlarmLifecycle();]]></ST>
    </Implementation>
    <Method Name="ExecuteRoutesSelectedServiceControlAndParameters" Id="{b62fdc5d-8b55-4c68-93ae-3ba6effe2911}">
      <Declaration><![CDATA[METHOD ExecuteRoutesSelectedServiceControlAndParameters
VAR_INST
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	HwInput : ST_Chamber1_Signal_In;
	HwOutput : ST_Chamber1_Signal_Out;
	RuntimeConfig : ST_ModuleRuntimeConfig;
	VariableNodeReader : FB_LinkVariableManager;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_Chamber1_ServiceCtrl;
	ServiceParam : ST_Chamber1_ServiceParam;
	SystemContext : ST_SystemContext;
	CallRecord : ST_FakeAxisCall;
	nPhase : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ExecuteRoutesSelectedServiceControlAndParameters');

CASE nPhase OF
	0:
		// Set Module dependencies and selected Service param
		RoutingSpinFake.M_ResetScenario();
		RoutingLiftFake.M_ResetScenario();
		SpinAxis := RoutingSpinFake;
		LiftAxis := RoutingLiftFake;
		SystemContext.UtcDateTime := '20260813123456007';
		ServiceParam.SpinAxisMoveAbs.Position := 125.25;
		ServiceParam.SpinAxisMoveAbs.Velocity := 15;
		ServiceParam.SpinAxisMoveAbs.Acceleration := 25;
		ServiceParam.SpinAxisMoveAbs.Deceleration := 35;

		// Initial Module scan
		RoutingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		AssertTrue(
			Condition := (RoutingModule.ServiceStatus.SpinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion)
				AND (RoutingModule.ServiceStatus.SingleProcess.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion),
			Message := 'Finite Chamber1 Services must publish NaturalCompletion on their first cyclic update.');
		AssertTrue(
			Condition := (RoutingModule.ServiceStatus.SpinAxisJogCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.SpinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop),
			Message := 'Continuous Chamber1 Services must publish ExecuteUntilExternalStop on their first cyclic update.');
		nPhase := 1;

	1:
		// Clear Module and Services
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
			nPhase := 2;

	2:
		// Finish Clearing
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 3;

	3:
		// Reset Module and Services
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 4;

	4:
		// Finish Resetting
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 5;

	5:
		// Queue Module automatic Start
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 6;

	6:
		// Process Module automatic Start
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
		AssertTrue(Condition := RoutingModule.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Test setup must bring the Module to Execute.');
		nPhase := 7;

	7:
		// Start only SpinAxisMoveAbs through external ServiceCtrl
		ServiceCtrl.SpinAxisMoveAbs.RequestId := 2001;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
			
		// Only the selected Service may enter Execute and own Spin Axis
		AssertTrue(Condition := RoutingModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'External Start must route to SpinAxisMoveAbs.');
		AssertTrue(Condition := RoutingModule.ServiceStatus.SpinAxisMoveAbs.ResponseId = 2001, Message := 'Selected Service must acknowledge its RequestId.');
		AssertTrue(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'SpinAxisMoveAbs must acquire Spin Axis with its assigned OwnerId.');
		AssertTrue(
			Condition := (RoutingModule.ServiceStatus.SpinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion)
				AND (RoutingModule.ServiceStatus.SingleProcess.CompletionBehavior = E_ServiceCompletionBehavior.NaturalCompletion)
				AND (RoutingModule.ServiceStatus.SpinAxisJogCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.SpinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCCW.CompletionBehavior = E_ServiceCompletionBehavior.ExecuteUntilExternalStop),
			Message := 'Completion behavior must remain stable after Module and Service state transitions.');
		AssertTrue(
			Condition := (RoutingModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (RoutingModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (RoutingModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (RoutingModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Idle),
			Message := 'Unselected Services must remain Idle.');
		AssertTrue(Condition := RoutingLiftFake.HistoryCount = 0, Message := 'Selected Spin Service must not issue a LiftPin Axis command.');
		nPhase := 8;

	8:
		// Reset Service request flag and execute MoveAbs
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		RoutingModule(
			ModuleCtrl:= ModuleCtrl, 
			SystemContext:= SystemContext, 
			HeartbeatIndex:= , 
			RuntimeConfig:= RuntimeConfig, 
			VariableNodeReader:= VariableNodeReader,  
			ServiceCtrl:= ServiceCtrl, 
			ServiceParam:= ServiceParam, 
			SpinAxis_BaseUnit:= SpinAxis, 
			LiftPinAxis_BaseUnit:= LiftAxis);
			
		// Check OwnerId and all parameters passed through Module
		AssertTrue(Condition := RoutingSpinFake.M_GetCall(Index := RoutingSpinFake.HistoryCount, CallRecord => CallRecord), Message := 'Module-routed MoveAbs command must be recorded.');
		AssertTrue(Condition := CallRecord.Operation = E_FakeAxisOperation.MoveAbs, Message := 'Selected Service must issue MoveAbs.');
		AssertTrue(Condition := CallRecord.Accepted AND CallRecord.Execute, Message := 'Selected MoveAbs command must be active and accepted.');
		AssertTrue(Condition := CallRecord.OwnerId = E_Chamber1ServiceId.SpinAxisMoveAbs, Message := 'MoveAbs command must use the assigned Service OwnerId.');
		AssertTrue(Condition := CallRecord.Position = ServiceParam.SpinAxisMoveAbs.Position, Message := 'Module must pass Position unchanged.');
		AssertTrue(Condition := CallRecord.Velocity = ServiceParam.SpinAxisMoveAbs.Velocity, Message := 'Module must pass Velocity unchanged.');
		AssertTrue(Condition := CallRecord.Acceleration = ServiceParam.SpinAxisMoveAbs.Acceleration, Message := 'Module must pass Acceleration unchanged.');
		AssertTrue(Condition := CallRecord.Deceleration = ServiceParam.SpinAxisMoveAbs.Deceleration, Message := 'Module must pass Deceleration unchanged.');
		AssertTrue(Condition := RoutingLiftFake.HistoryCount = 0, Message := 'Routing selected Spin Service must leave LiftPin Axis untouched.');
		nPhase := 0;

		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="MissingAxisPreventsModuleUpdate" Id="{78647b77-734a-4eb9-b53f-950502397826}">
      <Declaration><![CDATA[METHOD MissingAxisPreventsModuleUpdate
VAR_INST
	BoundAxis : I_Axis_BaseUnit;
	UnboundAxis : I_Axis_BaseUnit;
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	HwInput : ST_Chamber1_Signal_In;
	HwOutput : ST_Chamber1_Signal_Out;
	RuntimeConfig : ST_ModuleRuntimeConfig;
	VariableNodeReader : FB_LinkVariableManager;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_Chamber1_ServiceCtrl;
	ServiceParam : ST_Chamber1_ServiceParam;
	SystemContext : ST_SystemContext;
	nPhase : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('MissingAxisPreventsModuleUpdate');

CASE nPhase OF
	0:
		// Bind Spin Axis only
		MissingAxisFake.M_ResetScenario();
		BoundAxis := MissingAxisFake;
		SpinAxis := BoundAxis;
		LiftAxis := UnboundAxis;

		// Cyclic update
		MissingAxisModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Missing LiftPin Axis must prevent the entire Module update
		AssertTrue(Condition := MissingAxisModule.PackMLOut.eStateCurrent = E_PackMLState.Undefined, Message := 'Missing LiftPin Axis must keep the Module Undefined.');
		AssertTrue(Condition := MissingAxisFake.CurrentCycle = 0, Message := 'Missing LiftPin Axis must prevent Spin Axis cyclic update.');
		AssertTrue(Condition := MissingAxisFake.HistoryCount = 0, Message := 'Missing LiftPin Axis must prevent Axis commands.');
		AssertTrue(
			Condition := (MissingAxisModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Undefined)
				AND (MissingAxisModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Undefined),
			Message := 'Missing LiftPin Axis must prevent every Service update.');
		AssertTrue(
			Condition := (MissingAxisModule.ServiceStatus.SpinAxisJogCW.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.SpinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.SpinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveVelCW.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveVelCCW.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.LiftPinAxisMoveAbs.CompletionBehavior = E_ServiceCompletionBehavior.Unknown)
				AND (MissingAxisModule.ServiceStatus.SingleProcess.CompletionBehavior = E_ServiceCompletionBehavior.Unknown),
			Message := 'Services that have not run a cyclic update must keep Unknown completion behavior.');
		nPhase := 1;

	1:
		// Bind LiftPin Axis only
		SpinAxis := UnboundAxis;
		LiftAxis := BoundAxis;

		// Cyclic update
		MissingAxisModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Missing Spin Axis must prevent the entire Module update
		AssertTrue(Condition := MissingAxisModule.PackMLOut.eStateCurrent = E_PackMLState.Undefined, Message := 'Missing Spin Axis must keep the Module Undefined.');
		AssertTrue(Condition := MissingAxisFake.CurrentCycle = 0, Message := 'Missing Spin Axis must prevent LiftPin Axis cyclic update.');
		AssertTrue(Condition := MissingAxisFake.HistoryCount = 0, Message := 'Missing Spin Axis must prevent Axis commands.');
		nPhase := 0;

		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ModuleClearResetAndAutoStartSynchronizesAllServices" Id="{08f6ebae-7123-48dc-89e6-73b2de80ca9a}">
      <Declaration><![CDATA[METHOD ModuleClearResetAndAutoStartSynchronizesAllServices
VAR_INST
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	HwInput : ST_Chamber1_Signal_In;
	HwOutput : ST_Chamber1_Signal_Out;
	RuntimeConfig : ST_ModuleRuntimeConfig;
	VariableNodeReader : FB_LinkVariableManager;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_Chamber1_ServiceCtrl;
	ServiceParam : ST_Chamber1_ServiceParam;
	SystemContext : ST_SystemContext;
	nPhase : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ModuleClearResetAndAutoStartSynchronizesAllServices');

CASE nPhase OF
	0:
		// Set Module dependencies
		LifecycleSpinFake.M_ResetScenario();
		LifecycleLiftFake.M_ResetScenario();
		SpinAxis := LifecycleSpinFake;
		LiftAxis := LifecycleLiftFake;
		SystemContext.UtcDateTime := '20260813123456007';

		// 1st Module scan
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module and every Service leave Undefined together
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Aborted, Message := 'Initial Module scan must reach Aborted.');
		AssertTrue(
			Condition := (LifecycleModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Aborted)
				AND (LifecycleModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Aborted),
			Message := 'Initial scan must route every Service to Aborted.');
		AssertTrue(Condition := (LifecycleSpinFake.CurrentCycle = 1) AND (LifecycleLiftFake.CurrentCycle = 1), Message := 'Module must update each BaseUnit exactly once per scan.');
		nPhase := 1;

	1:
		// Set Module PackML cmd: Clear
		ModuleCtrl.RequestId := 1001;
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;

		// Cyclic update
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module waits one scan for all ServiceStatus values
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Clearing, Message := 'Module must remain Clearing while Services process Clear.');
		AssertTrue(
			Condition := (LifecycleModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (LifecycleModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Stopped),
			Message := 'Module Clear must route every Service to Stopped.');
		AssertTrue(Condition := LifecycleModule.ModuleStatus.ResponseId = 1001, Message := 'Module must acknowledge the Clear RequestId.');
		nPhase := 2;

	2:
		// Reset request flag
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;

		// Cyclic update
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module completes Clearing only after observing all Services Stopped
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Module must reach Stopped after every Service is Stopped.');
		nPhase := 3;

	3:
		// Set Module PackML cmd: Reset
		ModuleCtrl.RequestId := 1002;
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;

		// Cyclic update
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module waits one scan for all ServiceStatus values
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Resetting, Message := 'Module must remain Resetting while Services process Reset.');
		AssertTrue(
			Condition := (LifecycleModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Idle),
			Message := 'Module Reset must route every Service to Idle.');
		AssertTrue(Condition := LifecycleModule.ModuleStatus.ResponseId = 1002, Message := 'Module must acknowledge the Reset RequestId.');
		nPhase := 4;

	4:
		// Reset request flag
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;

		// Cyclic update
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module completes Resetting only after observing all Services Idle
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'Module must reach Idle after every Service is Idle.');
		nPhase := 5;

	5:
		// Idle hook queues an internal Start command
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Idle, Message := 'Module must remain Idle during the scan that queues Start.');
		nPhase := 6;

	6:
		// Process queued Start
		LifecycleModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Execute uses external ServiceCtrl, so Services remain Idle
		AssertTrue(Condition := LifecycleModule.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Queued Start must move the Module to Execute.');
		AssertTrue(
			Condition := (LifecycleModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Idle)
				AND (LifecycleModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Idle),
			Message := 'Module Execute must leave Services under external control in Idle.');
		AssertTrue(Condition := (LifecycleSpinFake.CurrentCycle = 7) AND (LifecycleLiftFake.CurrentCycle = 7), Message := 'Seven Module scans must update each BaseUnit exactly seven times.');
		nPhase := 0;

		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="ModuleStopOverridesServiceControlAndWaitsForCleanup" Id="{d946a556-91bb-4e38-a388-0114e8da4d91}">
      <Declaration><![CDATA[METHOD ModuleStopOverridesServiceControlAndWaitsForCleanup
VAR_INST
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	HwInput : ST_Chamber1_Signal_In;
	HwOutput : ST_Chamber1_Signal_Out;
	RuntimeConfig : ST_ModuleRuntimeConfig;
	VariableNodeReader : FB_LinkVariableManager;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_Chamber1_ServiceCtrl;
	ServiceParam : ST_Chamber1_ServiceParam;
	SystemContext : ST_SystemContext;
	MoveWithdrawalCall : ST_FakeAxisCall;
	StopCall : ST_FakeAxisCall;
	nHistoryBeforeStopping : UINT;
	nPhase : UINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('ModuleStopOverridesServiceControlAndWaitsForCleanup');

CASE nPhase OF
	0:
		// Set Module dependencies and selected Service param
		StoppingSpinFake.M_ResetScenario();
		StoppingLiftFake.M_ResetScenario();
		SpinAxis := StoppingSpinFake;
		LiftAxis := StoppingLiftFake;
		SystemContext.UtcDateTime := '20260813123456007';
		ServiceParam.SpinAxisMoveAbs.Position := 50;
		ServiceParam.SpinAxisMoveAbs.Velocity := 10;
		ServiceParam.SpinAxisMoveAbs.Acceleration := 20;
		ServiceParam.SpinAxisMoveAbs.Deceleration := 30;

		// Initial Module scan
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 1;

	1:
		// Clear Module and Services
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 2;

	2:
		// Finish Clearing
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 3;

	3:
		// Reset Module and Services
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 4;

	4:
		// Finish Resetting
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 5;

	5:
		// Queue Module automatic Start
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		nPhase := 6;

	6:
		// Process Module automatic Start
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		AssertTrue(Condition := StoppingModule.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Test setup must bring the Module to Execute.');
		nPhase := 7;

	7:
		// Start SpinAxisMoveAbs through external ServiceCtrl
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := TRUE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);
		AssertTrue(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'Test setup must let SpinAxisMoveAbs own Spin Axis.');
		nPhase := 8;

	8:
		// Reset Service request flag and issue the active MoveAbs command
		ServiceCtrl.SpinAxisMoveAbs.PackMLIn.bCommandChangeRequest := FALSE;
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Set asynchronous Stop script
		AssertTrue(
			Condition := StoppingSpinFake.M_QueueResult(
				Operation := E_FakeAxisOperation.Stop,
				AfterActiveCycles := 2,
				Done := TRUE,
				InVelocity := FALSE,
				Error := FALSE,
				ErrorId := 0),
			Message := 'Stop Done script must be accepted.');
		nPhase := 9;

	9:
		// External ServiceCtrl attempts another Start while Module requests Stop
		ServiceCtrl.SpinAxisJogCW.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SpinAxisJogCW.PackMLIn.bCommandChangeRequest := TRUE;
		ModuleCtrl.RequestId := 3001;
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Stop;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		nHistoryBeforeStopping := StoppingSpinFake.HistoryCount;

		// Cyclic update
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module control overrides external ServiceCtrl outside Execute
		AssertTrue(Condition := StoppingModule.PackMLOut.eStateCurrent = E_PackMLState.Stopping, Message := 'Module Stop must enter Stopping.');
		AssertTrue(Condition := StoppingModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopping, Message := 'Active MoveAbs Service must enter Stopping.');
		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisJogCW), Message := 'External Jog Start must be ignored during Module Stopping.');
		AssertTrue(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'MoveAbs must retain ownership while Stop is pending.');
		AssertTrue(Condition := StoppingModule.ModuleStatus.ResponseId = 3001, Message := 'Module must acknowledge the Stop RequestId.');

		// MoveAbs withdrawal must precede physical Stop
		AssertTrue(Condition := StoppingSpinFake.M_GetCall(Index := nHistoryBeforeStopping + 1, CallRecord => MoveWithdrawalCall), Message := 'Module Stop must record MoveAbs withdrawal.');
		AssertTrue(Condition := MoveWithdrawalCall.Operation = E_FakeAxisOperation.MoveAbs, Message := 'Stopping must withdraw MoveAbs before Stop.');
		AssertTrue(Condition := MoveWithdrawalCall.Accepted AND NOT MoveWithdrawalCall.Execute, Message := 'MoveAbs withdrawal must be accepted before ownership release.');
		AssertTrue(Condition := StoppingSpinFake.M_GetCall(Index := nHistoryBeforeStopping + 2, CallRecord => StopCall), Message := 'Module Stop must record physical Stop.');
		AssertTrue(Condition := StopCall.Operation = E_FakeAxisOperation.Stop, Message := 'Physical Stop must follow MoveAbs withdrawal.');
		AssertTrue(Condition := StopCall.Accepted AND StopCall.Execute, Message := 'Physical Stop must be active and accepted.');
		nPhase := 10;

	10:
		// Stop is still pending; script publishes Done after this BaseUnit update
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		AssertTrue(Condition := StoppingModule.PackMLOut.eStateCurrent = E_PackMLState.Stopping, Message := 'Module must wait while a Service Stop is pending.');
		AssertTrue(Condition := StoppingModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopping, Message := 'MoveAbs Service must wait for Stop Done.');
		AssertTrue(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'Pending Stop must retain Spin Axis ownership.');
		nPhase := 11;

	11:
		// Service observes Stop Done and performs cleanup
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		// Module waits one additional scan to observe updated ServiceStatus
		AssertTrue(Condition := StoppingModule.PackMLOut.eStateCurrent = E_PackMLState.Stopping, Message := 'Module must remain Stopping until the next scan observes every Service Stopped.');
		AssertTrue(Condition := StoppingModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Stop Done must move the active Service to Stopped.');
		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'Stop Done must release Spin Axis ownership.');
		AssertTrue(Condition := StoppingSpinFake.M_GetCall(Index := StoppingSpinFake.HistoryCount, CallRecord => StopCall), Message := 'Stop falling edge must be recorded.');
		AssertTrue(Condition := (StopCall.Operation = E_FakeAxisOperation.Stop) AND StopCall.Accepted AND NOT StopCall.Execute, Message := 'Service must withdraw Stop before releasing ownership.');
		nPhase := 12;

	12:
		// Module observes every Service Stopped
		StoppingModule(
			ModuleCtrl:= ModuleCtrl,
			SystemContext:= SystemContext,
			HeartbeatIndex:= ,
			RuntimeConfig:= RuntimeConfig,
			VariableNodeReader:= VariableNodeReader,
			ServiceCtrl:= ServiceCtrl,
			ServiceParam:= ServiceParam,
			SpinAxis_BaseUnit:= SpinAxis,
			LiftPinAxis_BaseUnit:= LiftAxis);

		AssertTrue(Condition := StoppingModule.PackMLOut.eStateCurrent = E_PackMLState.Stopped, Message := 'Module must reach Stopped only after every Service is Stopped.');
		AssertTrue(
			Condition := (StoppingModule.ServiceStatus.SpinAxisJogCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.SpinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.SpinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.LiftPinAxisMoveVelCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.LiftPinAxisMoveVelCCW.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.LiftPinAxisMoveAbs.PackMLOut.eStateCurrent = E_PackMLState.Stopped)
				AND (StoppingModule.ServiceStatus.SingleProcess.PackMLOut.eStateCurrent = E_PackMLState.Stopped),
			Message := 'Module Stopped requires every Service Stopped.');
		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisMoveAbs), Message := 'Stopped Module must not retain Spin Axis ownership.');
		AssertFalse(Condition := SpinAxis.M_IsResourceOwner(OwnerId := E_Chamber1ServiceId.SpinAxisJogCW), Message := 'Ignored external Jog Start must not acquire ownership later.');
		nPhase := 0;

		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="SingleProcessFailureUsesUnifiedModuleAlarmLifecycle" Id="{f9468e9f-4d68-4786-8d2b-f286d682c729}">
      <Declaration><![CDATA[METHOD SingleProcessFailureUsesUnifiedModuleAlarmLifecycle
VAR_INST
	SpinAxis : I_Axis_BaseUnit;
	LiftAxis : I_Axis_BaseUnit;
	RuntimeConfig : ST_ModuleRuntimeConfig;
	VariableNodeReader : FB_LinkVariableManager;
	ModuleCtrl : ST_ModuleCtrl;
	ServiceCtrl : ST_Chamber1_ServiceCtrl;
	ServiceParam : ST_Chamber1_ServiceParam;
	SystemContext : ST_SystemContext;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('SingleProcessFailureUsesUnifiedModuleAlarmLifecycle');

CASE nPhase OF
	0:
		AlarmSpinFake.M_ResetScenario();
		AlarmLiftFake.M_ResetScenario();
		SpinAxis := AlarmSpinFake;
		LiftAxis := AlarmLiftFake;
		RuntimeConfig.ModuleId := 77;
		SystemContext.UtcDateTime := '20260828130000000';
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 1;

	1:
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 2;

	2:
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 3;

	3:
		ModuleCtrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ModuleCtrl.PackMLIn.bCommandChangeRequest := TRUE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 4;

	4:
		ModuleCtrl.PackMLIn.bCommandChangeRequest := FALSE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 5;

	5:
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		nPhase := 6;

	6:
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := AlarmModule.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Test setup must bring the Module to Execute.');
		nPhase := 7;

	7:
		// Default SingleProcess parameters are invalid and fail during Starting.
		ServiceCtrl.SingleProcess.RequestId := 7001;
		ServiceCtrl.SingleProcess.PackMLIn.eCommand := E_PackMLCommand.Start;
		ServiceCtrl.SingleProcess.PackMLIn.bCommandChangeRequest := TRUE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := AlarmModule.ServiceStatus.SingleProcess.ErrorList[1].MainErrorId = E_Chamber1ErrorCode.Invalid_Param, Message := 'SingleProcess first failure must enter its Service ErrorList.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].ModuleId = 77, Message := 'The unified manager must normalize the Module identity.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].ServiceId = E_Chamber1ServiceId.SingleProcess, Message := 'The Chamber1 Module must submit the SingleProcess Service identity.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].MainErrorId = E_Chamber1ErrorCode.Invalid_Param, Message := 'The Chamber1 Module must publish the Service failure.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].Active AND (AlarmModule.ModuleAlarmList[1].OccurrenceCount = 1), Message := 'First Service failure must publish active with one occurrence.');
		AssertTrue(Condition := FIND(AlarmModule.ModuleAlarmList[1].Message, 'Axis=None') > 0, Message := 'SingleProcess alarm message must identify the failed axis.');
		AssertTrue(Condition := FIND(AlarmModule.ModuleAlarmList[1].Message, 'Stage=Prepare') > 0, Message := 'SingleProcess alarm message must identify the failed stage.');
		nPhase := 8;

	8:
		ServiceCtrl.SingleProcess.PackMLIn.bCommandChangeRequest := FALSE;
		ModuleCtrl.AlarmAckRequest.RequestId := 9001;
		ModuleCtrl.AlarmAckRequest.Command := E_AlarmAckCommand.AcknowledgeOne;
		ModuleCtrl.AlarmAckRequest.MainErrorId := E_Chamber1ErrorCode.Invalid_Param;
		ModuleCtrl.AlarmAckRequest.bChangeRequest := TRUE;
		ModuleCtrl.AlarmAckRequest.ServiceId := E_Chamber1ServiceId.SingleProcess;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := AlarmModule.ModuleStatus.Alarm.AckAccepted AND (AlarmModule.ModuleStatus.Alarm.AckResponseId = 9001), Message := 'Module Ack response must confirm the exact Service alarm.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].Active AND AlarmModule.ModuleAlarmList[1].Acknowledged, Message := 'Ack-before-reset must retain the active lifecycle.');
		nPhase := 9;

	9:
		ModuleCtrl.AlarmAckRequest.bChangeRequest := FALSE;
		ServiceCtrl.SingleProcess.PackMLIn.eCommand := E_PackMLCommand.Reset;
		ServiceCtrl.SingleProcess.PackMLIn.bCommandChangeRequest := TRUE;
		AlarmModule(ModuleCtrl := ModuleCtrl, SystemContext := SystemContext, HeartbeatIndex := , RuntimeConfig := RuntimeConfig, VariableNodeReader := VariableNodeReader, ServiceCtrl := ServiceCtrl, ServiceParam := ServiceParam, SpinAxis_BaseUnit := SpinAxis, LiftPinAxis_BaseUnit := LiftAxis);
		AssertTrue(Condition := AlarmModule.ServiceStatus.SingleProcess.ErrorList[1].MainErrorId = 0, Message := 'SingleProcess Resetting must clear its Service ErrorList.');
		AssertTrue(Condition := AlarmModule.ModuleAlarmList[1].MainErrorId = 0, Message := 'Inactive and acknowledged Service alarm must be removed in the reset scan.');
		AssertTrue(Condition := AlarmModule.ModuleStatus.Alarm.ServiceLatchedCount = 0, Message := 'Service latched count must follow same-scan removal.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
