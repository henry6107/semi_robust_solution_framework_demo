<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCLiftPinAxisMoveVelCCWServiceTests" Id="{b1cc0001-5c2d-4e3f-9a80-b1cc00000001}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCLiftPinAxisMoveVelCCWServiceTests EXTENDS TcUnit.FB_TestSuite
VAR
	Context : ST_ServiceContext;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[Context.ModuleId := E_ModuleId.GC1;
Context.UtcDateTime := '20260813123456007';

VelocityChangeRetriggersWithOneLowScan();
AbortResetErrorTerminatesAndReleasesAxis();]]></ST>
    </Implementation>
    <Method Name="AbortResetErrorTerminatesAndReleasesAxis" Id="{b1cc0003-5c2d-4e3f-9a80-b1cc00000003}">
      <Declaration><![CDATA[METHOD AbortResetErrorTerminatesAndReleasesAxis
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCLiftPinAxisMoveVelCCWServices;
	Ctrl : ST_ServiceCtrl;
	Param : ST_GCLiftPinAxisMoveVelParam;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('AbortResetErrorTerminatesAndReleasesAxis');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Velocity := 10;
		Param.Acceleration := 20;
		Param.Deceleration := 30;
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.Reset, AfterActiveCycles := 1, Done := FALSE, InVelocity := FALSE, Error := TRUE, ErrorId := 16#9999), Message := 'Reset Error script must be accepted.');
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		nPhase := 1;
	1:
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		nPhase := 2;
	2:
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Start;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Axis.M_IsResourceOwner(OwnerId := 32), Message := 'Executing MoveVelocity must own the Axis.');
		nPhase := 3;
	3:
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Abort;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Aborting, Message := 'Abort must wait for asynchronous Reset feedback.');
		nPhase := 4;
	4:
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 32);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Aborted, Message := 'Reset Error must finish Aborting.');
		AssertTrue(Condition := Service.Status.ErrorList[1].MainErrorId = E_GCErrorCode.Error_While_Reset_Axis, Message := 'MoveVelocity Abort must record the shared Reset Error code.');
		AssertTrue(Condition := Service.Status.ErrorList[1].SourceErrorId = 16#9999, Message := 'MoveVelocity Reset Error must preserve the Axis source error ID.');
		AssertTrue(Condition := Service.Status.ErrorList[1].ModuleId = Context.ModuleId, Message := 'MoveVelocity Reset Error must preserve the injected Module ID.');
		AssertTrue(Condition := Service.Status.ErrorList[1].ServiceId = 32, Message := 'MoveVelocity Reset Error must preserve the assigned Service ID.');
		AssertTrue(Condition := Service.Status.ErrorList[1].Path <> '', Message := 'MoveVelocity Reset Error must preserve the Service instance path.');
		AssertTrue(Condition := Service.Status.ErrorList[1].DateTime = Context.UtcDateTime, Message := 'MoveVelocity Reset Error must preserve the injected UTC timestamp.');
		AssertTrue(Condition := Service.Status.ErrorList[1].Severity = E_Severity.Alarm, Message := 'MoveVelocity Reset Error must use Alarm severity.');
		AssertTrue(Condition := Service.Status.ErrorList[2].MainErrorId = 0, Message := 'Repeated Aborting scans must not duplicate the Reset Error.');
		AssertTrue(Condition := Service.Status.ServiceErrorId = 0, Message := 'MoveVelocity must not update ServiceErrorId.');
		AssertFalse(Condition := Axis.M_IsResourceOwner(OwnerId := 32), Message := 'Reset Error must release MoveVelocity ownership.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Method Name="VelocityChangeRetriggersWithOneLowScan" Id="{b1cc0002-5c2d-4e3f-9a80-b1cc00000002}">
      <Declaration><![CDATA[METHOD VelocityChangeRetriggersWithOneLowScan
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCLiftPinAxisMoveVelCCWServices;
	Ctrl : ST_ServiceCtrl;
	Param : ST_GCLiftPinAxisMoveVelParam;
	LowCall : ST_FakeAxisCall;
	HighCall : ST_FakeAxisCall;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('VelocityChangeRetriggersWithOneLowScan');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Velocity := 10;
		Param.Acceleration := 20;
		Param.Deceleration := 30;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		nPhase := 1;
	1:
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Clear;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Reset;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		nPhase := 2;
	2:
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.eCommand := E_PackMLCommand.Start;
		Ctrl.PackMLIn.bCommandChangeRequest := TRUE;
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		Ctrl.PackMLIn.bCommandChangeRequest := FALSE;
		nPhase := 3;
	3:
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => HighCall), Message := 'Initial MoveVelocity command must be recorded.');
		AssertTrue(Condition := HighCall.Execute AND (HighCall.Velocity = 10), Message := 'Initial velocity must execute once active.');
		AssertTrue(Condition := HighCall.Direction = MC_Direction.MC_Negative_Direction, Message := 'LiftPin CCW must use the negative direction.');
		nPhase := 4;
	4:
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => HighCall), Message := 'Steady MoveVelocity call must be recorded.');
		AssertTrue(Condition := HighCall.Execute, Message := 'Unchanged velocity must not pulse Execute low.');
		Param.Velocity := 25;
		nPhase := 5;
	5:
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => LowCall), Message := 'Retrigger low call must be recorded.');
		AssertFalse(Condition := LowCall.Execute, Message := 'Velocity change must pulse Execute low for one scan.');
		AssertTrue(Condition := LowCall.Velocity = 25, Message := 'Low retrigger scan must carry the new velocity.');
		AssertTrue(Condition := Axis.M_IsResourceOwner(OwnerId := 31), Message := 'Retrigger must retain ownership.');
		nPhase := 6;
	6:
		Service(Ctrl := Ctrl, Param := Param, Context := Context, Axis_BaseUnit := Axis, ResourceOwnerId := 31);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => HighCall), Message := 'Retrigger high call must be recorded.');
		AssertTrue(Condition := HighCall.Execute AND (HighCall.Velocity = 25), Message := 'Execute must rise with the new velocity on the following scan.');
		AssertTrue(Condition := HighCall.Sequence = LowCall.Sequence + 1, Message := 'Retrigger calls must be consecutive.');
		AssertTrue(Condition := Service.Status.ErrorList[1].MainErrorId = 0, Message := 'Successful MoveVelocity retrigger must not create an error record.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
