<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCLiftPinAxisMoveAbsServiceTests" Id="{b1ab0001-5c2d-4e3f-9a80-b1ab00000001}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCLiftPinAxisMoveAbsServiceTests EXTENDS TcUnit.FB_TestSuite
]]></Declaration>
    <Implementation><ST><![CDATA[DelayedDoneCompletesAndReleasesAxis();
StopAndResetErrorsReachRecoverableAbortedState();]]></ST></Implementation>
    <Method Name="DelayedDoneCompletesAndReleasesAxis" Id="{b1ab0002-5c2d-4e3f-9a80-b1ab00000002}">
      <Declaration><![CDATA[METHOD DelayedDoneCompletesAndReleasesAxis
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCLiftPinAxisMoveAbsServices;
	Ctrl : ST_PML_Base_In;
	Param : ST_GCLiftPinAxisMoveAbsParam;
	CallRecord : ST_FakeAxisCall;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[TEST('DelayedDoneCompletesAndReleasesAxis');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Position := 125.25;
		Param.Velocity := 15;
		Param.Acceleration := 25;
		Param.Deceleration := 35;
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.MoveAbs, AfterActiveCycles := 2, Done := TRUE, InVelocity := FALSE, Error := FALSE, ErrorId := 0), Message := 'MoveAbs Done script must be accepted.');
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		nPhase := 1;
	1:
		Ctrl.eCommand := E_PackMLCommand.Clear;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		Ctrl.bCommandChangeRequest := FALSE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		Ctrl.eCommand := E_PackMLCommand.Reset;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		nPhase := 2;
	2:
		Ctrl.bCommandChangeRequest := FALSE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		Ctrl.eCommand := E_PackMLCommand.Start;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		Ctrl.bCommandChangeRequest := FALSE;
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Execute, Message := 'Valid MoveAbs must enter Execute.');
		nPhase := 3;
	3:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => CallRecord), Message := 'MoveAbs command must be recorded.');
		AssertTrue(Condition := CallRecord.Execute, Message := 'MoveAbs must assert Execute.');
		AssertTrue(Condition := (CallRecord.Position = 125.25) AND (CallRecord.Velocity = 15), Message := 'MoveAbs position and velocity must be preserved.');
		nPhase := 4;
	4:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Axis.M_IsResourceOwner(OwnerId := 21), Message := 'MoveAbs must retain ownership while Done is pending.');
		nPhase := 5;
	5:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Completing, Message := 'Delayed Done must enter Completing.');
		nPhase := 6;
	6:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 21);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Complete, Message := 'Completing must finish at Complete.');
		AssertFalse(Condition := Axis.M_IsResourceOwner(OwnerId := 21), Message := 'Complete must release Axis ownership.');
		AssertTrue(Condition := FakeAxis.M_GetCall(Index := FakeAxis.HistoryCount, CallRecord => CallRecord), Message := 'MoveAbs withdrawal must be recorded.');
		AssertFalse(Condition := CallRecord.Execute, Message := 'Completing must withdraw MoveAbs Execute.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
    <Method Name="StopAndResetErrorsReachRecoverableAbortedState" Id="{b1ab0003-5c2d-4e3f-9a80-b1ab00000003}">
      <Declaration><![CDATA[METHOD StopAndResetErrorsReachRecoverableAbortedState
VAR_INST
	FakeAxis : FB_FakeAxis_BaseUnit;
	Axis : I_Axis_BaseUnit;
	Service : FB_GCLiftPinAxisMoveAbsServices;
	Ctrl : ST_PML_Base_In;
	Param : ST_GCLiftPinAxisMoveAbsParam;
	nPhase : UINT;
END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[TEST('StopAndResetErrorsReachRecoverableAbortedState');

CASE nPhase OF
	0:
		FakeAxis.M_ResetScenario();
		Axis := FakeAxis;
		Param.Position := 50;
		Param.Velocity := 10;
		Param.Acceleration := 20;
		Param.Deceleration := 30;
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.MoveAbs, AfterActiveCycles := 1, Done := FALSE, InVelocity := FALSE, Error := TRUE, ErrorId := 1), Message := 'MoveAbs Error must be queued.');
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.Stop, AfterActiveCycles := 1, Done := FALSE, InVelocity := FALSE, Error := TRUE, ErrorId := 2), Message := 'Stop Error must be queued.');
		AssertTrue(Condition := FakeAxis.M_QueueResult(Operation := E_FakeAxisOperation.Reset, AfterActiveCycles := 1, Done := FALSE, InVelocity := FALSE, Error := TRUE, ErrorId := 3), Message := 'Reset Error must be queued.');
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		nPhase := 1;
	1:
		Ctrl.eCommand := E_PackMLCommand.Clear;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		Ctrl.bCommandChangeRequest := FALSE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		Ctrl.eCommand := E_PackMLCommand.Reset;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		nPhase := 2;
	2:
		Ctrl.bCommandChangeRequest := FALSE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		Ctrl.eCommand := E_PackMLCommand.Start;
		Ctrl.bCommandChangeRequest := TRUE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		Ctrl.bCommandChangeRequest := FALSE;
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		nPhase := 3;
	3:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.Status.ServiceErrorId = E_GCServiceErrorCode.Axis_Command_Error_During_Execute, Message := 'MoveAbs Error must use the shared Service error code.');
		nPhase := 4;
	4:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Axis.M_IsResourceOwner(OwnerId := 22), Message := 'Stop Pending/Error handling must retain ownership until Abort cleanup.');
		nPhase := 5;
	5:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		nPhase := 6;
	6:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		nPhase := 7;
	7:
		Service(PackMLIn := Ctrl, Param := Param, Axis_BaseUnit := Axis, ResourceOwnerId := 22);
		FakeAxis.M_CyclicUpdate();
		AssertTrue(Condition := Service.PackMLOut.eStateCurrent = E_PackMLState.Aborted, Message := 'Reset Error must terminate Aborting at Aborted.');
		AssertTrue(Condition := Service.Status.Error, Message := 'Reset Error must remain reported.');
		AssertTrue(Condition := Service.Status.ServiceErrorId = E_GCServiceErrorCode.Error_While_Reset_Axis, Message := 'Reset Error must use the shared Service error code.');
		AssertFalse(Condition := Axis.M_IsResourceOwner(OwnerId := 22), Message := 'Reset Error must release ownership.');
		nPhase := 0;
		TEST_FINISHED();
END_CASE]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
