<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_FakeAxis_BaseUnit" Id="{e3e8b765-2c8e-48cb-88c1-18c6481deefe}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_FakeAxis_BaseUnit EXTENDS FB_BaseUnit IMPLEMENTS I_Axis_BaseUnit
VAR
	_bAxisIsDisabled : BOOL;
	_bAxisHasJob : BOOL;
	_nCycle : UDINT;
	_nCallSequence : UDINT;

	_aScripts : ARRAY[1..32] OF ST_FakeAxisScriptStep;
	_nScriptCount : UINT;
	_bScriptOverflowed : BOOL;
	_bScriptConfigurationError : BOOL;

	_aHistory : ARRAY[1..256] OF ST_FakeAxisCall;
	_nHistoryCount : UINT;
	_bHistoryOverflowed : BOOL;

	_bJogActive : BOOL;
	_bMoveAbsActive : BOOL;
	_bMoveVelActive : BOOL;
	_bStopActive : BOOL;
	_bResetActive : BOOL;

	_bJogDone : BOOL;
	_bJogInVelocity : BOOL;
	_bJogError : BOOL;
	_nJogErrorId : UDINT;
	_bMoveAbsDone : BOOL;
	_bMoveAbsInVelocity : BOOL;
	_bMoveAbsError : BOOL;
	_nMoveAbsErrorId : UDINT;
	_bMoveVelDone : BOOL;
	_bMoveVelInVelocity : BOOL;
	_bMoveVelError : BOOL;
	_nMoveVelErrorId : UDINT;
	_bStopDone : BOOL;
	_bStopInVelocity : BOOL;
	_bStopError : BOOL;
	_nStopErrorId : UDINT;
	_bResetDone : BOOL;
	_bResetInVelocity : BOOL;
	_bResetError : BOOL;
	_nResetErrorId : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_CyclicUpdate();]]></ST>
    </Implementation>
