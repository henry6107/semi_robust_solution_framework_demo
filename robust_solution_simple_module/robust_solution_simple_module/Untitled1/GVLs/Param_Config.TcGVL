<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="Param_Config" Id="{aee02a59-14c8-4392-aff7-2b6206c787f0}" ParameterList="True">
    <Declaration><![CDATA[{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	MaxModuleVariable : UINT := 100;
	MaxModuleAlarm : UINT := 100;
	MaxServiceError : UINT := 10;
	MaxModuleData : UINT := 50;
	ModuleHeartbeat_Timout : TIME := T#10S;

	// Runtime configuration limits. They also bound PLC memory and ADS Sum Command work.
	MaxConfiguredModules : UINT := 6;
	MaxModuleTypes : UINT := 8;
	MaxModuleMappings : UINT := 64;
	MaxModuleReferenceBindings : UINT := 4;
	MaxConfigVariableNodes : UINT := 512;
	MaxConfigReferenceNodes : UINT := 16;
	MaxConfigSources : UINT := MaxModuleVariable + MaxModuleAlarm;
	MaxConfigValueSize : UINT := 81; // STRING(80), including the terminating zero.
	MaxAdsSumResponseSize : UINT := (MaxConfigSources * 4) + (MaxConfigSources * MaxConfigValueSize);

	ConfigSchemaVersion : UDINT := 2;
	DefaultPlcAdsPort : UINT := 851;
	ConfigAdsTimeout : TIME := T#2S;
	ModuleConfigFilePath : STRING(255) := 'C:\ProgramData\RobustSolution\module-config.json';
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>
