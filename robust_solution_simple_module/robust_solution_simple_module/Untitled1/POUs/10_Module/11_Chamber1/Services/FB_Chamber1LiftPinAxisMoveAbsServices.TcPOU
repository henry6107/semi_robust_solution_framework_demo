H_OnSuspending := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnUndefined" Id="{a1ab0012-6b2c-4d3e-8f90-a1ab00000012}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnUndefined : E_PackMLHookResult
VAR_INPUT
