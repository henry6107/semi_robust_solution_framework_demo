END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// The base FB leaves Undefined immediately unless a derived FB delays startup.
H_OnUndefined := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
