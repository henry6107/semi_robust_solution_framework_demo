<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ConfiguredAlarmManager" Id="{e2237d1c-454a-422d-b95c-4d640d5109f4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ConfiguredAlarmManager
VAR_OUTPUT
	AckResponseId : UDINT;
	AckAccepted : BOOL;
	AckError : E_AlarmAckError;
	LatchedCount : UINT;
	Overflow : BOOL;
END_VAR
VAR
	_States : ARRAY[1..Param_Config.MaxConfiguredAlarmsPerModule] OF ST_ConfiguredAlarmState;
	_AckRequestOneShot : R_TRIG;
	_LastAckRequestId : UDINT;
	_Revision : UDINT;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Method Name="M_AppendToList" Id="{de801b98-a4c0-4291-a9b8-9c25b11c16ce}">
      <Declaration><![CDATA[METHOD PUBLIC M_AppendToList
VAR_INPUT
	ModuleId : UDINT;
END_VAR
VAR_IN_OUT CONSTANT
	RuntimeConfig : ST_ModuleRuntimeConfig;
END_VAR
VAR_IN_OUT
	AlarmList : ARRAY[1..Param_Config.MaxPublishedModuleAlarms] OF ST_ExtAlarm;
END_VAR
VAR
	nAlarm : UINT;
	nTarget : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[LatchedCount := 0;
Overflow := FALSE;

nTarget := 1;
WHILE (nTarget <= Param_Config.MaxPublishedModuleAlarms)
	AND (AlarmList[nTarget].MainErrorId <> 0) DO
	nTarget := nTarget + 1;
END_WHILE

FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
	IF NOT _States[nAlarm].Latched THEN
		CONTINUE;
	END_IF

	LatchedCount := LatchedCount + 1;
	IF nTarget > Param_Config.MaxPublishedModuleAlarms THEN
		Overflow := TRUE;
		CONTINUE;
	END_IF

	AlarmList[nTarget].ModuleId := ModuleId;
	AlarmList[nTarget].ServiceId := 0;
	AlarmList[nTarget].MainErrorId := RuntimeConfig.AlarmBindings[nAlarm].Definition.MainErrorId;
	AlarmList[nTarget].SourceErrorId := RuntimeConfig.AlarmBindings[nAlarm].Definition.SourceErrorId;
	AlarmList[nTarget].Message := RuntimeConfig.AlarmBindings[nAlarm].Definition.Message;
	AlarmList[nTarget].Path := RuntimeConfig.AlarmBindings[nAlarm].Definition.Source;
	AlarmList[nTarget].Severity := RuntimeConfig.AlarmBindings[nAlarm].Definition.Severity;
	AlarmList[nTarget].DateTime := _States[nAlarm].FirstOccurrenceDateTime;
	AlarmList[nTarget].Active := _States[nAlarm].Active;
	AlarmList[nTarget].Acknowledged := _States[nAlarm].Acknowledged;
	AlarmList[nTarget].OccurrenceCount := _States[nAlarm].OccurrenceCount;
	nTarget := nTarget + 1;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_BeginCycle" Id="{44cc520e-bf21-4505-807f-bd109155e5f6}">
      <Declaration><![CDATA[METHOD PUBLIC M_BeginCycle
VAR_INPUT
	Revision : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Revision <> _Revision THEN
	MEMSET(ADR(_States), 0, SIZEOF(_States));
	AckResponseId := 0;
	AckAccepted := FALSE;
	AckError := E_AlarmAckError.None;
	LatchedCount := 0;
	Overflow := FALSE;
	_LastAckRequestId := 0;
	_Revision := Revision;
END_IF

Overflow := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ProcessAcknowledgement" Id="{32662207-2a5e-4d37-ab68-57f16fa524a1}">
      <Declaration><![CDATA[METHOD PUBLIC M_ProcessAcknowledgement
VAR_IN_OUT CONSTANT
	Request : ST_AlarmAckRequest;
	RuntimeConfig : ST_ModuleRuntimeConfig;
END_VAR
VAR
	nAlarm : UINT;
	bFound : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AckRequestOneShot(CLK := Request.bChangeRequest);

// Keep the response visible until the upper controller releases the request.
IF NOT Request.bChangeRequest THEN
	AckAccepted := FALSE;
	AckError := E_AlarmAckError.None;
	RETURN;
END_IF

IF NOT _AckRequestOneShot.Q THEN
	RETURN;
END_IF

AckResponseId := Request.RequestId;
AckAccepted := FALSE;
AckError := E_AlarmAckError.None;

IF Request.RequestId = 0 THEN
	AckError := E_AlarmAckError.InvalidRequestId;
	RETURN;
END_IF
IF Request.RequestId = _LastAckRequestId THEN
	AckError := E_AlarmAckError.DuplicateRequest;
	RETURN;
END_IF
_LastAckRequestId := Request.RequestId;

CASE Request.Command OF
	E_AlarmAckCommand.AcknowledgeOne:
		IF Request.MainErrorId = 0 THEN
			AckError := E_AlarmAckError.AlarmNotFound;
			RETURN;
		END_IF
		FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
			IF _States[nAlarm].Latched
				AND (RuntimeConfig.AlarmBindings[nAlarm].Definition.MainErrorId = Request.MainErrorId) THEN
				_States[nAlarm].Acknowledged := TRUE;
				IF NOT _States[nAlarm].Active THEN
					MEMSET(ADR(_States[nAlarm]), 0, SIZEOF(_States[nAlarm]));
				END_IF
				bFound := TRUE;
				EXIT;
			END_IF
		END_FOR
		IF NOT bFound THEN
			AckError := E_AlarmAckError.AlarmNotFound;
			RETURN;
		END_IF

	E_AlarmAckCommand.AcknowledgeAll:
		FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
			IF _States[nAlarm].Latched THEN
				_States[nAlarm].Acknowledged := TRUE;
				IF NOT _States[nAlarm].Active THEN
					MEMSET(ADR(_States[nAlarm]), 0, SIZEOF(_States[nAlarm]));
				END_IF
			END_IF
		END_FOR

ELSE
	AckError := E_AlarmAckError.InvalidCommand;
	RETURN;
END_CASE

AckAccepted := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateAlarm" Id="{ae307373-bdee-4277-ba74-829c5d28c719}">
      <Declaration><![CDATA[METHOD PUBLIC M_UpdateAlarm
VAR_INPUT
	AlarmIndex : UINT;
	SampleValid : BOOL;
	ConditionMet : BOOL;
	UtcDateTime : STRING(20);
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF (AlarmIndex < 1)
	OR (AlarmIndex > Param_Config.MaxConfiguredAlarmsPerModule)
	OR NOT SampleValid THEN
	RETURN;
END_IF

IF ConditionMet THEN
	IF NOT _States[AlarmIndex].PreviousCondition THEN
		IF NOT _States[AlarmIndex].Latched THEN
			_States[AlarmIndex].Latched := TRUE;
			_States[AlarmIndex].OccurrenceCount := 1;
			_States[AlarmIndex].FirstOccurrenceDateTime := UtcDateTime;
		ELSE
			_States[AlarmIndex].OccurrenceCount := _States[AlarmIndex].OccurrenceCount + 1;
		END_IF
		_States[AlarmIndex].Acknowledged := FALSE;
	END_IF
	_States[AlarmIndex].Active := TRUE;
ELSE
	IF _States[AlarmIndex].PreviousCondition THEN
		_States[AlarmIndex].Active := FALSE;
		IF _States[AlarmIndex].Acknowledged THEN
			MEMSET(ADR(_States[AlarmIndex]), 0, SIZEOF(_States[AlarmIndex]));
		END_IF
	END_IF
END_IF

_States[AlarmIndex].PreviousCondition := ConditionMet;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
