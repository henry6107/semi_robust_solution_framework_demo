VAR_INPUT
	bFirstScan : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Busy;
IF _AllServicesStopped THEN
	H_OnClearing := E_PackMLHookResult.Done;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{1f951a38-751e-4488-9f76-b0388bffa732}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED FINAL H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Transfer to execute automatically
RequestCommand(E_PackMLCommand.Start);]]></ST>
      </Implementation>
    </Method>
