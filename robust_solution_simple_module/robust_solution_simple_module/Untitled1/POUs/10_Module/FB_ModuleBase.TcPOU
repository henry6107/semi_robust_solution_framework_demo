    <Method Name="M_AppendConfiguredAlarms" Id="{c8fa70cf-350e-4481-b23f-7b026067b9af}">
      <Declaration><![CDATA[METHOD PRIVATE M_AppendConfiguredAlarms
VAR
	nAlarm : UINT;
	nTarget : UINT;
	nSource : UINT;
	fValue : LREAL;
	bValid : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(RuntimeConfig) OR NOT RuntimeConfig.Valid OR NOT _ConfiguredSnapshot.Ready THEN
	RETURN;
END_IF

nTarget := 1;
WHILE (nTarget <= Param_Config.MaxModuleAlarm)
	AND (ModuleAlarmList[nTarget].MainErrorId <> 0) DO
	nTarget := nTarget + 1;
END_WHILE

FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
	IF nTarget > Param_Config.MaxModuleAlarm THEN
		RETURN;
	END_IF
	nSource := RuntimeConfig.VariableCount + nAlarm;
	fValue := _ConfiguredSnapshot.M_GetLReal(SourceIndex := nSource, Valid => bValid);
	IF bValid AND F_AlarmConditionMet(
		Value := fValue,
		Operator := RuntimeConfig.AlarmList[nAlarm].Operator,
		Threshold := RuntimeConfig.AlarmList[nAlarm].Threshold,
		Tolerance := RuntimeConfig.AlarmList[nAlarm].Tolerance) THEN
		ModuleAlarmList[nTarget].ModuleId := _ModuleId;
		ModuleAlarmList[nTarget].ServiceId := 0;
		ModuleAlarmList[nTarget].MainErrorId := RuntimeConfig.AlarmList[nAlarm].MainErrorId;
		ModuleAlarmList[nTarget].SourceErrorId := RuntimeConfig.AlarmList[nAlarm].SourceErrorId;
		ModuleAlarmList[nTarget].Message := RuntimeConfig.AlarmList[nAlarm].Message;
		ModuleAlarmList[nTarget].Path := RuntimeConfig.AlarmList[nAlarm].Source;
		ModuleAlarmList[nTarget].Severity := RuntimeConfig.AlarmList[nAlarm].Severity;
		ModuleAlarmList[nTarget].DateTime := _ServiceContext.UtcDateTime;
		nTarget := nTarget + 1;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckHeartbeat" Id="{95356be4-c779-4a0a-84d9-ca5fd7d93bc1}">
      <Declaration><![CDATA[METHOD PRIVATE M_CheckHeartbeat
VAR_INPUT
END_VAR

VAR
	bLooseHeartbeat : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Heartbeats check
bLooseHeartbeat := _LastHeartbeatIndex = HeartbeatIndex;
IF bLooseHeartbeat THEN
	_HeartbeatTimer( IN:= TRUE, PT:= Param_Config.ModuleHeartbeat_Timout);
ELSE
	_HeartbeatTimer( IN:= FALSE, PT:= Param_Config.ModuleHeartbeat_Timout);
END_IF

// Update Last Heartbeat Index
_LastHeartbeatIndex := HeartbeatIndex;

// Update Is ControlSource Alive status
_IsControlSourceAlive := NOT _HeartbeatTimer.Q;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateConfiguredVariableList" Id="{6e5b225f-a33a-409e-827d-1330e9e22088}">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateConfiguredVariableList
VAR
	nVariable : UINT;
	bValid : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(RuntimeConfig) OR NOT RuntimeConfig.Valid THEN
	RETURN;
END_IF

MEMSET(ADR(ModuleVariableList), 0, SIZEOF(ModuleVariableList));
FOR nVariable := 1 TO RuntimeConfig.VariableCount DO
	ModuleVariableList[nVariable].Id := RuntimeConfig.VariableList[nVariable].Id;
	ModuleVariableList[nVariable].Name := RuntimeConfig.VariableList[nVariable].Name;
	ModuleVariableList[nVariable].DataType := F_ConfigDataTypeToDescriptor(DataType := RuntimeConfig.VariableList[nVariable].DataType);
	ModuleVariableList[nVariable].Unit := RuntimeConfig.VariableList[nVariable].Unit;
	ModuleVariableList[nVariable].Value := _ConfiguredSnapshot.M_GetValueString(
		SourceIndex := nVariable,
		Valid => bValid);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateModule" Id="{a3ee927e-c27b-49bf-8f5e-1ddb1a222fc5}">
      <Declaration><![CDATA[METHOD PROTECTED FINAL M_UpdateModule
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_CheckHeartbeat();

PackMLIn := ModuleCtrl.PackMLIn;
SUPER^();

IF __ISVALIDREF(RuntimeConfig) THEN
	_ModuleId := RuntimeConfig.ModuleId;
	_ConfiguredSnapshot(RuntimeConfig := RuntimeConfig);
	ModuleStatus.ModuleId := _ModuleId;
	ModuleStatus.Enabled := RuntimeConfig.Enabled;
	ModuleStatus.ConfigurationReady := _ConfiguredSnapshot.Ready;
	ModuleStatus.ConfigurationError := _ConfiguredSnapshot.Error;
	ModuleStatus.ConfigurationErrorId := _ConfiguredSnapshot.ErrorId;
END_IF

_ServiceContext.ModuleId := _ModuleId;
_ServiceContext.UtcDateTime := SystemContext.UtcDateTime;

H_UpdateServiceParam();
H_SelectServiceControlSource();
H_UpdateService();
H_UpdateBaseUnit();

_CmdRequestOneShot(CLK:= PackMLIn.bCommandChangeRequest, Q=> );
_ModeRequestOneShot(CLK:= PackMLIn.bModeChangeRequest, Q=> );

// Updata status
IF _CmdRequestOneShot.Q OR _ModeRequestOneShot.Q THEN
	ModuleStatus.ResponseId := ModuleCtrl.RequestId;
END_IF
ModuleStatus.PackMLOut := PackMLOut;

H_UpdateAlarmList();
M_AppendConfiguredAlarms();
H_UpdateServiceDataList();
M_UpdateConfiguredVariableList();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>