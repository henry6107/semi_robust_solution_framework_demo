    <Method Name="M_AppendConfiguredAlarms" Id="{c8fa70cf-350e-4481-b23f-7b026067b9af}">
      <Declaration><![CDATA[METHOD PRIVATE M_AppendConfiguredAlarms
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid THEN
		_ConfiguredAlarmManager.M_AppendToList(
			ModuleId := _ModuleId,
			RuntimeConfig := RuntimeConfig,
			AlarmList := ModuleAlarmList);
	END_IF
END_IF

ModuleStatus.Alarm.AckResponseId := _ConfiguredAlarmManager.AckResponseId;
ModuleStatus.Alarm.AckAccepted := _ConfiguredAlarmManager.AckAccepted;
ModuleStatus.Alarm.AckError := _ConfiguredAlarmManager.AckError;
ModuleStatus.Alarm.ConfiguredLatchedCount := _ConfiguredAlarmManager.LatchedCount;
ModuleStatus.Alarm.Overflow := _ConfiguredAlarmManager.Overflow;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateConfiguredAlarmState" Id="{6b9b6538-c160-4a7b-93a1-a430b340815a}">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateConfiguredAlarmState
VAR
	nAlarm : UINT;
	nSource : UINT;
	nRevision : UDINT;
	fValue : LREAL;
	bValid : BOOL;
	bConditionMet : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nRevision := 0;
IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid THEN
		nRevision := RuntimeConfig.Revision;
	END_IF
END_IF
_ConfiguredAlarmManager.M_BeginCycle(Revision := nRevision);

IF NOT __ISVALIDREF(RuntimeConfig) THEN
	RETURN;
END_IF
IF NOT RuntimeConfig.Valid THEN
	RETURN;
END_IF

// Process acknowledgements before evaluating this cycle so AckAll cannot consume
// a new event that the upper controller has not observed yet.
_ConfiguredAlarmManager.M_ProcessAcknowledgement(
	Request := ModuleCtrl.AlarmAckRequest,
	RuntimeConfig := RuntimeConfig);

IF NOT _ConfiguredSnapshot.Ready THEN
	RETURN;
END_IF

FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
	nSource := RuntimeConfig.VariableCount + nAlarm;
	fValue := _ConfiguredSnapshot.M_GetLReal(SourceIndex := nSource, Valid => bValid);
	bConditionMet := FALSE;
	IF bValid THEN
		bConditionMet := F_AlarmConditionMet(
			Value := fValue,
			Operator := RuntimeConfig.AlarmBindings[nAlarm].Definition.Operator,
			Threshold := RuntimeConfig.AlarmBindings[nAlarm].Definition.Threshold,
			Tolerance := RuntimeConfig.AlarmBindings[nAlarm].Definition.Tolerance);
	END_IF
	_ConfiguredAlarmManager.M_UpdateAlarm(
		AlarmIndex := nAlarm,
		SampleValid := bValid,
		ConditionMet := bConditionMet,
		UtcDateTime := _ServiceContext.UtcDateTime);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckHeartbeat" Id="{95356be4-c779-4a0a-84d9-ca5fd7d93bc1}">
      <Declaration><![CDATA[METHOD PRIVATE M_CheckHeartbeat
VAR_INPUT
END_VAR

VAR
	bLooseHeartbeat : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Heartbeats check
bLooseHeartbeat := _LastHeartbeatIndex = HeartbeatIndex;
IF bLooseHeartbeat THEN
	_HeartbeatTimer( IN:= TRUE, PT:= Param_Config.ModuleHeartbeat_Timout);
ELSE
	_HeartbeatTimer( IN:= FALSE, PT:= Param_Config.ModuleHeartbeat_Timout);
END_IF

// Update Last Heartbeat Index
_LastHeartbeatIndex := HeartbeatIndex;

// Update Is ControlSource Alive status
_IsControlSourceAlive := NOT _HeartbeatTimer.Q;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateConfiguredVariableList" Id="{6e5b225f-a33a-409e-827d-1330e9e22088}">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateConfiguredVariableList
VAR
	nVariable : UINT;
	bValid : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(RuntimeConfig) OR NOT RuntimeConfig.Valid THEN
	RETURN;
END_IF

MEMSET(ADR(ModuleVariableList), 0, SIZEOF(ModuleVariableList));
FOR nVariable := 1 TO RuntimeConfig.VariableCount DO
	ModuleVariableList[nVariable].Id := RuntimeConfig.VariableBindings[nVariable].Definition.Id;
	ModuleVariableList[nVariable].Name := RuntimeConfig.VariableBindings[nVariable].Definition.Name;
	ModuleVariableList[nVariable].DataType := F_ConfigDataTypeToDescriptor(
		DataType := RuntimeConfig.VariableBindings[nVariable].Definition.DataType);
	ModuleVariableList[nVariable].Unit := RuntimeConfig.VariableBindings[nVariable].Definition.Unit;
	ModuleVariableList[nVariable].Value := _ConfiguredSnapshot.M_GetValueString(
		SourceIndex := nVariable,
		Valid => bValid);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateModule" Id="{a3ee927e-c27b-49bf-8f5e-1ddb1a222fc5}">
      <Declaration><![CDATA[METHOD PROTECTED FINAL M_UpdateModule
VAR_INPUT
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_CheckHeartbeat();

PackMLIn := ModuleCtrl.PackMLIn;
SUPER^();

IF __ISVALIDREF(RuntimeConfig) THEN
	_ModuleId := RuntimeConfig.ModuleId;
	_ConfiguredSnapshot(
		RuntimeConfig := RuntimeConfig,
		VariableNodeReader := VariableNodeReader);
	ModuleStatus.ModuleId := _ModuleId;
	ModuleStatus.Enabled := RuntimeConfig.Enabled;
	ModuleStatus.Configuration.Ready := _ConfiguredSnapshot.Ready;
	ModuleStatus.Configuration.Error := _ConfiguredSnapshot.Error;
	ModuleStatus.Configuration.ErrorId := _ConfiguredSnapshot.ErrorId;
END_IF

_ServiceContext.ModuleId := _ModuleId;
_ServiceContext.UtcDateTime := SystemContext.UtcDateTime;

H_UpdateServiceParam();
H_SelectServiceControlSource();
H_UpdateService();
H_UpdateBaseUnit();

_CmdRequestOneShot(CLK:= PackMLIn.bCommandChangeRequest, Q=> );
_ModeRequestOneShot(CLK:= PackMLIn.bModeChangeRequest, Q=> );

// Updata status
IF _CmdRequestOneShot.Q OR _ModeRequestOneShot.Q THEN
	ModuleStatus.ResponseId := ModuleCtrl.RequestId;
END_IF
ModuleStatus.PackMLOut := PackMLOut;

M_UpdateConfiguredAlarmState();
H_UpdateAlarmList();
M_AppendConfiguredAlarms();
H_UpdateServiceDataList();
M_UpdateConfiguredVariableList();]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
