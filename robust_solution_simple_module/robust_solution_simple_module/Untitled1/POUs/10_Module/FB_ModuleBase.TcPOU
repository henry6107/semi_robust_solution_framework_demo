    <Method Name="H_UpdateVariable" Id="{9d15debf-7709-4c12-8971-2dc378590faa}" FolderPath="HookMethod\">
      <Declaration><![CDATA[METHOD PROTECTED H_UpdateVariable
]]></Declaration>
