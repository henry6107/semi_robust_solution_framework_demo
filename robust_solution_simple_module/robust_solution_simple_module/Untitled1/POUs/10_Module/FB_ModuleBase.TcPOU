<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ModuleBase" Id="{6193009a-0dba-45cf-9862-8c04373cb73b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ModuleBase EXTENDS FB_PackMLModeSet
VAR_INPUT
	ModuleCtrl : REFERENCE TO ST_ModuleCtrl;
	SystemContext : REFERENCE TO ST_SystemContext;
	HeartbeatIndex : UDINT;
	RuntimeConfig : REFERENCE TO ST_ModuleRuntimeConfig;
	VariableNodeReader : I_VariableNodeReader;
END_VAR

VAR_OUTPUT
	ModuleStatus : ST_ModuleStatus;
	ModuleVariableList : ARRAY[1..Param_Config.MaxModuleVariable] OF ST_ExtDescriptor;
	ModuleAlarmList : ARRAY[1..Param_Config.MaxPublishedModuleAlarms] OF ST_ExtAlarm;
	ModuleDataList : ARRAY[1..Param_Config.MaxModuleData] OF ST_ExtDescriptor;
END_VAR

VAR
	_CmdRequestOneShot : R_TRIG;
	_ModeRequestOneShot : R_TRIG;
	
	_ModuleId : UDINT;
	_ServiceContext : ST_ServiceContext;
	
	_HeartbeatTimer : TON;
	_LastHeartbeatIndex : UDINT;
	_IsControlSourceAlive : BOOL;
	_ConfiguredSnapshot : FB_ConfigValueSnapshotReader;
	_AlarmManager : FB_ModuleAlarmManager;
	_InAlarmHook : BOOL;
	_InVariableHook : BOOL;
	_ConfiguredVariableCount : UINT;
	_AllServicesAborted : BOOL;
	_AllServicesStopped : BOOL;
	_AllServicesIdle : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="HookMethod" Id="{0b542957-3892-4df2-b0e7-9c93700d86b5}" />
    <Folder Name="Private" Id="{9fe464c1-8082-49c4-bb39-67807fabb98d}" />
