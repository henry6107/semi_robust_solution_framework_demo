    <Method Name="H_OnAborting" Id="{8915d7ec-4b86-49c6-9413-c27372315251}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED FINAL H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;
IF _AllServicesAborted THEN
	H_OnAborting := E_PackMLHookResult.Done;
END_IF]]></ST>
      </Implementation>
    </Method>
