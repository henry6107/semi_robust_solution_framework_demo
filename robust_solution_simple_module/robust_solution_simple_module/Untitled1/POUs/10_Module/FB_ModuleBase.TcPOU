    <Method Name="M_AddAlarm" Id="{7c4e4f34-fc5f-482d-9a72-920e07d0a35d}">
      <Declaration><![CDATA[METHOD PROTECTED FINAL M_AddAlarm : BOOL
VAR_INPUT
	MainErrorId : UDINT;
	SourceErrorId : UDINT;
	Message : STRING;
	Path : STRING(255);
	Severity : E_Severity;
END_VAR
VAR
	nIndex : UINT;
	Alarm : ST_ExtAlarm;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_AddAlarm := FALSE;
IF NOT _InAlarmHook OR (MainErrorId = 0) THEN
	RETURN;
END_IF
IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid THEN
		FOR nIndex := 1 TO RuntimeConfig.AlarmCount DO
			IF RuntimeConfig.AlarmBindings[nIndex].Definition.MainErrorId = MainErrorId THEN
				M_AddAlarm := TRUE; // JSON owns the complete definition, even without a valid sample.
				RETURN;
			END_IF
		END_FOR
	END_IF
END_IF
MEMSET(ADR(Alarm), 0, SIZEOF(Alarm));
Alarm.MainErrorId := MainErrorId;
Alarm.SourceErrorId := SourceErrorId;
Alarm.Message := Message;
Alarm.Path := Path;
Alarm.Severity := Severity;
Alarm.DateTime := _ServiceContext.UtcDateTime;
M_AddAlarm := _AlarmManager.M_ObserveHookAlarm(Alarm := Alarm);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_AddVariable" Id="{669b3f9b-b87a-4c72-b049-e0b92818a4d4}">
      <Declaration><![CDATA[METHOD PROTECTED FINAL M_AddVariable : BOOL
VAR_INPUT
	Id : UDINT;
	Name : STRING(30);
	DataType : E_DescriptorType;
	Unit : STRING(10);
	Value : STRING(80);
END_VAR
VAR
	nIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_AddVariable := FALSE;
IF NOT _InVariableHook OR (Id = 0) THEN
	RETURN;
END_IF
FOR nIndex := 1 TO ModuleStatus.Variable.PublishedCount DO
	IF ModuleVariableList[nIndex].Id = Id THEN
		IF nIndex <= _ConfiguredVariableCount THEN
			M_AddVariable := TRUE; // JSON ownership is not a duplicate submission.
		ELSIF ModuleStatus.Variable.DuplicateId = 0 THEN
			ModuleStatus.Variable.DuplicateId := Id;
		END_IF
		RETURN;
	END_IF
END_FOR
IF ModuleStatus.Variable.PublishedCount >= Param_Config.MaxModuleVariable THEN
	ModuleStatus.Variable.Overflow := TRUE;
	RETURN;
END_IF
ModuleStatus.Variable.PublishedCount := ModuleStatus.Variable.PublishedCount + 1;
nIndex := ModuleStatus.Variable.PublishedCount;
ModuleVariableList[nIndex].Id := Id;
ModuleVariableList[nIndex].Name := Name;
ModuleVariableList[nIndex].DataType := DataType;
ModuleVariableList[nIndex].Unit := Unit;
ModuleVariableList[nIndex].Value := Value;
M_AddVariable := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_CheckHeartbeat" Id="{95356be4-c779-4a0a-84d9-ca5fd7d93bc1}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_CheckHeartbeat
VAR_INPUT
END_VAR

VAR
	bLooseHeartbeat : BOOL;
	HeartbeatTimeout : TIME;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[HeartbeatTimeout := SystemContext.ModuleHeartbeatTimeout;
IF HeartbeatTimeout <= T#0S THEN
	HeartbeatTimeout := Param_Config.ModuleHeartbeat_Timeout;
END_IF

// Heartbeats check
bLooseHeartbeat := _LastHeartbeatIndex = HeartbeatIndex;
IF bLooseHeartbeat THEN
	_HeartbeatTimer(IN := TRUE, PT := HeartbeatTimeout);
ELSE
	_HeartbeatTimer(IN := FALSE, PT := HeartbeatTimeout);
END_IF

// Update Last Heartbeat Index
_LastHeartbeatIndex := HeartbeatIndex;

// Update Is ControlSource Alive status
_IsControlSourceAlive := NOT _HeartbeatTimer.Q;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_PublishAlarmState" Id="{055c5419-f6a5-46d2-bb31-19f68a24d121}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_PublishAlarmState
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AlarmManager.M_Publish(AlarmList := ModuleAlarmList);
ModuleStatus.Alarm.AckResponseId := _AlarmManager.AckResponseId;
ModuleStatus.Alarm.AckAccepted := _AlarmManager.AckAccepted;
ModuleStatus.Alarm.AckError := _AlarmManager.AckError;
ModuleStatus.Alarm.ConfiguredLatchedCount := _AlarmManager.ConfiguredLatchedCount;
ModuleStatus.Alarm.Overflow := _AlarmManager.Overflow;
ModuleStatus.Alarm.ServiceLatchedCount := _AlarmManager.ServiceLatchedCount;
ModuleStatus.Alarm.HookLatchedCount := _AlarmManager.HookLatchedCount;
ModuleStatus.Alarm.DuplicateId := _AlarmManager.DuplicateId;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_SelectServiceControlSource" Id="{d665ea40-9568-4646-8c96-ecfd2fd02a57}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_SelectServiceControlSource
VAR_IN_OUT
	ServiceControls : ARRAY[*] OF ST_ServiceCtrl;
END_VAR
VAR
	nServiceIndex : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Allow external call for services only when module is in Execute state
IF PackMLOut.eStateCurrent = E_PackMLState.Execute THEN
	RETURN;
END_IF

FOR nServiceIndex := LOWER_BOUND(ServiceControls, 1) TO UPPER_BOUND(ServiceControls, 1) DO
	ServiceControls[nServiceIndex].PackMLIn := ModuleCtrl.PackMLIn;
	ServiceControls[nServiceIndex].RequestId := ModuleCtrl.RequestId;
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateAlarmState" Id="{6b9b6538-c160-4a7b-93a1-a430b340815a}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateAlarmState
VAR_IN_OUT CONSTANT
	ServiceStatuses : ARRAY[*] OF ST_ServiceStatus;
END_VAR
VAR
	nAlarm : UINT;
	nSource : UINT;
	nRevision : UDINT;
	fValue : LREAL;
	bValid : BOOL;
	bConditionMet : BOOL;
	Alarm : ST_ExtAlarm;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[nRevision := 0;
IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid THEN
		nRevision := RuntimeConfig.Revision;
	END_IF
END_IF
_AlarmManager.M_BeginCycle(
	ModuleId := _ModuleId,
	ConfigurationRevision := nRevision);

// Remove identities now owned by JSON before an acknowledgement can find a stale Hook event.
IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid THEN
		FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
			_AlarmManager.M_SuppressHookAlarm(
				MainErrorId := RuntimeConfig.AlarmBindings[nAlarm].Definition.MainErrorId);
		END_FOR
	END_IF
END_IF

// Process acknowledgements before evaluating this cycle so AckAll cannot consume
// a new event that the upper controller has not observed yet.
_AlarmManager.M_ProcessAcknowledgement(Request := ModuleCtrl.AlarmAckRequest);

IF __ISVALIDREF(RuntimeConfig) THEN
	IF RuntimeConfig.Valid AND _ConfiguredSnapshot.Ready THEN
		FOR nAlarm := 1 TO RuntimeConfig.AlarmCount DO
			nSource := RuntimeConfig.VariableCount + nAlarm;
			fValue := _ConfiguredSnapshot.M_GetLReal(SourceIndex := nSource, Valid => bValid);
			bConditionMet := FALSE;
			IF bValid THEN
				bConditionMet := F_AlarmConditionMet(
					Value := fValue,
					Operator := RuntimeConfig.AlarmBindings[nAlarm].Definition.Operator,
					Threshold := RuntimeConfig.AlarmBindings[nAlarm].Definition.Threshold,
					Tolerance := RuntimeConfig.AlarmBindings[nAlarm].Definition.Tolerance);
			END_IF

			MEMSET(ADR(Alarm), 0, SIZEOF(Alarm));
			Alarm.ModuleId := _ModuleId;
			Alarm.ServiceId := 0;
			Alarm.MainErrorId := RuntimeConfig.AlarmBindings[nAlarm].Definition.MainErrorId;
			Alarm.SourceErrorId := RuntimeConfig.AlarmBindings[nAlarm].Definition.SourceErrorId;
			Alarm.Message := RuntimeConfig.AlarmBindings[nAlarm].Definition.Message;
			Alarm.Path := RuntimeConfig.AlarmBindings[nAlarm].Definition.Source;
			Alarm.Severity := RuntimeConfig.AlarmBindings[nAlarm].Definition.Severity;
			_AlarmManager.M_UpdateConfiguredAlarm(
				AlarmIndex := nAlarm,
				SampleValid := bValid,
				ConditionMet := bConditionMet,
				Alarm := Alarm,
				UtcDateTime := _ServiceContext.UtcDateTime);
		END_FOR
	END_IF
END_IF

_InAlarmHook := TRUE;
H_UpdateAlarm();
_InAlarmHook := FALSE;

M_UpdateServiceAlarms(ServiceStatuses := ServiceStatuses);
_AlarmManager.M_EndCycle();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateConfiguredVariableList" Id="{6e5b225f-a33a-409e-827d-1330e9e22088}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateConfiguredVariableList
VAR
	nVariable : UINT;
	bValid : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT __ISVALIDREF(RuntimeConfig) THEN
	RETURN;
END_IF
IF NOT RuntimeConfig.Valid THEN
	RETURN;
END_IF

FOR nVariable := 1 TO RuntimeConfig.VariableCount DO
	ModuleVariableList[nVariable].Id := RuntimeConfig.VariableBindings[nVariable].Definition.Id;
	ModuleVariableList[nVariable].Name := RuntimeConfig.VariableBindings[nVariable].Definition.Name;
	ModuleVariableList[nVariable].DataType := F_ConfigDataTypeToDescriptor(
		DataType := RuntimeConfig.VariableBindings[nVariable].Definition.DataType);
	ModuleVariableList[nVariable].Unit := RuntimeConfig.VariableBindings[nVariable].Definition.Unit;
	ModuleVariableList[nVariable].Value := _ConfiguredSnapshot.M_GetValueString(
		SourceIndex := nVariable,
		Valid => bValid);
END_FOR
_ConfiguredVariableCount := RuntimeConfig.VariableCount;
ModuleStatus.Variable.PublishedCount := _ConfiguredVariableCount;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateModule" Id="{a3ee927e-c27b-49bf-8f5e-1ddb1a222fc5}">
      <Declaration><![CDATA[METHOD PROTECTED FINAL M_UpdateModule
VAR_IN_OUT
	ServiceControls : ARRAY[*] OF ST_ServiceCtrl;
	ServiceStatuses : ARRAY[*] OF ST_ServiceStatus;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_CheckHeartbeat();
ModuleStatus.IsControlSourceAlive := _IsControlSourceAlive;

// Update module state machine
PackMLIn := ModuleCtrl.PackMLIn;
M_UpdateServiceStateSummary(ServiceStatuses := ServiceStatuses);
SUPER^();

IF __ISVALIDREF(RuntimeConfig) THEN
	_ModuleId := RuntimeConfig.ModuleId;
	_ConfiguredSnapshot(
		RuntimeConfig := RuntimeConfig,
		VariableNodeReader := VariableNodeReader);
	ModuleStatus.ModuleId := _ModuleId;
	ModuleStatus.Enabled := RuntimeConfig.Enabled;
	ModuleStatus.ModuleType := RuntimeConfig.ModuleType;
END_IF

_ServiceContext.ModuleId := _ModuleId;
_ServiceContext.UtcDateTime := SystemContext.UtcDateTime;

// Update service state machine
M_SelectServiceControlSource(ServiceControls := ServiceControls);
H_UpdateService();

// Update base unit state machine
H_UpdateBaseUnit();

_CmdRequestOneShot(CLK:= PackMLIn.bCommandChangeRequest, Q=> );
_ModeRequestOneShot(CLK:= PackMLIn.bModeChangeRequest, Q=> );

// Updata status
IF _CmdRequestOneShot.Q OR _ModeRequestOneShot.Q THEN
	ModuleStatus.ResponseId := ModuleCtrl.RequestId;
END_IF
ModuleStatus.PackMLOut := PackMLOut;

M_UpdateAlarmState(ServiceStatuses := ServiceStatuses);
M_PublishAlarmState();
M_UpdateServiceDataList(ServiceStatuses := ServiceStatuses);
M_UpdateVariableList();]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateServiceAlarms" Id="{aac9cb3d-dfbb-4fd3-8423-c48f0de4cb6b}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateServiceAlarms
VAR_IN_OUT CONSTANT
	ServiceStatuses : ARRAY[*] OF ST_ServiceStatus;
END_VAR
VAR
	nServiceIndex : DINT;
	nErrorIndex : UINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Submit currently observable Service errors. The manager owns lifecycle state
// and marks identities not observed in this scan inactive during M_EndCycle.
FOR nServiceIndex := LOWER_BOUND(ServiceStatuses, 1) TO UPPER_BOUND(ServiceStatuses, 1) DO
	FOR nErrorIndex := 1 TO Param_Config.MaxServiceError DO
		IF ServiceStatuses[nServiceIndex].ErrorList[nErrorIndex].MainErrorId <> 0 THEN
			_AlarmManager.M_ObserveServiceAlarm(
				Alarm := ServiceStatuses[nServiceIndex].ErrorList[nErrorIndex]);
		END_IF
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateServiceDataList" Id="{09acfa8b-205a-4e4b-9f04-1c13883b2574}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateServiceDataList
VAR_IN_OUT CONSTANT
	ServiceStatuses : ARRAY[*] OF ST_ServiceStatus;
END_VAR
VAR
	nServiceIndex : DINT;
	nDataIndex : UINT;
	nPublishedIndex : UINT;
	bDuplicate : BOOL;
	DataId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(ModuleDataList), 0, SIZEOF(ModuleDataList));
MEMSET(ADR(ModuleStatus.Data), 0, SIZEOF(ModuleStatus.Data));

FOR nServiceIndex := LOWER_BOUND(ServiceStatuses, 1) TO UPPER_BOUND(ServiceStatuses, 1) DO
	IF ServiceStatuses[nServiceIndex].Data.Overflow THEN
		ModuleStatus.Data.Overflow := TRUE;
	END_IF

	FOR nDataIndex := 1 TO Param_Config.MaxServiceData DO
		DataId := ServiceStatuses[nServiceIndex].Data.DataList[nDataIndex].Id;
		IF DataId = 0 THEN
			CONTINUE;
		END_IF

		bDuplicate := FALSE;
		FOR nPublishedIndex := 1 TO ModuleStatus.Data.PublishedCount DO
			IF ModuleDataList[nPublishedIndex].Id = DataId THEN
				bDuplicate := TRUE;
				EXIT;
			END_IF
		END_FOR

		IF bDuplicate THEN
			IF ModuleStatus.Data.DuplicateId = 0 THEN
				ModuleStatus.Data.DuplicateId := DataId;
			END_IF
			CONTINUE;
		END_IF

		IF ModuleStatus.Data.PublishedCount >= Param_Config.MaxModuleData THEN
			ModuleStatus.Data.Overflow := TRUE;
			CONTINUE;
		END_IF

		ModuleStatus.Data.PublishedCount := ModuleStatus.Data.PublishedCount + 1;
		ModuleDataList[ModuleStatus.Data.PublishedCount] :=
			ServiceStatuses[nServiceIndex].Data.DataList[nDataIndex];
	END_FOR
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateServiceStateSummary" Id="{22873c07-68e2-4865-b1ef-dfab07050fcb}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateServiceStateSummary
VAR_IN_OUT CONSTANT
	ServiceStatuses : ARRAY[*] OF ST_ServiceStatus;
END_VAR
VAR
	nServiceIndex : DINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[_AllServicesAborted := TRUE;
_AllServicesStopped := TRUE;
_AllServicesIdle := TRUE;

FOR nServiceIndex := LOWER_BOUND(ServiceStatuses, 1) TO UPPER_BOUND(ServiceStatuses, 1) DO
	_AllServicesAborted := _AllServicesAborted
		AND (ServiceStatuses[nServiceIndex].PackMLOut.eStateCurrent = E_PackMLState.Aborted);
	_AllServicesStopped := _AllServicesStopped
		AND (ServiceStatuses[nServiceIndex].PackMLOut.eStateCurrent = E_PackMLState.Stopped);
	_AllServicesIdle := _AllServicesIdle
		AND (ServiceStatuses[nServiceIndex].PackMLOut.eStateCurrent = E_PackMLState.Idle);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_UpdateVariableList" Id="{ae656439-fc0d-4872-8331-77be22b77a2c}" FolderPath="Private\">
      <Declaration><![CDATA[METHOD PRIVATE M_UpdateVariableList
]]></Declaration>
      <Implementation>
        <ST><![CDATA[MEMSET(ADR(ModuleVariableList), 0, SIZEOF(ModuleVariableList));
MEMSET(ADR(ModuleStatus.Variable), 0, SIZEOF(ModuleStatus.Variable));
_ConfiguredVariableCount := 0;
M_UpdateConfiguredVariableList();
_InVariableHook := TRUE;
H_UpdateVariable();
_InVariableHook := FALSE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>
