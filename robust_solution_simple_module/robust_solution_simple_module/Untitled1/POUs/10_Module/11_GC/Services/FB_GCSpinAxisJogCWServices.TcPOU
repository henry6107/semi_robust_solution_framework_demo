<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisJogCWServices" Id="{a61ac5cd-09b6-4f2d-bc54-d014db7401a2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisJogCWServices EXTENDS FB_PackMLModeSet
VAR_INPUT
	Param : ST_GCSpinAxisJogParam;
	Ctrl : REFERENCE TO ST_ServiceCtrl;
	Axis_BaseUnit : I_Axis_BaseUnit;

	// The Module assigns a unique ID to this Service instance.
	ResourceOwnerId : T_ResourceOwnerId;
END_VAR

VAR_OUTPUT
	Status : ST_ServiceStatus;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[PackMLIn := Ctrl.PackMLIn;
SUPER^();

// Updata status
IF PackMLIn.bCommandChangeRequest THEN // Acknowledge to upper controller that command received
	Status.ResponseId := Ctrl.RequestId;
ELSE
	Status.ResponseId := 0;
END_IF
Status.State := PackMLOut.eStateCurrent;
Status.CtrlErrorId := PackMLOut.eStateErrorID;
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{30486db3-fa54-4a70-b426-5f8ba9d0504f}" />
    <Method Name="H_OnAborted" Id="{b48428e2-059a-4878-a27b-576d41f2ba26}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively in case an unexpected transition skipped cleanup.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{df4c7f2d-8a88-4d35-a321-0716e918b536}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Done;

// A Service that never acquired the Resource must not affect its Owner.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	RETURN;
END_IF

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= E_JogMode.MC_JOGMODE_CONTINOUS,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);

// Jog has no asynchronous abort phase once both direction commands are false.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{9a60118e-19f9-4bca-893b-e890bf0b19c9}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{fd680a59-d09e-4091-ac1f-b02ebd6a48e6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Completing normally releases first; this is an idempotent safety net.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{61491643-adf6-4106-831a-f4dfe9e14738}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= FALSE, 
	JogBackwards:= FALSE, 
	Mode:= E_JogMode.MC_JOGMODE_CONTINOUS,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);

// Release only after the active Jog request has been withdrawn.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{2dba6e2e-7918-46c6-a0b6-50da9e5cf338}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

Axis_BaseUnit.M_Jog(
	OwnerId:= ResourceOwnerId,
	JogForward:= TRUE,
	JogBackwards:= FALSE,
	Mode:= E_JogMode.MC_JOGMODE_CONTINOUS,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration,
	Done=> , Error=> bError);


IF bError THEN
		Status.Error := TRUE;
		Status.ServiceErrorId := E_GCServiceErrorCode.Axis_Command_Error_During_Execute;
		
		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{fc1df435-3bb5-4a7c-8ab6-c741096bcbf0}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHeld
VAR_INPUT
