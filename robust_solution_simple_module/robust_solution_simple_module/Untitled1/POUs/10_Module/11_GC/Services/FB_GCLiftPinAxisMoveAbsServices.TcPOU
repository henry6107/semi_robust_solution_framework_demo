<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCLiftPinAxisMoveAbsServices" Id="{a1ab0001-6b2c-4d3e-8f90-a1ab00000001}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCLiftPinAxisMoveAbsServices EXTENDS FB_PackMLModeSet
VAR_INPUT
	Param : ST_GCLiftPinAxisMoveAbsParam;
	Axis_BaseUnit : I_Axis_BaseUnit;

	// The Module assigns a unique ID to this Service instance.
	ResourceOwnerId : T_ResourceOwnerId;
END_VAR

VAR_OUTPUT
	Status : ST_ServiceStatusBase;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[SUPER^();

// Update data
Status.Ack := PackMLIn.bCommandChangeRequest;	// Acknowledge to upper controller that command received
Status.State := PackMLOut.eStateCurrent;
Status.CtrlErrorId := PackMLOut.eStateErrorID;
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{a1ab0002-6b2c-4d3e-8f90-a1ab00000002}" />
    <Method Name="H_OnAborted" Id="{a1ab0003-6b2c-4d3e-8f90-a1ab00000003}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively in case an unexpected transition skipped cleanup.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{a1ab0004-6b2c-4d3e-8f90-a1ab00000004}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// A Service that never acquired the Resource must not reset its Owner's Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	H_OnAborting := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveAbsolute before resetting the Axis.
Axis_BaseUnit.M_MoveAbs(
	OwnerId := ResourceOwnerId,
	Execute := FALSE,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);

Axis_BaseUnit.M_Reset(
	OwnerId := ResourceOwnerId,
	Execute := TRUE,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Reset(
		OwnerId := ResourceOwnerId,
		Execute := FALSE);
	// Keep ownership until the asynchronous Reset has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnAborting := E_PackMLHookResult.Done;

ELSIF bError THEN
	// A failed Reset is terminal for this Abort sequence; do not remain in Aborting.
	Axis_BaseUnit.M_Reset(
		OwnerId := ResourceOwnerId,
		Execute := FALSE);
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Error_While_Reset_Axis;
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnAborting := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{a1ab0005-6b2c-4d3e-8f90-a1ab00000005}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{a1ab0006-6b2c-4d3e-8f90-a1ab00000006}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Completing normally releases first; this is an idempotent safety net.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{a1ab0007-6b2c-4d3e-8f90-a1ab00000007}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

Axis_BaseUnit.M_MoveAbs(
	OwnerId:= ResourceOwnerId,
	Execute:= FALSE,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);

// Release only after the active MoveAbsolute request has been withdrawn.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{a1ab0008-6b2c-4d3e-8f90-a1ab00000008}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

Axis_BaseUnit.M_MoveAbs(
	OwnerId:= ResourceOwnerId,
	Execute:= TRUE,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration,
	Done=> bDone, Error=> bError);


IF bDone THEN
	Status.Busy := FALSE;
	Status.Done := TRUE;
	H_OnExecute := E_PackMLHookResult.Done;
	RETURN;
END_IF

IF bError THEN
		Status.Error := TRUE;
		Status.ServiceErrorId := E_GCServiceErrorCode.Axis_Command_Error_During_Execute;

		RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{a1ab0009-6b2c-4d3e-8f90-a1ab00000009}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHeld
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHolding" Id="{a1ab000a-6b2c-4d3e-8f90-a1ab0000000a}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHolding : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default transient hooks complete immediately; override when work is required.
H_OnHolding := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{a1ab000b-6b2c-4d3e-8f90-a1ab0000000b}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Idle Services must not retain a Resource from an earlier operation.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{a1ab000c-6b2c-4d3e-8f90-a1ab0000000c}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{a1ab000d-6b2c-4d3e-8f90-a1ab0000000d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

// Validate Service-owned data before reserving the shared BaseUnit.
IF Param.Velocity <= 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCServiceErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

IF Param.Acceleration < 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCServiceErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

IF Param.Deceleration < 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCServiceErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Resource contention is a failed Start, not a wait condition.
IF NOT Axis_BaseUnit.M_AcquireResource(OwnerId := ResourceOwnerId) THEN
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Resource_Acquire_Failed_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Physical checks occur only after this Service owns the BaseUnit.
IF Axis_BaseUnit.AxisIsDisabled THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCServiceErrorCode.Axis_Not_Servo_On_During_Starting;
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Axis_BaseUnit.AxisHasJob THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCServiceErrorCode.Axis_Is_Busy_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{a1ab000e-6b2c-4d3e-8f90-a1ab0000000e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively after every Stop path.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{a1ab000f-6b2c-4d3e-8f90-a1ab0000000f}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Busy;

// Resource acquisition failures enter Stopping without owning the Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	H_OnStopping := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveAbsolute before issuing the physical Stop.
Axis_BaseUnit.M_MoveAbs(
	OwnerId := ResourceOwnerId,
	Execute := FALSE,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);

Axis_BaseUnit.M_Stop(
	OwnerId := ResourceOwnerId,
	Execute := TRUE,
	Deceleration:= Param.Deceleration,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Stop(
		OwnerId := ResourceOwnerId,
		Execute := FALSE,
		Deceleration:= Param.Deceleration);
	// Ownership is released only after the asynchronous Stop has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnStopping := E_PackMLHookResult.Done;

ELSIF bError THEN
	// Throw up error
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Error_While_Stop_Axis;

	Axis_BaseUnit.M_Stop(
		OwnerId := ResourceOwnerId,
		Execute := FALSE,
		Deceleration:= Param.Deceleration);

	RequestCommand(E_PackMLCommand.Abort);
END_IF

]]></ST>
      </Implementation>
    </Method>
