END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHolding" Id="{c2d80b5f-562d-4ddd-beae-7b5311cee51f}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHolding : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
