H_OnHolding := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{9b034644-43a6-4302-885f-63ea77975240}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Idle Services must not retain a Resource from an earlier operation.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCSpinAxisMoveAbsErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{9fac3a5f-72e3-4249-a638-a9be1f5d5fde}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{bc14a29c-b9ee-4657-bbc7-049b9824eea0}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCSpinAxisMoveAbsErrorCode.None;

// Validate Service-owned data before reserving the shared BaseUnit.
IF Param.Velocity <= 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCSpinAxisMoveAbsErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

IF Param.Acceleration < 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCSpinAxisMoveAbsErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

IF Param.Deceleration < 0 THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCSpinAxisMoveAbsErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Resource contention is a failed Start, not a wait condition.
IF NOT Axis_BaseUnit.M_AcquireResource(OwnerId := ResourceOwnerId) THEN
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCSpinAxisMoveAbsErrorCode.Resource_Acquire_Failed_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Physical checks occur only after this Service owns the BaseUnit.
IF Axis_BaseUnit.AxisIsDisabled THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCSpinAxisMoveAbsErrorCode.Axis_Not_Servo_On_During_Starting;
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Axis_BaseUnit.AxisHasJob THEN
	Status.Error:= TRUE;
	Status.ServiceErrorId:= E_GCSpinAxisMoveAbsErrorCode.Axis_Is_Busy_During_Starting;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{076c8329-4ff7-4786-8660-e7efe4f43425}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively after every Stop path.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{4dbbd58a-3e06-43d4-b6e2-59cf43df931d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Busy;

// Resource acquisition failures enter Stopping without owning the Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	H_OnStopping := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveAbsolute before issuing the physical Stop.
Axis_BaseUnit.M_MoveAbs(
	OwnerId := ResourceOwnerId,
	Execute := FALSE,
	Position:= Param.Position,
	Velocity:= Param.Velocity,
	Acceleration:= Param.Acceleration,
	Deceleration:= Param.Deceleration);
	
Axis_BaseUnit.M_Stop(
	Execute := TRUE, 
	Deceleration:= Param.Deceleration,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Param.Deceleration);
	// Ownership is released only after the asynchronous Stop has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnStopping := E_PackMLHookResult.Done;
	
ELSIF bError THEN
	// Throw up error
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCSpinAxisMoveAbsErrorCode.Error_While_Stop_Axis;
	
	Axis_BaseUnit.M_Stop(
		Execute := FALSE, 
		Deceleration:= Param.Deceleration);
		
	RequestCommand(E_PackMLCommand.Abort);
END_IF

]]></ST>
      </Implementation>
    </Method>
