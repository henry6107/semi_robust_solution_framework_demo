<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GCSpinAxisMoveVelCWServices" Id="{2d3a48e0-0a65-435f-812d-3e25cfaffe3c}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GCSpinAxisMoveVelCWServices EXTENDS FB_PackMLModeSet
VAR_INPUT
	Param : ST_GCSpinAxisMoveVelParam;
	Ctrl : REFERENCE TO ST_ServiceCtrl;
	Axis_BaseUnit : I_Axis_BaseUnit;

	// The Module assigns a unique ID to this Service instance.
	ResourceOwnerId : T_ResourceOwnerId;
END_VAR

VAR_OUTPUT
	Status : ST_ServiceStatus;
END_VAR

VAR
	_CommandedVelocity : LREAL;
	_VelocityRetriggerPending : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[PackMLIn := Ctrl.PackMLIn;
SUPER^();

// Updata status
IF PackMLIn.bCommandChangeRequest THEN // Acknowledge to upper controller that command received
	Status.ResponseId := Ctrl.RequestId;
ELSE
	Status.ResponseId := 0;
END_IF
Status.State := PackMLOut.eStateCurrent;
Status.CtrlErrorId := PackMLOut.eStateErrorID;
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{49ed7549-95d2-4542-8c09-83ad057d2672}" />
    <Method Name="H_OnAborted" Id="{328f5265-3f48-4442-8390-1fd00d156006}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively in case an unexpected transition skipped cleanup.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

_CommandedVelocity := 0;
_VelocityRetriggerPending := FALSE;

Status.Busy := FALSE;
Status.Done := FALSE;
Status.Aborted := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{8ef4724f-e418-45d4-b245-336c28b5f1de}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// A Service that never acquired the Resource must not reset its Owner's Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ResourceOwnerId) THEN
	H_OnAborting := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveVelocity before resetting the Axis.
Axis_BaseUnit.M_MoveVel(
	OwnerId := ResourceOwnerId,
	Execute := FALSE,
	Direction := MC_Direction.MC_Positive_Direction,
	Velocity := Param.Velocity,
	Acceleration := Param.Acceleration,
	Deceleration := Param.Deceleration);
	
Axis_BaseUnit.M_Reset(
	OwnerId := ResourceOwnerId,
	Execute := TRUE,
	Done=> bDone, Error=> bError);

IF bDone THEN
	Axis_BaseUnit.M_Reset(
		OwnerId := ResourceOwnerId,
		Execute := FALSE);
	// Keep ownership until the asynchronous Reset has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnAborting := E_PackMLHookResult.Done;

ELSIF bError THEN
	// A failed Reset is terminal for this Abort sequence; do not remain in Aborting.
	Axis_BaseUnit.M_Reset(
		OwnerId := ResourceOwnerId,
		Execute := FALSE);
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Error_While_Reset_Axis;
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
	H_OnAborting := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{e065280f-e16e-4d87-85cf-24b54094afe6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{6d77d87d-d9c6-4390-a07a-5b4202d501b8}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Completing normally releases first; this is an idempotent safety net.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);

Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{3864e1ba-9360-45a8-9d26-f1e180c8fbe5}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Status.Busy := FALSE;
Status.Done := TRUE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

Axis_BaseUnit.M_MoveVel(
	OwnerId := ResourceOwnerId,
	Execute := FALSE,
	Direction := MC_Direction.MC_Positive_Direction,
	Velocity := Param.Velocity,
	Acceleration := Param.Acceleration,
	Deceleration := Param.Deceleration);

// Release only after the active MoveVelocity request has been withdrawn.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ResourceOwnerId);
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{d5c34347-be90-4f5e-8be4-57798b5c5bb2}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

Status.Busy := TRUE;
Status.Done := FALSE;
Status.Error := FALSE;
Status.Aborted := FALSE;
Status.ServiceErrorId := E_GCServiceErrorCode.None;

// Parameters can change while Execute is active, so validate them every scan.
IF (Param.Velocity <= 0) OR (Param.Acceleration < 0) OR (Param.Deceleration < 0) THEN
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Invalid_Param;
	RequestCommand(E_PackMLCommand.Stop);
	RETURN;
END_IF

// Tc2_MC2 applies new motion parameters on a rising edge of Execute. Keep the
// axis moving while pulsing Execute low for one scan, then retrigger with the
// latest valid velocity and the current acceleration/deceleration values.
IF _VelocityRetriggerPending THEN
	Axis_BaseUnit.M_MoveVel(
		OwnerId := ResourceOwnerId,
		Execute := TRUE,
		Direction := MC_Direction.MC_Positive_Direction,
		Velocity := Param.Velocity,
		Acceleration := Param.Acceleration,
		Deceleration := Param.Deceleration,
		Error=> bError);

	_CommandedVelocity := Param.Velocity;
	_VelocityRetriggerPending := FALSE;

ELSIF Param.Velocity <> _CommandedVelocity THEN
	Axis_BaseUnit.M_MoveVel(
		OwnerId := ResourceOwnerId,
		Execute := FALSE,
		Direction := MC_Direction.MC_Positive_Direction,
		Velocity := Param.Velocity,
		Acceleration := Param.Acceleration,
		Deceleration := Param.Deceleration,
		Error=> bError);

	_VelocityRetriggerPending := TRUE;

ELSE
	Axis_BaseUnit.M_MoveVel(
		OwnerId := ResourceOwnerId,
		Execute := TRUE,
		Direction := MC_Direction.MC_Positive_Direction,
		Velocity := Param.Velocity,
		Acceleration := Param.Acceleration,
		Deceleration := Param.Deceleration,
		Error=> bError);
END_IF

IF bError THEN
	Status.Error := TRUE;
	Status.ServiceErrorId := E_GCServiceErrorCode.Axis_Command_Error_During_Execute;
	RequestCommand(E_PackMLCommand.Stop);
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{290e557c-077d-4d3a-a2bb-06d511e35f5d}" FolderPath="StateAction\">
