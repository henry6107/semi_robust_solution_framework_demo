<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_GC_Module" Id="{d2b222b5-592d-46be-8a8e-fa50af509b93}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_GC_Module EXTENDS FB_PackMLModeSet
VAR_INPUT	
	HwInput : REFERENCE TO ST_GC_Signal_In;
	HwOutput : REFERENCE TO ST_GC_Signal_Out;
	
	ModuleCtrl : REFERENCE TO ST_ModuleCtrl;
	ServiceCtrl : REFERENCE TO ST_GC_ServiceCtrl;
	ECID : REFERENCE TO ST_GC_ECID;
	
	// Base unit used in GC chamber
	SpinAxis_BaseUnit : I_Axis_BaseUnit;
	LiftPinAxis_BaseUnit : I_Axis_BaseUnit;
END_VAR

VAR_OUTPUT
	ModuleStatus : ST_ModuleStatus;
	ServiceStatus : ST_GC_ServiceStatus;
	ALID : ST_GC_ALID;
	DVID : ST_GC_DVID;
	SVID : ST_GC_SVID;
END_VAR

VAR
	// 有需要特殊操作的需求，所以建立一個 ST_GC_ServiceCtrl 變數，讓程式內部可以過一手處理
	_ServiceCtrlView : U_GC_ServiceCtrlView;
	_ServiceStatusView : U_GC_ServiceStatusView;

	_nIdx : UINT;
	_SpinAxisJogCWService : FB_GCSpinAxisJogCWServices;
	_SpinAxisMoveAbsService : FB_GCSpinAxisMoveAbsServices;
	_SpinAxisMoveVelCWService : FB_GCSpinAxisMoveVelCWServices;
	_LiftPinAxisMoveVelCWService : FB_GCLiftPinAxisMoveVelCWServices;
	_LiftPinAxisMoveVelCCWService : FB_GCLiftPinAxisMoveVelCCWServices;
	_LiftPinAxisMoveAbsService : FB_GCLiftPinAxisMoveAbsServices;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// An unbound Axis interface is a composition error. Keep the Module inert.
IF (SpinAxis_BaseUnit = 0) OR (LiftPinAxis_BaseUnit = 0) THEN
	RETURN;
END_IF

PackMLIn := ModuleCtrl.PackMLIn;
SUPER^();
A01_ServiceParam();
A02_ServiceControlResource();
A03_Service();
A00_BaseUnit();

// Updata status
IF PackMLIn.bCommandChangeRequest OR PackMLIn.bModeChangeRequest THEN
	ModuleStatus.ResponseId := ModuleCtrl.RequestId;
ELSE
	ModuleStatus.ResponseId := 0;
END_IF
ModuleStatus.PackMLOut := PackMLOut;
ServiceStatus := _ServiceStatusView.ByName;

]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{92cfe23b-b998-4d76-8aa2-c8089e78aa61}" />
    <Action Name="A00_BaseUnit" Id="{e32e8cc6-0faf-4aa6-8f04-fdfae785d66d}">
      <Implementation>
        <ST><![CDATA[SpinAxis_BaseUnit.M_CyclicUpdate();
LiftPinAxis_BaseUnit.M_CyclicUpdate();]]></ST>
      </Implementation>
    </Action>
    <Action Name="A01_ServiceParam" Id="{8b66dd3f-2093-4de6-963d-8da3bda49bf6}">
      <Implementation>
        <ST><![CDATA[_SpinAxisMoveAbsService.Param := ECID.SpinAxisMoveAbs;
_SpinAxisJogCWService.Param := ECID.SpinAxisJogCW;
_SpinAxisMoveVelCWService.Param := ECID.SpinAxisMoveVelCW;
_LiftPinAxisMoveVelCWService.Param := ECID.LiftPinAxisMoveVelCW;
_LiftPinAxisMoveVelCCWService.Param := ECID.LiftPinAxisMoveVelCCW;
_LiftPinAxisMoveAbsService.Param := ECID.LiftPinAxisMoveAbs;]]></ST>
      </Implementation>
    </Action>
    <Action Name="A02_ServiceControlResource" Id="{2f460f0f-4f51-4597-948c-8705f2c24753}">
      <Implementation>
        <ST><![CDATA[// Select control source
IF PackMLOut.eStateCurrent = E_PackMLState.Idle
	OR PackMLOut.eStateCurrent = E_PackMLState.Starting
	OR PackMLOut.eStateCurrent = E_PackMLState.Execute THEN
	// Controlled by external operator
	_ServiceCtrlView.ByName := ServiceCtrl;
	
ELSE
	// Control by module
	FOR _nIdx := 1 TO GVL_GC_Config.cServiceCount DO
		_ServiceCtrlView.ByIndex[_nIdx].PackMLIn := ModuleCtrl.PackMLIn;
		_ServiceCtrlView.ByIndex[_nIdx].RequestId := ModuleCtrl.RequestId;
	END_FOR
END_IF]]></ST>
      </Implementation>
    </Action>
    <Action Name="A03_Service" Id="{c62275db-aa76-4b4d-95ad-2ecb5851f919}">
      <Implementation>
        <ST><![CDATA[_SpinAxisJogCWService(
	Ctrl:= _ServiceCtrlView.ByName.SpinAxisJogCW,
	Axis_BaseUnit:= SpinAxis_BaseUnit,
	// Owner IDs are assigned by the Module so each Service instance is unique.
	ResourceOwnerId:= E_GCResourceOwnerId.SpinAxisJogCW,
	Status=> _ServiceStatusView.ByName.SpinAxisJogCW);

_SpinAxisMoveAbsService(
	Ctrl:= _ServiceCtrlView.ByName.SpinAxisMoveAbs,
	Axis_BaseUnit:= SpinAxis_BaseUnit,
	ResourceOwnerId:= E_GCResourceOwnerId.SpinAxisMoveAbs,
	Status=> _ServiceStatusView.ByName.SpinAxisMoveAbs);

_SpinAxisMoveVelCWService(
	Ctrl:= _ServiceCtrlView.ByName.SpinAxisMoveVelCW,
	Axis_BaseUnit:= SpinAxis_BaseUnit,
	ResourceOwnerId:= E_GCResourceOwnerId.SpinAxisMoveVelCW,
	Status=> _ServiceStatusView.ByName.SpinAxisMoveVelCW);

_LiftPinAxisMoveVelCWService(
	Ctrl:= _ServiceCtrlView.ByName.LiftPinAxisMoveVelCW,
	Axis_BaseUnit:= LiftPinAxis_BaseUnit,
	ResourceOwnerId:= E_GCResourceOwnerId.LiftPinAxisMoveVelCW,
	Status=> _ServiceStatusView.ByName.LiftPinAxisMoveVelCW);

_LiftPinAxisMoveVelCCWService(
	Ctrl:= _ServiceCtrlView.ByName.LiftPinAxisMoveVelCCW,
	Axis_BaseUnit:= LiftPinAxis_BaseUnit,
	ResourceOwnerId:= E_GCResourceOwnerId.LiftPinAxisMoveVelCCW,
	Status=> _ServiceStatusView.ByName.LiftPinAxisMoveVelCCW);

_LiftPinAxisMoveAbsService(
	Ctrl:= _ServiceCtrlView.ByName.LiftPinAxisMoveAbs,
	Axis_BaseUnit:= LiftPinAxis_BaseUnit,
	ResourceOwnerId:= E_GCResourceOwnerId.LiftPinAxisMoveAbs,
	Status=> _ServiceStatusView.ByName.LiftPinAxisMoveAbs);
]]></ST>
      </Implementation>
    </Action>
    <Method Name="H_OnAborted" Id="{de8d6f56-427f-41df-b4d5-ddd289e1aed8}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{29c05c7a-ae95-4991-b775-aae453451d8c}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// Wait cmd finished
FOR _nIdx := 1 TO GVL_GC_Config.cServiceCount DO
	IF _ServiceStatusView.ByIndex[_nIdx].State <> E_PackMLState.Aborted THEN
		RETURN;
	END_IF
END_FOR

H_OnAborting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{b7069c3b-bd41-45c4-a177-00789e12f344}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnClearing := E_PackMLHookResult.Busy;

// Wait cmd finished
FOR _nIdx := 1 TO GVL_GC_Config.cServiceCount DO
	IF _ServiceStatusView.ByIndex[_nIdx].State <> E_PackMLState.Stopped THEN
		RETURN;
	END_IF
END_FOR

H_OnClearing := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{9ab7169f-1450-41d3-b3d7-d608e72d68f0}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
