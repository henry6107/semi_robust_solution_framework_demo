      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{6a295d34-cfdf-466f-b604-2e762f01df0b}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default transient hooks complete immediately; override when work is required.
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{dc703a52-8c8a-4e2d-8deb-4adebb327ad6}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Execute is stable by default; derived FBs decide when the process is done.
H_OnExecute := E_PackMLHookResult.Busy;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnHeld" Id="{93f6b454-4398-4439-9237-4d01e13b7ccc}" FolderPath="StateAction\">
