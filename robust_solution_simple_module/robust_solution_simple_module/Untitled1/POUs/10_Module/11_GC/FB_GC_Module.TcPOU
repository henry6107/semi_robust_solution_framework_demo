    </Method>
    <Method Name="H_OnHolding" Id="{d74d6d7d-e0fe-48fb-8a46-ad96f64e1fa5}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnHolding : E_PackMLHookResult
VAR_INPUT
