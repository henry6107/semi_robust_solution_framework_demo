H_OnHolding := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{f9aa0f59-b1bb-45b6-82a2-3aac2bdc4e33}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Default action hook intentionally empty. Override in derived FBs when needed.

// Transfer to execute automatically
RequestCommand(E_PackMLCommand.Start);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{f6ec54bd-ad3d-49c4-9547-ff474beb3546}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnResetting := E_PackMLHookResult.Busy;

// Wait cmd finished
FOR _nIdx := 1 TO GVL_GC_Config.cServiceCount DO
	IF _ServiceStatusView.ByIndex[_nIdx].State <> E_PackMLState.Idle THEN
		RETURN;
	END_IF
END_FOR

H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{2befc923-f5b2-4ef5-aa0b-77c9a7b33520}" FolderPath="StateAction\">
