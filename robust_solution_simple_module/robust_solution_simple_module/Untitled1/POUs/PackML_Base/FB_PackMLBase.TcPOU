<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_PackMLBase" Id="{bb7074bb-cd46-4555-9ada-1eb1c7832876}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_PackMLBase
VAR_INPUT
	PackMLIn	: REFERENCE TO ST_PML_Base_In;
	
	bEnable				: BOOL := TRUE;
	bExternalFault		: BOOL;
END_VAR
VAR_OUTPUT
	PackMLOut	: ST_PML_Base_Out;
	
	bTransitionActive	: BOOL;
END_VAR
VAR
	_eLastCommand			: E_PackMLCommand := E_PackMLCommand.None;
	_eCommandToProcess		: E_PackMLCommand := E_PackMLCommand.None;
	_eQueuedCommand			: E_PackMLCommand := E_PackMLCommand.None;
	_bQueuedCommandRequest	: BOOL;
	_bCommandConsumed		: BOOL;
	_bModeChangeConsumed	: BOOL;
	_bStateFirstScan		: BOOL := TRUE;
	_bStateFirstScanForHook	: BOOL;
	_eHookResult			: E_PackMLHookResult;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Reset edge-style status before evaluating this PLC cycle.
_eCommandToProcess		:= E_PackMLCommand.None;

// Command and mode request feedback is latched for HMI/upper-layer handshakes
// until the corresponding request input returns to FALSE.
IF NOT PackMLIn.bCommandChangeRequest THEN
	PackMLOut.bCommandAccepted	:= FALSE;
	PackMLOut.bCommandRejected	:= FALSE;
	PackMLOut.eStateErrorID			:= E_PackMLErrorID.NoError;
END_IF

IF NOT PackMLIn.bModeChangeRequest THEN
	PackMLOut.bModeChanged		:= FALSE;
	PackMLOut.bModeChangeRejected	:= FALSE;
	PackMLOut.eModeErrorID		:= E_PackMLErrorID.NoError;
END_IF

// A disabled base FB holds the current state and suppresses transition activity.
IF NOT bEnable THEN
	bTransitionActive := FALSE;
	RETURN;
END_IF

// Mode change requests are edge/latch based, matching command request behavior.
// The caller must clear stIn.bModeChangeRequest before the same request can run again.
IF NOT PackMLIn.bModeChangeRequest THEN
	_bModeChangeConsumed := FALSE;
END_IF

IF PackMLIn.bModeChangeRequest AND NOT _bModeChangeConsumed THEN
	_bModeChangeConsumed := TRUE;

	IF NOT H_IsModeSupported(PackMLIn.eMode) THEN
		M_RejectModeChange(E_PackMLErrorID.ModeNotSupported);
	ELSIF PackMLIn.eMode = PackMLOut.eModeCurrent THEN
		M_RejectModeChange(E_PackMLErrorID.ModeAlreadyActive);
	ELSIF NOT M_IsModeChangeAllowedByState() THEN
		M_RejectModeChange(E_PackMLErrorID.ModeChangeNotAllowedFromCurrentState);
	ELSIF NOT H_IsStateSupportedByMode(PackMLIn.eMode, PackMLOut.eStateCurrent) THEN
		M_RejectModeChange(E_PackMLErrorID.ModeDoesNotSupportCurrentState);
	ELSE
		M_ChangeMode(PackMLIn.eMode);
	END_IF
END_IF

// Command requests are edge/latch based, matching mode-change request behavior.
// The caller must clear stIn.bCommandChangeRequest before another command can run.
IF NOT PackMLIn.bCommandChangeRequest THEN
	_bCommandConsumed	:= FALSE;
	_eLastCommand		:= E_PackMLCommand.None;
END_IF

// External faults have priority over normal commands and force the abort path
// only while the machine is not already Aborting or Aborted.
IF bExternalFault AND M_IsAbortAllowedByState() THEN
	_eCommandToProcess := E_PackMLCommand.Abort;
ELSIF _bQueuedCommandRequest AND (_eQueuedCommand <> E_PackMLCommand.None) THEN
	_eCommandToProcess		:= _eQueuedCommand;
	_eQueuedCommand			:= E_PackMLCommand.None;
	_bQueuedCommandRequest	:= FALSE;
ELSIF PackMLIn.bCommandChangeRequest AND (PackMLIn.eCommand <> E_PackMLCommand.None) AND NOT _bCommandConsumed THEN
	_eCommandToProcess	:= PackMLIn.eCommand;
	_eLastCommand		:= PackMLIn.eCommand;
	_bCommandConsumed	:= TRUE;
END_IF

// Mode policy hooks run before PackML state guards so a forbidden command reports
// the mode reason instead of a state reason.
IF (_eCommandToProcess <> E_PackMLCommand.None) AND NOT H_IsCommandAllowedByMode(_eCommandToProcess, PackMLOut.eModeCurrent) THEN
	M_RejectCommand(E_PackMLErrorID.CommandNotAllowedInActiveMode);
	_eCommandToProcess := E_PackMLCommand.None;
END_IF

// Dispatch the accepted command through private PackML state guards.
// Rejected commands never mutate the state and return a stable numeric error ID.
CASE _eCommandToProcess OF
	E_PackMLCommand.Clear:
		IF M_IsClearAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Clearing);
		ELSE
			M_RejectCommand(E_PackMLErrorID.ClearNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Reset:
		IF M_IsResetAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Resetting);
		ELSE
			M_RejectCommand(E_PackMLErrorID.ResetNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Start:
		IF M_IsStartAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Starting);
		ELSE
			M_RejectCommand(E_PackMLErrorID.StartNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Stop:
		IF M_IsStopAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Stopping);
		ELSE
			M_RejectCommand(E_PackMLErrorID.StopNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Hold:
		IF M_IsHoldAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Holding);
		ELSE
			M_RejectCommand(E_PackMLErrorID.HoldNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Unhold:
		IF M_IsUnholdAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Unholding);
		ELSE
			M_RejectCommand(E_PackMLErrorID.UnholdNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Suspend:
		IF M_IsSuspendAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Suspending);
		ELSE
			M_RejectCommand(E_PackMLErrorID.SuspendNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Unsuspend:
		IF M_IsUnsuspendAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Unsuspending);
		ELSE
			M_RejectCommand(E_PackMLErrorID.UnsuspendNotAllowedFromCurrentState);
		END_IF

	E_PackMLCommand.Abort:
		IF M_IsAbortAllowedByState() THEN
			PackMLOut.bCommandAccepted := TRUE;
			M_ChangeState(E_PackMLState.Aborting);
		ELSE
			M_RejectCommand(E_PackMLErrorID.AbortNotAllowedFromCurrentState);
		END_IF
END_CASE

// Run the current state's action hook, then advance transient states when their
// hook reports Done. Stable states remain active until a command moves them.
_bStateFirstScanForHook	:= _bStateFirstScan;
_bStateFirstScan		:= FALSE;

CASE PackMLOut.eStateCurrent OF
	E_PackMLState.Undefined:
		_eHookResult := H_OnUndefined(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Aborted);
		END_IF

	E_PackMLState.Clearing:
		_eHookResult := H_OnClearing(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Stopped);
		END_IF

	E_PackMLState.Stopped:
		H_OnStopped(_bStateFirstScanForHook);

	E_PackMLState.Starting:
		_eHookResult := H_OnStarting(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Execute);
		END_IF

	E_PackMLState.Idle:
		H_OnIdle(_bStateFirstScanForHook);

	E_PackMLState.Suspended:
		H_OnSuspended(_bStateFirstScanForHook);

	E_PackMLState.Execute:
		_eHookResult := H_OnExecute(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Completing);
		END_IF

	E_PackMLState.Stopping:
		_eHookResult := H_OnStopping(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Stopped);
		END_IF

	E_PackMLState.Aborting:
		_eHookResult := H_OnAborting(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Aborted);
		END_IF

	E_PackMLState.Aborted:
		H_OnAborted(_bStateFirstScanForHook);

	E_PackMLState.Holding:
		_eHookResult := H_OnHolding(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Held);
		END_IF

	E_PackMLState.Held:
		H_OnHeld(_bStateFirstScanForHook);

	E_PackMLState.Unholding:
		_eHookResult := H_OnUnholding(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Execute);
		END_IF

	E_PackMLState.Suspending:
		_eHookResult := H_OnSuspending(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Suspended);
		END_IF

	E_PackMLState.Unsuspending:
		_eHookResult := H_OnUnsuspending(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Execute);
		END_IF

	E_PackMLState.Resetting:
		_eHookResult := H_OnResetting(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Idle);
		END_IF

	E_PackMLState.Completing:
		_eHookResult := H_OnCompleting(_bStateFirstScanForHook);
		IF _eHookResult = E_PackMLHookResult.Done THEN
			M_ChangeState(E_PackMLState.Complete);
		END_IF

	E_PackMLState.Complete:
		H_OnComplete(_bStateFirstScanForHook);
END_CASE

// Transition activity is true for transient states that normally need completion
// confirmation from their state hook.
bTransitionActive :=
	(PackMLOut.eStateCurrent = E_PackMLState.Undefined) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Clearing) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Starting) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Stopping) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Aborting) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Holding) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Unholding) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Suspending) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Unsuspending) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Resetting) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Completing);]]></ST>
    </Implementation>
    <Folder Name="Mode Setting Hook Method" Id="{804b7073-8ed6-4fb6-a676-84629a6495bf}" />
    <Folder Name="Private Method" Id="{82a24892-a715-46be-9ec0-bcb60939def2}" />
