    <Method Name="M_ChangeMode" Id="{480596f8-48a1-425b-a307-21512e84f091}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_ChangeMode
VAR_INPUT
	eNextMode	: T_PackMLMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Centralize mode mutation so previous-mode and edge outputs stay consistent.
IF PackMLOut.eModeCurrent <> eNextMode THEN
	PackMLOut.eModePrevious	:= PackMLOut.eModeCurrent;
	PackMLOut.eModeCurrent	:= eNextMode;
	PackMLOut.bModeChanged	:= TRUE;
	H_OnModeChanged(PackMLOut.eModePrevious, PackMLOut.eModeCurrent);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_ChangeState" Id="{bf78a96d-9d4e-42b6-b159-e367e8ad7c2c}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_ChangeState
VAR_INPUT
	eNextState	: E_PackMLState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Centralize state mutation so previous-state and edge outputs stay consistent.
IF PackMLOut.eStateCurrent <> eNextState THEN
	PackMLOut.eStatePrevious	:= PackMLOut.eStateCurrent;
	PackMLOut.eStateCurrent			:= eNextState;
	_bStateFirstScan			:= TRUE;
	H_OnStateChanged(PackMLOut.eStatePrevious, PackMLOut.eStateCurrent);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsAbortAllowedByState" Id="{fa7a4de6-c9e7-4315-9d09-7067965a2941}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsAbortAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Abort is valid from every state except the terminal abort states.
M_IsAbortAllowedByState := (PackMLOut.eStateCurrent <> E_PackMLState.Aborting) AND (PackMLOut.eStateCurrent <> E_PackMLState.Aborted);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsClearAllowedByState" Id="{332a91a0-3733-42b2-abec-4c14a54021cd}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsClearAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Clear leaves the safe Aborted state and starts the resettable stop path.
M_IsClearAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Aborted;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsCompleteAllowedByState" Id="{e29a4438-6687-4116-a4d4-577056243d8b}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsCompleteAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Complete is only meaningful while the unit is executing.
M_IsCompleteAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Execute;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsHoldAllowedByState" Id="{49bde5a5-35d4-4747-a469-fc23b21ffacd}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsHoldAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Hold pauses an active Execute flow.
M_IsHoldAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Execute;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsModeChangeAllowedByState" Id="{5a21c016-dfdc-4c29-86e7-52905f19cfbd}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsModeChangeAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Mode changes can only be attempted from safe stable states.
// Target mode compatibility is checked separately after this safety gate.
// Henry: Bypass "Held" & "Suspended" state due to consideration about state-related parameters inconsistent
M_IsModeChangeAllowedByState :=
	(PackMLOut.eStateCurrent = E_PackMLState.Aborted) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Stopped) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Idle) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Complete);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsResetAllowedByState" Id="{38b5684f-4df4-4061-acdd-f532c5411342}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsResetAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset prepares the unit from Stopped or Complete into Idle.
M_IsResetAllowedByState := (PackMLOut.eStateCurrent = E_PackMLState.Stopped) OR (PackMLOut.eStateCurrent = E_PackMLState.Complete);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsStartAllowedByState" Id="{5a2e9cc0-9e0d-4da4-a55b-a165f1eeb9bf}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsStartAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Start begins production or operation only from Idle.
M_IsStartAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Idle;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsStopAllowedByState" Id="{f0da80f2-c0a2-4ca1-a63e-a5b90bf2f04c}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsStopAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Stop is accepted from normal operating, paused, and completing states.
M_IsStopAllowedByState :=
	(PackMLOut.eStateCurrent = E_PackMLState.Starting) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Idle) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Execute) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Completing) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Complete) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Holding) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Held) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Unholding) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Suspending) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Suspended) OR
	(PackMLOut.eStateCurrent = E_PackMLState.Unsuspending);]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsSuspendAllowedByState" Id="{362e955c-d91e-4573-ac49-5e1f5561e9d1}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsSuspendAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Suspend pauses Execute because of an external process condition.
M_IsSuspendAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Execute;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsUnholdAllowedByState" Id="{90276ba7-ddef-4e56-8b6f-9f76fe99435a}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsUnholdAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Unhold resumes from the stable Held state.
M_IsUnholdAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Held;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_IsUnsuspendAllowedByState" Id="{c3563b72-aa8b-4b4c-9d01-38e261429a17}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_IsUnsuspendAllowedByState : BOOL
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Unsuspend resumes from the stable Suspended state.
M_IsUnsuspendAllowedByState := PackMLOut.eStateCurrent = E_PackMLState.Suspended;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RejectCommand" Id="{fd9fdbf3-d906-4767-8436-2bb609e1c84f}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_RejectCommand
VAR_INPUT
	eErrorID	: E_PackMLErrorID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Centralize rejected-command reporting so every guard failure has a stable ID.
PackMLOut.bCommandRejected	:= TRUE;
PackMLOut.eStateErrorID		:= eErrorID;]]></ST>
      </Implementation>
    </Method>
    <Method Name="M_RejectModeChange" Id="{424b9d75-e7ad-40d7-b41a-b08d033526d2}" FolderPath="Private Method\">
      <Declaration><![CDATA[METHOD PRIVATE M_RejectModeChange
VAR_INPUT
	eErrorID	: E_PackMLErrorID;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Keep mode-change errors separate from PackML command/state errors.
PackMLOut.bModeChangeRejected	:= TRUE;
PackMLOut.eModeErrorID		:= eErrorID;]]></ST>
      </Implementation>
    </Method>
    <Method Name="RequestCommand" Id="{acc2f90f-ee3a-48ba-968f-939630ff093a}">
      <Declaration><![CDATA[// Used for requesting PackML command inside state machine itself 
METHOD PROTECTED RequestCommand : BOOL
VAR_INPUT
	eTargetCmd	: E_PackMLCommand;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[RequestCommand := FALSE;

IF _bQueuedCommandRequest OR PackMLIn.bModeChangeRequest THEN
	RETURN;
END_IF

_eQueuedCommand			:= eTargetCmd;
_bQueuedCommandRequest	:= TRUE;
RequestCommand := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>