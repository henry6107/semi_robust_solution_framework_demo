    <Method Name="H_IsCommandAllowedByMode" Id="{9a833552-ec23-421d-885d-93766f9e9ef6}" FolderPath="Mode Setting Hook Method\">
      <Declaration><![CDATA[METHOD PROTECTED H_IsCommandAllowedByMode : BOOL
VAR_INPUT
	eRequestedCommand	: E_PackMLCommand;
	eActiveMode			: T_PackMLMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Modes are application-defined in library use; override to restrict commands per mode.
H_IsCommandAllowedByMode := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_IsModeSupported" Id="{5a131af6-fe63-4452-b7b9-fbb87cf32720}" FolderPath="Mode Setting Hook Method\">
      <Declaration><![CDATA[METHOD PROTECTED H_IsModeSupported : BOOL
VAR_INPUT
	eRequestedMode	: T_PackMLMode;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Modes are application-defined in library use; override to reject unsupported modes.
H_IsModeSupported := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_IsStateSupportedByMode" Id="{8ecb8812-d961-4d2e-a8cf-d988ced19232}" FolderPath="Mode Setting Hook Method\">
      <Declaration><![CDATA[METHOD PROTECTED H_IsStateSupportedByMode : BOOL
VAR_INPUT
	eRequestedMode	: T_PackMLMode;
	eCurrentState	: E_PackMLState;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Modes are application-defined in library use; override to restrict mode/state pairs.
H_IsStateSupportedByMode := TRUE;]]></ST>
      </Implementation>
    </Method>
