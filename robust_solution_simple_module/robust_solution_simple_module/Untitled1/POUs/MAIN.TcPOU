<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{732eef67-564b-4eae-a87a-e2bb58901008}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	GC1_Module : FB_GC_Module;
	GC1_SpinAxis_BaseUnit : FB_Axis_BaseUnit;
	GC1_LiftPinAxis_BaseUnit : FB_Axis_BaseUnit;
	_GC1 : ST_GC_CtrlStatus;
	GC1_HwIn :  U_GC_HW_In;
	GC_HwOut : U_GC_HW_Out;
	
	_bTest : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[// Map the right channel to _GC1 for module control
// IF GC1_Module.ModuleStatus.eModeCurrent = E_PackMLMode.Manual THEN
// 	_GC1 := GVL_GUI.GC1;
//
// ELSIF GC1_Module.ModuleStatus.eModeCurrent = E_PackMLMode.Production THEN
// 	_GC1 := GVL_CSharp.GC1;
// END_IF

GC1_Module(
	HwInput:= GC1_HwIn.Signal, 
	HwOutput:= GC_HwOut.Signal, 
	ModuleCtrl:= _GC1.ModuleCtrl, 
	ServiceCtrl:= _GC1.ServiceCtrl,
	ECID:= _GC1.ECID, 
	SpinAxis_BaseUnit:= GC1_SpinAxis_BaseUnit,
	LiftPinAxis_BaseUnit:= GC1_LiftPinAxis_BaseUnit,
	ModuleStatus=> _GC1.ModuleStatus,
	ServiceStatus=> _GC1.ServiceStatus, 
	ALID=> , 
	DVID=> , 
	SVID=> _GC1.SVID);
	
IF _bTest THEN
	_bTest := FALSE;
	
	(* LiftPin：待機 0 → Ready 10 → Process 20 *)
	_GC1.ECID.SingleProcess.LiftReady.Position := 10.0;
	_GC1.ECID.SingleProcess.LiftReady.Velocity := 5.0;
	_GC1.ECID.SingleProcess.LiftReady.Acceleration := 10.0;
	_GC1.ECID.SingleProcess.LiftReady.Deceleration := 10.0;
	
	(* Spin：先對位至 90° *)
	_GC1.ECID.SingleProcess.SpinAlign.Position := 90.0;
	_GC1.ECID.SingleProcess.SpinAlign.Velocity := 30.0;
	_GC1.ECID.SingleProcess.SpinAlign.Acceleration := 60.0;
	_GC1.ECID.SingleProcess.SpinAlign.Deceleration := 60.0;
	
	(* 同步進入製程：Spin 180°、LiftPin 20 mm *)
	_GC1.ECID.SingleProcess.ProcessEntrySpin.Position := 180.0;
	_GC1.ECID.SingleProcess.ProcessEntrySpin.Velocity := 30.0;
	_GC1.ECID.SingleProcess.ProcessEntrySpin.Acceleration := 60.0;
	_GC1.ECID.SingleProcess.ProcessEntrySpin.Deceleration := 60.0;
	
	_GC1.ECID.SingleProcess.ProcessEntryLift.Position := 20.0;
	_GC1.ECID.SingleProcess.ProcessEntryLift.Velocity := 5.0;
	_GC1.ECID.SingleProcess.ProcessEntryLift.Acceleration := 10.0;
	_GC1.ECID.SingleProcess.ProcessEntryLift.Deceleration := 10.0;
	
	(* 製程旋轉：CW 120 *)
	_GC1.ECID.SingleProcess.SpinProcess.Velocity := 120.0;
	_GC1.ECID.SingleProcess.SpinProcess.Acceleration := 100.0;
	_GC1.ECID.SingleProcess.SpinProcess.Deceleration := 100.0;
	
	(* 同步退出：LiftPin 回到 Standby *)
	_GC1.ECID.SingleProcess.ProcessExitLift.Position := 0.0;
	_GC1.ECID.SingleProcess.ProcessExitLift.Velocity := 5.0;
	_GC1.ECID.SingleProcess.ProcessExitLift.Acceleration := 10.0;
	_GC1.ECID.SingleProcess.ProcessExitLift.Deceleration := 10.0;
	
	(* Spin 回待機角度 *)
	_GC1.ECID.SingleProcess.SpinStandby.Position := 0.0;
	_GC1.ECID.SingleProcess.SpinStandby.Velocity := 30.0;
	_GC1.ECID.SingleProcess.SpinStandby.Acceleration := 60.0;
	_GC1.ECID.SingleProcess.SpinStandby.Deceleration := 60.0;
	
	(* Stop／Abort 減速度 *)
	_GC1.ECID.SingleProcess.SpinStopDeceleration := 100.0;
	_GC1.ECID.SingleProcess.LiftStopDeceleration := 10.0;
	
	(* 各階段預期時間與逾時 *)
	_GC1.ECID.SingleProcess.StageTiming.Prepare.TargetTime := T#100MS;
	_GC1.ECID.SingleProcess.StageTiming.Prepare.Timeout := T#2S;
	
	_GC1.ECID.SingleProcess.StageTiming.LiftReady.TargetTime := T#2500MS;
	_GC1.ECID.SingleProcess.StageTiming.LiftReady.Timeout := T#8S;
	
	_GC1.ECID.SingleProcess.StageTiming.SpinAlign.TargetTime := T#3500MS;
	_GC1.ECID.SingleProcess.StageTiming.SpinAlign.Timeout := T#10S;
	
	_GC1.ECID.SingleProcess.StageTiming.ConcurrentProcessEntry.TargetTime := T#3500MS;
	_GC1.ECID.SingleProcess.StageTiming.ConcurrentProcessEntry.Timeout := T#10S;
	
	_GC1.ECID.SingleProcess.StageTiming.SpinRampUp.TargetTime := T#1500MS;
	_GC1.ECID.SingleProcess.StageTiming.SpinRampUp.Timeout := T#6S;
	
	(* 這個 TargetTime 會實際決定製程保持時間 *)
	_GC1.ECID.SingleProcess.StageTiming.ProcessHold.TargetTime := T#5S;
	_GC1.ECID.SingleProcess.StageTiming.ProcessHold.Timeout := T#7S;
	
	_GC1.ECID.SingleProcess.StageTiming.ConcurrentProcessExit.TargetTime := T#4500MS;
	_GC1.ECID.SingleProcess.StageTiming.ConcurrentProcessExit.Timeout := T#12S;
	
	_GC1.ECID.SingleProcess.StageTiming.SpinStandby.TargetTime := T#6500MS;
	_GC1.ECID.SingleProcess.StageTiming.SpinStandby.Timeout := T#15S;
	
	_GC1.ECID.SingleProcess.StopTimeout := T#10S;
	_GC1.ECID.SingleProcess.ResetTimeout := T#5S;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>