<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="MAIN" Id="{732eef67-564b-4eae-a87a-e2bb58901008}" SpecialFunc="None">
    <Declaration><![CDATA[PROGRAM MAIN
VAR
	_GC1 : REFERENCE TO ST_GC_CtrlStatus;
	_UtcClock : FB_UtcClock;
	_SystemContext : ST_SystemContext;
	_LinkVariableManager : FB_LinkVariableManager;
	_AxisReferenceManager : FB_AxisReferenceManager;
	_ModuleConfigurationManager : FB_ModuleConfigurationManager;
	_bNodesRegistered : BOOL;
	_bRegistrationOk : BOOL;
	_nModule : UINT;
	
	_bTest : BOOL;
	_bTestHearbeat : BOOL;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[_GC1 REF= GVL_Module.GC_Control[1];

// Register complete hardware terminals and GC Module IO with type-safe access rules.
IF NOT _bNodesRegistered THEN
	_bRegistrationOk := _LinkVariableManager.M_RegisterEL1889(
		Terminal := GVL_IO.Term4_EL1889);
	IF _bRegistrationOk THEN
		_bRegistrationOk := _LinkVariableManager.M_RegisterEL3602(
			Terminal := GVL_IO.Term2_EL3602);
	END_IF
	IF _bRegistrationOk THEN
		_bRegistrationOk := _LinkVariableManager.M_RegisterEL2809(
			Terminal := GVL_IO.Term3_EL2809);
	END_IF

	IF _bRegistrationOk THEN
		FOR _nModule := 1 TO Param_Config.MaxConfiguredModules DO
			IF NOT _LinkVariableManager.M_RegisterGCModule(
				Module := GVL_Module.GC[_nModule]) THEN
				_bRegistrationOk := FALSE;
				EXIT;
			END_IF
		END_FOR
	END_IF

	IF _bRegistrationOk THEN
		_bRegistrationOk := _AxisReferenceManager.M_RegisterAxis(
			Name := 'GVL_IO.NC_Axis1',
			Axis := GVL_IO.NC_Axis1);
	END_IF
	IF _bRegistrationOk THEN
		_bRegistrationOk := _AxisReferenceManager.M_RegisterAxis(
			Name := 'GVL_IO.NC_Axis2',
			Axis := GVL_IO.NC_Axis2);
	END_IF
	_bNodesRegistered := _bRegistrationOk;
END_IF

_ModuleConfigurationManager(
	Execute := _bNodesRegistered,
	FilePath := Param_Config.ModuleConfigFilePath,
	LinkVariableManager := _LinkVariableManager,
	AxisReferenceManager := _AxisReferenceManager);

// Map the right channel to _GC1 for module control
// IF GC1_Module.ModuleStatus.eModeCurrent = E_PackMLMode.Manual THEN
// 	_GC1 := GVL_GUI.GC1;
//
// ELSIF GC1_Module.ModuleStatus.eModeCurrent = E_PackMLMode.Production THEN
// 	_GC1 := GVL_CSharp.GC1;
// END_IF

_UtcClock(UtcDateTime => _SystemContext.UtcDateTime);

IF _bTestHearbeat THEN
	_GC1.HeartbeatIndex := _GC1.HeartbeatIndex + 1;
END_IF

IF _ModuleConfigurationManager.Ready THEN
	_LinkVariableManager.M_CyclicInput();
	FOR _nModule := 1 TO Param_Config.MaxConfiguredModules DO
		IF GVL_Module.GC_Runtime[_nModule].Enabled AND GVL_Module.GC_Runtime[_nModule].Valid THEN
			GVL_Module.GC[_nModule](
				HeartbeatIndex := GVL_Module.GC_Control[_nModule].HeartbeatIndex,
				ModuleCtrl := GVL_Module.GC_Control[_nModule].ModuleCtrl,
				ServiceCtrl := GVL_Module.GC_Control[_nModule].ServiceCtrl,
				ServiceParam := GVL_Module.GC_Control[_nModule].ServiceParam,
				SystemContext := _SystemContext,
				RuntimeConfig := GVL_Module.GC_Runtime[_nModule],
				SpinAxis_BaseUnit := GVL_Module.GC_SpinAxis[_nModule],
				LiftPinAxis_BaseUnit := GVL_Module.GC_LiftPinAxis[_nModule],
				ModuleStatus => GVL_Module.GC_Control[_nModule].ModuleStatus,
				ServiceStatus => GVL_Module.GC_Control[_nModule].ServiceStatus,
				ModuleAlarmList => GVL_Module.GC_Control[_nModule].ModuleAlarmList,
				ModuleDataList => GVL_Module.GC_Control[_nModule].ModuleDataList,
				ModuleVariableList => GVL_Module.GC_Control[_nModule].ModuleVariableList);
		END_IF
	END_FOR
	_LinkVariableManager.M_CyclicOutput();
END_IF
	
IF _bTest THEN
	_bTest := FALSE;
	
	(* LiftPin：待機 0 → Ready 10 → Process 20 *)
	_GC1.ServiceParam.SingleProcess.LiftReady.Position := 10.0;
	_GC1.ServiceParam.SingleProcess.LiftReady.Velocity := 5.0;
	_GC1.ServiceParam.SingleProcess.LiftReady.Acceleration := 10.0;
	_GC1.ServiceParam.SingleProcess.LiftReady.Deceleration := 10.0;
	
	(* Spin：先對位至 90° *)
	_GC1.ServiceParam.SingleProcess.SpinAlign.Position := 90.0;
	_GC1.ServiceParam.SingleProcess.SpinAlign.Velocity := 30.0;
	
	(* 同步進入製程：Spin 180°、LiftPin 20 mm *)
	_GC1.ServiceParam.SingleProcess.ProcessEntrySpin.Position := 180.0;
	_GC1.ServiceParam.SingleProcess.ProcessEntrySpin.Velocity := 30.0;
	
	_GC1.ServiceParam.SingleProcess.ProcessEntryLift.Position := 20.0;
	_GC1.ServiceParam.SingleProcess.ProcessEntryLift.Velocity := 5.0;
	
	(* 製程旋轉：CW 120 *)
	_GC1.ServiceParam.SingleProcess.SpinProcess.Velocity := 120.0;
	
	(* 同步退出：LiftPin 回到 Standby *)
	_GC1.ServiceParam.SingleProcess.ProcessExitLift.Position := 0.0;
	_GC1.ServiceParam.SingleProcess.ProcessExitLift.Velocity := 5.0;
	
	(* Spin 回待機角度 *)
	_GC1.ServiceParam.SingleProcess.SpinStandby.Position := 0.0;
	_GC1.ServiceParam.SingleProcess.SpinStandby.Velocity := 300.0;
	
	(* Stop／Abort 減速度 *)
	_GC1.ServiceParam.SingleProcess.SpinStopDeceleration := 100.0;
	_GC1.ServiceParam.SingleProcess.LiftStopDeceleration := 200.0;
	
	(* 各階段預期時間與逾時 *)
	_GC1.ServiceParam.SingleProcess.StageTiming.Prepare.TargetTime := T#100MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.Prepare.Timeout := T#2S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.LiftReady.TargetTime := T#2500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.LiftReady.Timeout := T#8S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinAlign.TargetTime := T#3500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinAlign.Timeout := T#10S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.ConcurrentProcessEntry.TargetTime := T#3500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.ConcurrentProcessEntry.Timeout := T#10S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinRampUp.TargetTime := T#1500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinRampUp.Timeout := T#6S;
	
	(* 這個 TargetTime 會實際決定製程保持時間 *)
	_GC1.ServiceParam.SingleProcess.StageTiming.ProcessHold.TargetTime := T#5S;
	_GC1.ServiceParam.SingleProcess.StageTiming.ProcessHold.Timeout := T#7S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.ConcurrentProcessExit.TargetTime := T#4500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.ConcurrentProcessExit.Timeout := T#12S;
	
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinStandby.TargetTime := T#6500MS;
	_GC1.ServiceParam.SingleProcess.StageTiming.SpinStandby.Timeout := T#15S;
	
	_GC1.ServiceParam.SingleProcess.StopTimeout := T#10S;
	_GC1.ServiceParam.SingleProcess.ResetTimeout := T#5S;
END_IF]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>