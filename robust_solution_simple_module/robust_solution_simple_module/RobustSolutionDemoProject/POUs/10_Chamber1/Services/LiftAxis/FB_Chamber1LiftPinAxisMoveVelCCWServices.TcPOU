<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_Chamber1LiftPinAxisMoveVelCCWServices" Id="{a1cc0001-6b2c-4d3e-8f90-a1cc00000001}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_Chamber1LiftPinAxisMoveVelCCWServices EXTENDS FB_ServiceBase
VAR_INPUT
	Param : ST_Chamber1LiftPinAxisMoveVelParam;
	Axis_BaseUnit : I_Axis_BaseUnit;
END_VAR

VAR
	_LatchedParam : ST_Chamber1LiftPinAxisMoveVelParam;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[M_UpdateService(CompletionBehavior := E_ServiceCompletionBehavior.NaturalCompletion);
]]></ST>
    </Implementation>
    <Folder Name="StateAction" Id="{a1cc0002-6b2c-4d3e-8f90-a1cc00000002}" />
    <Method Name="H_OnAborted" Id="{a1cc0003-6b2c-4d3e-8f90-a1cc00000003}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborted
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively in case an unexpected transition skipped cleanup.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ServiceId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnAborting" Id="{a1cc0004-6b2c-4d3e-8f90-a1cc00000004}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnAborting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnAborting := E_PackMLHookResult.Busy;

// A Service that never acquired the Resource must not reset its Owner's Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ServiceId) THEN
	H_OnAborting := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveVelocity before resetting the Axis.
Axis_BaseUnit.M_MoveVel(
	OwnerId := ServiceId,
	Execute := FALSE,
	Direction := MC_Direction.MC_Negative_Direction,
	Velocity := _LatchedParam.Velocity,
	Acceleration := _LatchedParam.Acceleration,
	Deceleration := _LatchedParam.Deceleration);

Axis_BaseUnit.M_Reset(
	OwnerId := ServiceId,
	Execute := TRUE,
	Done=> bDone, Error=> bError, ErrorId=> nErrorId);

IF bDone THEN
	Axis_BaseUnit.M_Reset(
		OwnerId := ServiceId,
		Execute := FALSE);
	// Keep ownership until the asynchronous Reset has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ServiceId);
	H_OnAborting := E_PackMLHookResult.Done;

ELSIF bError THEN
	// A failed Reset is terminal for this Abort sequence; do not remain in Aborting.
	Axis_BaseUnit.M_Reset(
		OwnerId := ServiceId,
		Execute := FALSE);
	M_AddError(
		MainErrorId := E_Chamber1ErrorCode.Error_While_Reset_Axis,
		SourceErrorId := nErrorId,
		Message := 'Axis reset failed while aborting.');
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ServiceId);
	H_OnAborting := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnClearing" Id="{a1cc0005-6b2c-4d3e-8f90-a1cc00000005}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnClearing : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bServoOn : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[M_ClearAllError();
H_OnClearing := E_PackMLHookResult.Done;

]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnComplete" Id="{a1cc0006-6b2c-4d3e-8f90-a1cc00000006}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnComplete
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reaching Complete means target velocity was reached; the Axis is still moving,
// so this Service must retain ownership until Stop or Abort cleanup finishes.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnCompleting" Id="{a1cc0007-6b2c-4d3e-8f90-a1cc00000007}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnCompleting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[Axis_BaseUnit.M_MoveVel(
	OwnerId := ServiceId,
	Execute := FALSE,
	Direction := MC_Direction.MC_Negative_Direction,
	Velocity := _LatchedParam.Velocity,
	Acceleration := _LatchedParam.Acceleration,
	Deceleration := _LatchedParam.Deceleration);

// Lowering Execute only withdraws the FB request; it does not stop the Axis.
// Keep ownership so a later Stop from Complete or Idle can control the motion.
H_OnCompleting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnExecute" Id="{a1cc0008-6b2c-4d3e-8f90-a1cc00000008}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnExecute : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bInVelocity : BOOL;
	bError : BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnExecute := E_PackMLHookResult.Busy;

// The Start-time snapshot remains fixed for the entire Execute phase.
Axis_BaseUnit.M_MoveVel(
	OwnerId := ServiceId,
	Execute := TRUE,
	Direction := MC_Direction.MC_Negative_Direction,
	Velocity := _LatchedParam.Velocity,
	Acceleration := _LatchedParam.Acceleration,
	Deceleration := _LatchedParam.Deceleration,
	InVelocity => bInVelocity,
	Error => bError);

IF bError THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Axis_Command_Error_During_Execute, SourceErrorId := 0, Message := 'MoveVelocity failed during Execute.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF bInVelocity THEN
	H_OnExecute := E_PackMLHookResult.Done;
END_IF
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnIdle" Id="{a1cc000b-6b2c-4d3e-8f90-a1cc0000000b}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnIdle
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Reset changes only the PackML state. A MoveVel that completed naturally may
// still be moving, so Idle intentionally retains any existing Axis ownership.]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnResetting" Id="{a1cc000c-6b2c-4d3e-8f90-a1cc0000000c}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnResetting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnResetting := E_PackMLHookResult.Done;]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStarting" Id="{a1cc000d-6b2c-4d3e-8f90-a1cc0000000d}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStarting : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStarting := E_PackMLHookResult.Busy;

// Validate Service-owned data before reserving the shared BaseUnit.
IF Param.Velocity <= 0 THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Invalid_Param, SourceErrorId := 0, Message := 'Velocity must be greater than zero.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Param.Acceleration < 0 THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Invalid_Param, SourceErrorId := 0, Message := 'Acceleration must not be negative.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Param.Deceleration < 0 THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Invalid_Param, SourceErrorId := 0, Message := 'Deceleration must not be negative.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

// Keep one fixed command snapshot until the Service leaves this run.
_LatchedParam := Param;

// Resource contention is a failed Start, not a wait condition.
IF NOT Axis_BaseUnit.M_AcquireResource(OwnerId := ServiceId) THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Resource_Acquire_Failed_During_Starting, SourceErrorId := 0, Message := 'Axis resource acquisition failed during Starting.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

// Physical checks occur only after this Service owns the BaseUnit.
IF Axis_BaseUnit.AxisIsDisabled THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Axis_Not_Servo_On_During_Starting, SourceErrorId := 0, Message := 'Axis is not servo on during Starting.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

IF Axis_BaseUnit.AxisHasJob THEN
	M_AddError(MainErrorId := E_Chamber1ErrorCode.Axis_Is_Busy_During_Starting, SourceErrorId := 0, Message := 'Axis is busy during Starting.');
	RequestCommand(E_PackMLCommand.Abort);
	RETURN;
END_IF

H_OnStarting := E_PackMLHookResult.Done;
]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopped" Id="{a1cc000e-6b2c-4d3e-8f90-a1cc0000000e}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopped
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Release defensively after every Stop path.
Axis_BaseUnit.M_ReleaseResource(OwnerId := ServiceId);]]></ST>
      </Implementation>
    </Method>
    <Method Name="H_OnStopping" Id="{a1cc000f-6b2c-4d3e-8f90-a1cc0000000f}" FolderPath="StateAction\">
      <Declaration><![CDATA[METHOD PROTECTED H_OnStopping : E_PackMLHookResult
VAR_INPUT
	bFirstScan	: BOOL;
END_VAR

VAR
	bDone : BOOL;
	bError : BOOL;
	nErrorId : UDINT;
END_VAR
]]></Declaration>
      <Implementation>
        <ST><![CDATA[H_OnStopping := E_PackMLHookResult.Busy;

// Resource acquisition failures enter Stopping without owning the Axis.
IF NOT Axis_BaseUnit.M_IsResourceOwner(OwnerId := ServiceId) THEN
	H_OnStopping := E_PackMLHookResult.Done;
	RETURN;
END_IF

// Withdraw MoveVelocity before issuing the physical Stop.
Axis_BaseUnit.M_MoveVel(
	OwnerId := ServiceId,
	Execute := FALSE,
	Direction := MC_Direction.MC_Negative_Direction,
	Velocity := _LatchedParam.Velocity,
	Acceleration := _LatchedParam.Acceleration,
	Deceleration := _LatchedParam.Deceleration);

Axis_BaseUnit.M_Stop(
	OwnerId := ServiceId,
	Execute := TRUE,
	Deceleration:= _LatchedParam.Deceleration,
	Done=> bDone, Error=> bError, ErrorId=> nErrorId);

IF bDone THEN
	Axis_BaseUnit.M_Stop(
		OwnerId := ServiceId,
		Execute := FALSE,
		Deceleration:= _LatchedParam.Deceleration);
	// Ownership is released only after the asynchronous Stop has completed.
	Axis_BaseUnit.M_ReleaseResource(OwnerId := ServiceId);
	H_OnStopping := E_PackMLHookResult.Done;

ELSIF bError THEN
	// Throw up error
	M_AddError(
		MainErrorId := E_Chamber1ErrorCode.Error_While_Stop_Axis,
		SourceErrorId := nErrorId,
		Message := 'Axis stop failed while stopping.');

	Axis_BaseUnit.M_Stop(
		OwnerId := ServiceId,
		Execute := FALSE,
		Deceleration:= _LatchedParam.Deceleration);

	RequestCommand(E_PackMLCommand.Abort);
END_IF

]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>