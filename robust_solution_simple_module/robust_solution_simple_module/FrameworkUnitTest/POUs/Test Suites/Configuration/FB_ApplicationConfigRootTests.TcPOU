<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FB_ApplicationConfigRootTests" Id="{939c8839-6b26-4777-95b0-59a092b43ca0}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION_BLOCK FB_ApplicationConfigRootTests EXTENDS TcUnit.FB_TestSuite
VAR
	_ConfigRoot : FB_TestApplicationConfigRoot;
END_VAR
]]></Declaration>
    <Implementation>
      <ST><![CDATA[RegistrationHooksRunOnceInOrderAndLatchFailure();
ReadyCycleCopiesInputRunsModuleAndCopiesOutput();]]></ST>
    </Implementation>
    <Method Name="RegistrationHooksRunOnceInOrderAndLatchFailure" Id="{a8d9f959-15b2-4f7e-9de7-06bf40a17bdc}">
      <Declaration><![CDATA[METHOD RegistrationHooksRunOnceInOrderAndLatchFailure
]]></Declaration>
      <Implementation>
        <ST><![CDATA[TEST('RegistrationHooksRunOnceInOrderAndLatchFailure');

_ConfigRoot.Run();

AssertTrue(
	Condition := (_ConfigRoot.IoRegistrationCalls = 1)
		AND (_ConfigRoot.BaseUnitRegistrationCalls = 1)
		AND (_ConfigRoot.ModuleTypeRegistrationCalls = 1),
	Message := 'The three application registration hooks must each run once.');
AssertTrue(
	Condition := _ConfigRoot.RegistrationOrderValid,
	Message := 'Registration hooks must run in IO, BaseUnit, Module Type order.');
AssertTrue(
	Condition := _ConfigRoot.Error
		AND NOT _ConfigRoot.Ready
		AND (_ConfigRoot.ErrorCode = 0)
		AND (_ConfigRoot.ErrorMessage = 'A Module Type name and adapter are required.'),
	Message := 'The first registration failure must be exposed by the ConfigRoot properties.');

// A second cycle must neither retry registration nor enter configuration loading.
_ConfigRoot.Run();
AssertTrue(
	Condition := (_ConfigRoot.IoRegistrationCalls = 1)
		AND (_ConfigRoot.BaseUnitRegistrationCalls = 1)
		AND (_ConfigRoot.ModuleTypeRegistrationCalls = 1),
	Message := 'A latched startup failure must not retry application registration.');

// The public Run seam is gated by Ready.
AssertTrue(
	Condition := _ConfigRoot.ModuleCycleCalls = 0,
	Message := 'Module polling must remain disabled after configuration initialization fails.');

TEST_FINISHED();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReadyCycleCopiesInputRunsModuleAndCopiesOutput" Id="{876c1e34-8237-4ea1-ba02-187f03b73399}">
      <Declaration><![CDATA[METHOD ReadyCycleCopiesInputRunsModuleAndCopiesOutput
VAR_INST Root : FB_TestApplicationConfigRoot; nCycles : UINT; END_VAR
]]></Declaration>
      <Implementation><ST><![CDATA[// RuntimeDependent：需將 library parameter 的 ModuleConfigFilePath 指向 application-root.json。
IF NOT GVL_TestConfig.RunConfigurationFileRuntimeTests THEN RETURN; END_IF
TEST('ReadyCycleCopiesInputRunsModuleAndCopiesOutput');

// Arrange：使用有效 adapter，並準備可辨識的 input/output 初值。
Root.UseValidModuleTypeRegistration := TRUE;
GVL_TestSymbols.InfrastructureBool := TRUE;
GVL_TestSymbols.InfrastructureOutputBool := FALSE;

// Act：Config loader 可能跨多個 scan；Ready 後同一個 Run 會依 input、Module、output 的順序執行。
Root.Run();
nCycles := nCycles + 1;
IF Root.Ready THEN
	// Assert：hook 看到 input-copy 結果，外部節點看到 hook 產生的 output-copy 結果。
	AssertTrue(Condition := Root.ModuleObservedInput, Message := 'Input mapping must complete before the Module hook runs.');
	AssertTrue(Condition := GVL_TestSymbols.InfrastructureOutputBool, Message := 'Output mapping must run after the Module hook.');
	AssertTrue(Condition := (Root.ModuleCycleCalls > 0) AND (LEN(Root.LastSystemUtcDateTime) = 17), Message := 'Ready cycle must run Modules with an updated UTC context.');
	AssertTrue(Condition := Root.LastHeartbeatTimeout = Param_Config.ModuleHeartbeat_Timeout, Message := 'SystemContext must carry the configured heartbeat timeout.');
	nCycles := 0; TEST_FINISHED();
ELSIF Root.Error OR (nCycles > 1000) THEN
	AssertTrue(Condition := FALSE, Message := 'Application root fixture failed or timed out; verify library parameter and fixture deployment.');
	nCycles := 0; TEST_FINISHED();
END_IF]]></ST></Implementation>
    </Method>
  </POU>
</TcPlcObject>
